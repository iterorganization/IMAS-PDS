# PDS build of NICE, rebuilt against MUSCLE3 0.10.0.
#
# Why this exists at all: SDCC's own NICE/3.0.0-intel-2025b-DD-4.1.1 binaries
# have MUSCLE3/0.9.1 baked into their RPATH (verified with `readelf -d`), and
# RPATH beats any environment variable, so a NICE actor from that module cannot
# talk to the 0.10.0 manager the rest of the PDS stack runs. The only fix is to
# rebuild -- no modulefile trick reaches it.
#
# Sources: the v3.0.0 release tag, which is genuinely 3.0.0 and carries all four
# MUSCLE3 targets this needs. The build_nice.sh script this replaces tracked
# `master` (~5 months ahead of the tag) purely because it predated the tag.
#
# NICE vendors Eigen, SuiteSparse and MUSCLE3 as git submodules, which the
# release tarball does not contain. That is a feature here: all three are proper
# EasyBuild dependencies below, so the build uses the same MUSCLE3 as every
# other actor instead of a second, separately-compiled copy -- which is the
# whole point of the rebuild.
#
# The RPATH problem that motivated this easyconfig applies to our own build too:
# NICE's Makefile emits explicit -rpath only for IMAS-Cpp/IMAS-Core and expects
# LD_LIBRARY_PATH to cover the rest, which a `base_env: clean` actor subprocess
# does not have. build_nice.sh papered over that with a post-hoc
# `patchelf --add-rpath "$LD_LIBRARY_PATH"`; here, build the whole module with
# EasyBuild's own RPATH linking instead:
#
#   eb NICE-3.0.0-intel-2025b-pds.eb --rpath
#
# See setup_files/easyconfigs/README.md -- --rpath is required, not optional.

easyblock = 'MakeCp'

name = 'NICE'
version = '3.0.0'
versionsuffix = '-pds'

homepage = 'https://gitlab.inria.fr/blfauger/nice'
description = """NICE (Newton direct and Inverse Computation for Equilibrium)
solves the free-boundary equilibrium problem for tokamak plasmas, in direct,
inverse and resistive-diffusion modes. This build exposes the MUSCLE3 actor
variants."""

toolchain = {'name': 'intel', 'version': '2025b'}
toolchainopts = {'openmp': True, 'pic': True}

source_urls = ['https://gitlab.inria.fr/blfauger/%(namelower)s/-/archive/v%(version)s/']
sources = ['%(namelower)s-v%(version)s.tar.gz']
checksums = ['a4a2faa0318a726d4dd1ba72c56461b498022c068b657142dd240cad6a5e8fc6']

builddependencies = [
    ('pkgconf', '2.4.3'),
]

dependencies = [
    ('MUSCLE3', '0.10.0'),
    ('IMAS-Cpp', '5.6.0', '-DD-4.1.1'),
    ('Eigen', '3.4.0'),
    ('SuiteSparse', '7.10.1'),
    ('libxml2', '2.14.5'),
    ('Boost', '1.88.0'),
]

# NICE ships src/Makefile.TEMPLATE and expects you to copy it to src/Makefile
# and hand-edit the CHOOSE_* switches. Its defaults already match a cluster
# install (system SuiteSparse and libxml2 via pkg-config, IMAS and MUSCLE3 on,
# MPI off, OpenMP on), so copy it unedited and override the toolchain-specific
# variables on the make command line instead of patching the file.
# The actors read their parameter and schema files from run/input at startup;
# NICE's own tree keeps the masters under run/iwrap/param and expects the build
# to stage them. build_nice.sh did this with two `cp` calls.
prebuildopts = 'cp run/iwrap/param/inv/iter/param.x* run/input/ && ' \
               'cp run/iwrap/param/xsd/param.x* run/input/ && ' \
               'cd src && cp -f Makefile.TEMPLATE Makefile && '

# CPP/FORT/LINK: the template hardcodes g++/gfortran. Use the toolchain
# compilers so this really is an intel-2025b build and matches IMAS-Cpp's ABI.
# OPTL: the template's -lgfortran is the GCC Fortran runtime; with ifx the
# equivalent is -lifcore.
# INCEIGEN: sources say `#include <Sparse>` (headers reached directly) as well
# as `#include <Eigen/Dense>`, so both levels have to be on the include path.
_make_vars = ' '.join([
    'CPP="$CXX"',
    'FORT="$F90"',
    'LINK="$CXX"',
    'OPTL="-lifcore -qopenmp"',
    'INCEIGEN="-I$EBROOTEIGEN/include/Eigen -I$EBROOTEIGEN/include"',
])

_targets = [
    'nice_imas_inv_muscle3',
    'nice_imas_dir_muscle3',
    'nice_imas_evo_muscle3',
    'nice_imas_evo_rd_muscle3',
]

# One make invocation per target, matching build_nice.sh -- the Makefile has no
# aggregate target covering just these four.
buildopts = ' && make '.join('%s %s' % (t, _make_vars) for t in _targets)

# Parallel builds are capped: a bare `make -j` here spawns one job per source
# file and gets the compiler OOM-killed on a login node.
maxparallel = 8

files_to_copy = [
    (['run/nice_imas_inv_muscle3', 'run/nice_imas_dir_muscle3',
      'run/nice_imas_evo_muscle3', 'run/nice_imas_evo_rd_muscle3'], 'run'),
    (['run/input'], 'run'),
    (['data'], '.'),
]

sanity_check_paths = {
    'files': ['run/%s' % t for t in _targets],
    'dirs': ['run/input', 'data'],
}

# workflows/lib/local_programs.ymmsl runs these under `base_env: clean`, so the
# binaries must resolve every library with no modules loaded beyond this one --
# which is exactly what --rpath buys and what the old patchelf hack faked. A
# plain --help would not catch a missing RPATH entry, hence ldd.
sanity_check_commands = [
    "! ldd %(installdir)s/run/nice_imas_inv_muscle3 | grep 'not found'",
    "! ldd %(installdir)s/run/nice_imas_dir_muscle3 | grep 'not found'",
    "ldd %(installdir)s/run/nice_imas_inv_muscle3 | grep -q libmuscle",
]

# local_programs.ymmsl refers to the actors as $EBROOTNICE/run/<target>, so no
# PATH entry is needed -- and deliberately none is added, to keep these four
# binaries out of the way of anything else named nice*.

moduleclass = 'phys'
