# Drop-in replacement for the upstream IMAS-Validator easyconfig
# (easybuilders/easybuild-easyconfigs PR #26550), identical to it apart from one
# patch and the two sanity checks that prove the patch took.
#
# It deliberately keeps the UNSUFFIXED upstream name. That is what lets
# everything else here stay upstream: IMAS-MUSCLE3 is installed straight from
# PR #26551 with no local copy, and because this file sits earlier on the robot
# path than the PR's own copy, that unmodified easyconfig resolves its
# IMAS-Validator dependency to the fixed build. A -pds suffix here would mean
# forking IMAS-MUSCLE3 as well, just to repoint one dependency.
#
# Why the patch: the released imas_validator 1.0.0 calls
# imas.backends.imas_core.imas_interface.has_imas (validate.py:65), which
# IMAS-Python removed for good in 2.3.0 -- the very version this easyconfig
# depends on. Every validate() call therefore raises AttributeError, which
# crashes the OLC/validator actor at run time, and MUSCLE3 SIGKILLs every other
# actor when one crashes, so it presents as a mass failure rather than as one
# bad actor. Upstream fixed this on develop (commits 04050dc, 0adacdf) by
# dropping the version check entirely; the patch backports exactly that.
#
# Drop this file once an imas-validator release containing the fix is on PyPI
# and the upstream easyconfig is bumped to it -- at which point PR #26550's own
# copy is picked up again with no further change here.

easyblock = 'PythonBundle'

name = 'IMAS-Validator'
version = '1.0.0'

description = """A pure-python library to handle IDSs"""
homepage = "https://github.com/iterorganization/IMAS-Validator"

toolchain = {'name': 'intel', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('netcdf4-python', '1.7.2'),
    ('h5py', '3.14.0'),
    ('IMAS-Python', '2.3.0'),
]

exts_list = [
    ('junit2html', '31.1.4', {
        'modulename': False,
        'sources': ['%(name)s-%(version)s-py3-none-any.whl'],
        'checksums': ['dfd100dfdc0ee91e1ffbd1774669b209dec115b285e06af9e31d8743db8931e6'],
    }),
    ('imas_validator', version, {
        'modulename': False,
        'sources': ['%(name)s-%(version)s.tar.gz'],
        'patches': ['imas_validator-1.0.0_remove-has_imas-check.patch'],
        'checksums': [
            '132d73b7b7f24628e8e12a60381fc8c65bf1ed996f817c442a0a4d1124e8c63b',
            {'imas_validator-1.0.0_remove-has_imas-check.patch':
             '7eac78850b84b62e36979d0123567460808b48ec24fe4e7bf296ac6ce32f3d01'},
        ],
    }),
]

# The regression this easyconfig exists to fix is an import-time-clean,
# call-time AttributeError, so an import check alone would not catch it.
sanity_check_commands = [
    "python -c 'from imas_validator.validate.validate import validate'",
    "python -c 'import imas_validator.validate.validate as v; assert not hasattr(v, \"_check_imas_version\")'",
]

moduleclass = 'tools'
