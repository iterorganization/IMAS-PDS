easyblock = 'PythonPackage'

name = 'TORAX-MUSCLE3'
version = '0.1.3'
versionsuffix = '-pds'

local_commit = 'fcbb89bf165a394d4a063148e2ba6baceba2fecc'

homepage = 'https://github.com/iterorganization/TORAX-MUSCLE3'
description = """MUSCLE3 actor wrapper around TORAX, a differentiable tokamak
core transport simulator, for use in IMAS coupled workflows."""

toolchain = {'name': 'intel', 'version': '2025b'}

sources = [{
    'git_config': {
        'url': 'https://github.com/iterorganization',
        'repo_name': 'TORAX-MUSCLE3',
        'commit': local_commit,
    },
    'filename': 'torax_muscle3-%(version)s.tar.gz',
}]
checksums = [None]

preinstallopts = 'SETUPTOOLS_SCM_PRETEND_VERSION=%(version)s '

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
]

use_pip = True
use_pip_for_deps = True
download_dep_fail = False

postinstallcmds = [
    'PYTHONPATH=%(installdir)s/lib/python%(pyshortver)s/site-packages:$PYTHONPATH '
    'python -m pip install --prefix=%(installdir)s --no-warn-script-location "muscle3==0.10.0"',
]

sanity_pip_check = False

options = {'modulename': 'torax_muscle3'}

sanity_check_paths = {
    'files': [],
    'dirs': ['lib/python%(pyshortver)s/site-packages/torax_muscle3'],
}

sanity_check_commands = [
    "python -c 'import jax, torax, libmuscle'",
    "python -c 'import libmuscle; assert libmuscle.__version__ == \"0.10.0\", libmuscle.__version__'",
    "python -c 'import torax_muscle3.torax_actor'",
]

moduleclass = 'phys'
