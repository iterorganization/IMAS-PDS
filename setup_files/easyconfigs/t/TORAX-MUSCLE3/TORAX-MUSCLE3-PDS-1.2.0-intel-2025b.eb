    'sphinxcontrib_serializinghtml==2.0.0', 'sphinx_copybutton==0.5.2',
    'sphinx_design==0.8.0', 'sphinx_remove_toctrees==1.0.0.post1', 'tensorstore==0.1.86',
    'tglfnn_ukaea==0.3.0', 'tomlkit==0.15.2', 'toolz==1.2.0', 'tqdm==4.70.1',
    'treelib==1.8.0', 'treescope==0.1.11', 'typeguard==2.13.3',
    'typing_extensions==4.16.0', 'typing_inspection==0.4.5', 'tzdata==2026.6',
