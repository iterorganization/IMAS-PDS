# PDS build of METIS (the CEA/IRFM fast tokamak integrated simulator).
#
# NAME: deliberately METIS-IRFM, not METIS. EasyBuild already has METIS, the
# Karypis graph-partitioning library, at m/METIS -- an unrelated package that
# several of this stack's own dependencies pull in transitively. Two different
# codes cannot share one easyconfig name, so the plasma METIS takes the -IRFM
# qualifier its authors use.
#
# TOOLCHAIN: system. METIS is MATLAB source with no compile step, so there is no
# compiler to pin. What the module has to do is place a shared checkout
# somewhere readable and export the two variables the actor's wrapper reads.
#
# VERSION: the repository publishes no release tags, so this pins an explicit
# commit on muscle3_develop and date-stamps the version. Bump both together.
#
# Requires an SSH key registered with git.iter.org at build time -- the source
# repository is not public.

easyblock = 'Tarball'

name = 'METIS-IRFM'
version = '2026.08'
versionsuffix = '-pds'

homepage = 'https://git.iter.org/projects/SCEN/repos/metis'
description = """METIS is a fast integrated tokamak simulator from CEA/IRFM,
written in MATLAB. This module provides a shared checkout plus the dedicated
Python environment its MUSCLE3 wrapper drives the manager through."""

toolchain = SYSTEM

# MATLAB's py.* bridge runs the interpreter in-process and supports only
# Python 3.9-3.12, while the manager it has to speak to is libmuscle 0.10.0.
# No Python in the intel-2025b stack (3.13) satisfies both, so this module
# carries its own 3.11 -- which is also the Python that IMAS-AL-Matlab, loaded
# alongside this module by the actor, is built against.
dependencies = [
    ('Python', '3.11.5', '', ('GCCcore', '13.2.0')),
    ('MATLAB', '2023b-r5'),
]

sources = [{
    'git_config': {
        'url': 'ssh://git@git.iter.org/scen',
        'repo_name': 'metis',
        'commit': 'muscle3_develop',
    },
    'filename': 'metis-%(version)s.tar.gz',
}]
checksums = [None]

# zineb_path is METIS's own initialisation step: it walks the checkout and
# writes the MATLAB path//cache files the rest of the code expects to find.
# It has to run once, in place, after the tree is staged.
postinstallcmds = [
    'cd %(installdir)s && matlab -nodisplay -batch zineb_path',
    # The muscle3 venv metis4muscle3.m points MATLAB's pyenv() at. Kept separate
    # from IMAS-MUSCLE3's environment on purpose: that one is Python 3.13, which
    # no installed MATLAB can host in-process.
    'python -m venv %(installdir)s/muscle3_venv',
    '%(installdir)s/muscle3_venv/bin/pip install --quiet "muscle3==0.10.0"',
]

sanity_check_paths = {
    'files': ['muscle3_venv/bin/python', 'workflow/muscle3/mfile/metis4muscle3.m'],
    'dirs': ['workflow/muscle3/mfile'],
}

sanity_check_commands = [
    '%(installdir)s/muscle3_venv/bin/python -c '
    '\'import libmuscle; assert libmuscle.__version__ == "0.10.0", libmuscle.__version__\'',
]

# EBROOTMETISMINIRFM is what EasyBuild derives from the module name, but
# workflows/lib/local_programs.ymmsl and the .m files under workflows/*_utils/
# read EBROOTMETIS, so set that explicitly rather than churn the MATLAB sources.
modextravars = {
    'EBROOTMETIS': '%(installdir)s',
    'DIR_METIS4MUSCLE3': '%(installdir)s/workflow/muscle3/mfile',
}

# No PATH entry on purpose: METIS is invoked as MATLAB source through
# addpath(), never as an executable.

moduleclass = 'phys'
