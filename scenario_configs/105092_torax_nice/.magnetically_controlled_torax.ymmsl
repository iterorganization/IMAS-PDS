ymmsl_version: v0.1
model:
  name: magnetically_controlled_105092
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out, pf_active_out]
    accumulator:
      implementation: accumulator
      ports:
        s: [equilibrium_in, pf_active_in]
        o_f: [equilibrium_out, pf_active_out]
    torax:
      implementation: torax
      ports:
        f_init: [equilibrium_f_init]
        s: [equilibrium_s]
        o_i: [equilibrium_o_i]
        o_f: [equilibrium_o_f]
    sink_source:
      implementation: sink_source
      ports:
        f_init: [equilibrium_in]
        o_f: [wall_out, pf_active_out, pf_passive_out, iron_core_out]
    magnetic_controller:
      implementation: magnetic_controller
      ports:
        f_init: [equilibrium_f_init, pf_active_f_init]
        s: [equilibrium_s, pf_active_s]
        o_i: [pf_active_o_i]
    nice_evo:
      implementation: nice_evo
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
        o_f: [equilibrium_out, pf_active_out]
    sink_nice:
      implementation: sink
      ports:
        f_init: [equilibrium_in, pf_active_in]
    sink_torax:
      implementation: sink
      ports:
        f_init: [equilibrium_in]
    sink_controller:
      implementation: sink
      ports:
        f_init: [equilibrium_in, pf_active_in]
    visualization_nice:
      implementation: visualization
      ports:
        s: [equilibrium_in]
    visualization_torax:
      implementation: visualization
      ports:
        s: [equilibrium_in]
  conduits:
    source.equilibrium_out: accumulator.equilibrium_in
    source.pf_active_out: accumulator.pf_active_in
    accumulator.equilibrium_out: torax.equilibrium_f_init
    accumulator.equilibrium_out: magnetic_controller.equilibrium_f_init
    accumulator.pf_active_out: magnetic_controller.pf_active_f_init

    accumulator.pf_active_out: sink_controller.pf_active_in

    torax.equilibrium_o_i: magnetic_controller.equilibrium_s
    torax.equilibrium_o_i: nice_evo.equilibrium_in
    torax.equilibrium_o_i: sink_source.equilibrium_in
    torax.equilibrium_o_i: visualization_torax.equilibrium_in
    torax.equilibrium_o_f: sink_torax.equilibrium_in
    sink_source.pf_active_out: magnetic_controller.pf_active_s
    sink_source.pf_passive_out: nice_evo.pf_passive_in
    sink_source.iron_core_out: nice_evo.iron_core_in
    sink_source.wall_out: nice_evo.wall_in
    magnetic_controller.pf_active_o_i: nice_evo.pf_active_in
    # magnetic_controller.pf_active_o_i: sink_controller.pf_active_in
    nice_evo.equilibrium_out: torax.equilibrium_s
    nice_evo.equilibrium_out: sink_nice.equilibrium_in
    nice_evo.equilibrium_out: visualization_nice.equilibrium_in
    nice_evo.pf_active_out: sink_nice.pf_active_in

settings:
  source.source_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105092/tmp/data/105092_out_nice/"
  sink_source.source_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105092/tmp/data/105092_out_nice/"
  sink_nice.sink_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105092/tmp/data/105092_out_nice_evo"
  sink_controller.sink_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105092/tmp/data/105092_out_controller"
  sink_torax.sink_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105092/tmp/data/105092_out_torax"
  torax.output_all_timeslices: True
  xml_path: [BASEDIR_PLACEHOLDER]/scenario_configs/105092/config_nice.xml
  python_config_module: [BASEDIR_PLACEHOLDER]/scenario_configs/105092/config_torax.py
  visualization_nice.plot_file_path: [BASEDIR_PLACEHOLDER]/run/IMAS-muscle3/imas_muscle3/visualization/examples/simple_1d_plot/simple_1d_plot.py
  visualization_nice.port: 5007
  visualization_nice.throttle_interval: 0.4
  visualization_nice.keep_alive: false
  visualization_torax.plot_file_path: [BASEDIR_PLACEHOLDER]/run/IMAS-muscle3/imas_muscle3/visualization/examples/simple_1d_plot/simple_1d_plot.py
  visualization_torax.port: 5008
  visualization_torax.throttle_interval: 0.4
  visualization_torax.keep_alive: false
  muscle_remote_log_level: 'DEBUG'
implementations:
  source:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  sink:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  sink_source:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_source_component"
  accumulator:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.accumulator_component"
  nice_evo:
    modules: SuiteSparse/7.7.0-intel-2023b libxml2
    executable: [BASEDIR_PLACEHOLDER]/run/nice/run/nice_imas_evo_muscle3
  torax:
    base_env: CLEAN
    modules: Python Boost HDF5 libiconv OpenBLAS
    virtual_env: [BASEDIR_PLACEHOLDER]/run/torax/venv
    executable: python
    args: "-u -m torax._src.orchestration.run_muscle3"
  magnetic_controller: 
    env:
      PCS_PATH: [BASEDIR_PLACEHOLDER]/run/pcs
      CONTROLLER_PATH: [BASEDIR_PLACEHOLDER]/controllers
      SCDDS_COREPATH: [BASEDIR_PLACEHOLDER]/run/pcs/pcssp/scdds
    modules: MATLAB/2024a-r6-GCCcore-13.2.0
    executable: matlab
    args: -batch "[s,t] = unix('which python');
                  pyenv('Version',strtrim(t),'ExecutionMode','InProcess');
                  addpath(getenv('PCS_PATH'));
                  addpath(getenv('CONTROLLER_PATH'));
                  pcssp_pcs_add_paths;
                  comparisons.ExternalSCMLink.setupGitConfig();
                  run('[BASEDIR_PLACEHOLDER]/run/nice/runmatlab/initNice4matlab.m');
                  muscle_controller_NICE_IMAS_iter_init;"
  visualization:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.visualization_component"
resources:
  source:
    threads: 1
  sink_source:
    threads: 1
  sink_nice:
    threads: 1
  sink_controller:
    threads: 1
  sink_torax:
    threads: 1
  accumulator:
    threads: 1
  torax:
    threads: 1
  nice_evo:
    threads: 1
  magnetic_controller:
    threads: 1
  visualization_nice:
    threads: 1
  visualization_torax:
    threads: 1
