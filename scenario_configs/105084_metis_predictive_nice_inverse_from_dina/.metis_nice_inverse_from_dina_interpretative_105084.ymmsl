ymmsl_version: v0.1
model:
  name: metis_nice_inv_from_dina_105084
  components:
    source_nice:
      implementation: source_nice
      ports:
        f_init: [equilibrium_in]
        o_f: [pf_active_out, pf_passive_out, wall_out,  iron_core_out]
    source_metis:
      implementation: source_metis
      ports:
        o_f: [pulse_schedule_out]
    nice_inv:
      implementation: nice_inv
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
        o_f: [equilibrium_out, pf_active_out]
    sink_metis:
      implementation: sink_metis
      ports:
        f_init: [equilibrium_in,pulse_schedule_in,plasma_profiles_in,plasma_sources_in]         
    sink_nice:
      implementation: sink_metis
      ports:
        f_init: [equilibrium_in,pf_active_in]
    metis:
      implementation: metis
      ports:
        f_init: [pulse_schedule_f_init,pulse_schedule_in_f]
        o_f: [equilibrium_out_f,pulse_schedule_out_f,plasma_profiles_out_f,plasma_sources_out_f]
    olc:
      implementation: olc
      ports:
        f_init: [pf_active_in]
  conduits:
    metis.equilibrium_out_f: nice_inv.equilibrium_in
    metis.equilibrium_out_f: source_nice.equilibrium_in
    metis.equilibrium_out_f: sink_metis.equilibrium_in
    source_metis.pulse_schedule_out: metis.pulse_schedule_f_init
    source_metis.pulse_schedule_out: metis.pulse_schedule_in_f
    source_nice.pf_active_out: nice_inv.pf_active_in
    source_nice.pf_passive_out: nice_inv.pf_passive_in
    source_nice.iron_core_out: nice_inv.iron_core_in
    source_nice.wall_out: nice_inv.wall_in
    nice_inv.equilibrium_out: sink_nice.equilibrium_in
    nice_inv.pf_active_out: sink_nice.pf_active_in
    nice_inv.pf_active_out: olc.pf_active_in
    metis.pulse_schedule_out_f: sink_metis.pulse_schedule_in
    metis.plasma_profiles_out_f: sink_metis.plasma_profiles_in
    metis.plasma_sources_out_f: sink_metis.plasma_sources_in 
settings:
  source_nice.source_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105084_metis_nice_inverse_from_dina_predictive/tmp/data/105084_nice_in/" 
  source_metis.source_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105084_metis_nice_inverse_from_dina_predictive/tmp/data/105084_metis_in/"
  sink_metis.sink_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105084_metis_nice_inverse_from_dina_predictive/tmp/data/105084_metis_out/"
  sink_nice.sink_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105084_metis_nice_inverse_from_dina_predictive/tmp/data/105084_nice_out/"
  olc.extra_rule_dirs: "/home/ITER/artaudj1/PDS/pds/pds_validation_tests"
  olc.rulesets: "iter-olc"
  olc.apply_generic: False
  metis.metis_computation: 1
  # this value sould be tune if psi_LCFS is a constrainte in NICE inverse
  metis.metis_psioffset: 17.0
  metis.metis_external_data_equilibrium: 0
  # param.xml should maybe also be optimized to get the correct evolution of the coil currents
  xml_path: "/home/ITER/artaudj1/PDS/pds/run/nice/run/input/param.xml"
  muscle_remote_log_level: 'DEBUG'
  python_config_module: 'examples/basic_config.py'
implementations:
  sink_metis:
    virtual_env: /home/ITER/artaudj1/PDS/pds/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  sink_nice:
    virtual_env: /home/ITER/artaudj1/PDS/pds/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  source_nice:
    virtual_env: /home/ITER/artaudj1/PDS/pds/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_source_component"
  source_metis:
    virtual_env: /home/ITER/artaudj1/PDS/pds/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  olc:
    modules: IDS-Validator
    virtual_env: /home/ITER/artaudj1/PDS/pds/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.olc_component"
  metis: 
    env: 
      DIR_METIS4MUSCLE3: /home/ITER/artaudj1/PDS/pds/run/metis/workflow/muscle3/mfile
    executable: matlab
    args: -batch "[s,t] = unix('which python');pyenv('Version',strtrim(t),'ExecutionMode','InProcess');addpath(getenv('DIR_METIS4MUSCLE3'));metis4muscle3(2);"
#    args: -r "[s,t] = unix('which python');pyenv('Version',strtrim(t),'ExecutionMode','InProcess');addpath(getenv('DIR_METIS4MUSCLE3'));metis4muscle3(3);"
  nice_inv:
    modules: SuiteSparse/7.7.0-intel-2023b libxml2
    executable: /home/ITER/artaudj1/PDS/pds/run/nice/run/nice_imas_inv_muscle3
resources:
  source_nice:
    threads: 1
  source_metis:
    threads: 1
  sink_metis:
    threads: 1
  sink_nice:
    threads: 1
  nice_inv:
    threads: 4
  metis:
    threads: 10
  olc:
    threads: 1

