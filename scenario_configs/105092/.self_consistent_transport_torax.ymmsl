ymmsl_version: v0.1
model:
  name: prescribed_transport_105092_torax_acc
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out, wall_out, pf_active_out, pf_passive_out, iron_core_out]
    nice_inv:
      implementation: nice_inv
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
        o_f: [equilibrium_out, pf_active_out]
    nice_dir:
      implementation: nice_dir
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
        o_f: [equilibrium_out]
    accumulator:
      implementation: accumulator
      ports:
        s: [equilibrium_in]
        o_f: [equilibrium_out]
    torax:
      implementation: torax
      ports:
        f_init: [equilibrium_f_init]
        o_f: [equilibrium_o_f]
    sink_nice:
      implementation: sink
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
    sink_dir:
      implementation: sink
      ports:
        f_init: [equilibrium_in]
    sink_torax:
      implementation: sink
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
    visualization:
      implementation: visualization
      ports:
        s: [equilibrium_in]
  conduits:
    source.equilibrium_out: nice_inv.equilibrium_in
    source.pf_active_out: nice_inv.pf_active_in
    source.wall_out: nice_inv.wall_in
    source.pf_passive_out: nice_inv.pf_passive_in
    source.iron_core_out: nice_inv.iron_core_in
    source.wall_out: nice_dir.wall_in
    source.pf_passive_out: nice_dir.pf_passive_in
    source.iron_core_out: nice_dir.iron_core_in
    source.wall_out: sink_nice.wall_in
    source.pf_passive_out: sink_nice.pf_passive_in
    source.iron_core_out: sink_nice.iron_core_in
    source.wall_out: sink_torax.wall_in
    source.pf_passive_out: sink_torax.pf_passive_in
    source.iron_core_out: sink_torax.iron_core_in
    nice_inv.equilibrium_out: sink_nice.equilibrium_in
    nice_inv.equilibrium_out: nice_dir.equilibrium_in
    nice_inv.equilibrium_out: accumulator.equilibrium_in
    nice_inv.equilibrium_out: visualization.equilibrium_in
    nice_inv.pf_active_out: sink_nice.pf_active_in
    nice_inv.pf_active_out: sink_torax.pf_active_in
    nice_inv.pf_active_out: nice_dir.pf_active_in
    nice_dir.equilibrium_out: sink_dir.equilibrium_in
    accumulator.equilibrium_out: torax.equilibrium_f_init
    torax.equilibrium_o_f: sink_torax.equilibrium_in

settings:
  source.source_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105092/tmp/data/105092_in/"
  sink_nice.sink_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105092/tmp/data/105092_out_nice"
  sink_dir.sink_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105092/tmp/data/105092_out_dir"
  sink_torax.sink_uri: "imas:hdf5?path=[BASEDIR_PLACEHOLDER]/scenario_configs/105092/tmp/data/105092_out_torax"
  torax.output_all_timeslices: True
  xml_path: [BASEDIR_PLACEHOLDER]/scenario_configs/105092/config_nice.xml
  python_config_module: [BASEDIR_PLACEHOLDER]/scenario_configs/105092/config_torax.py
  visualization.plot_file_path: [BASEDIR_PLACEHOLDER]/run/IMAS-muscle3/imas_muscle3/visualization/examples/simple_1d_plot/simple_1d_plot.py
  visualization.port: 5007
  visualization.throttle_interval: 0.1
  visualization.keep_alive: true
  muscle_remote_log_level: 'DEBUG'
implementations:
  source:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  sink:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  accumulator:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.accumulator_component"
  nice_inv:
    modules: SuiteSparse/7.7.0-intel-2023b libxml2
    executable: [BASEDIR_PLACEHOLDER]/run/nice/run/nice_imas_inv_muscle3
  nice_dir:
    modules: SuiteSparse/7.7.0-intel-2023b libxml2
    executable: [BASEDIR_PLACEHOLDER]/run/nice/run/nice_imas_dir_muscle3
  torax:
    base_env: CLEAN
    modules: Python Boost HDF5 libiconv OpenBLAS
    virtual_env: [BASEDIR_PLACEHOLDER]/run/torax/venv
    executable: python
    args: "-u -m torax._src.orchestration.run_muscle3"
  visualization:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.visualization_component"
resources:
  source:
    threads: 1
  sink_nice:
    threads: 1
  sink_torax:
    threads: 1
  sink_dir:
    threads: 1
  accumulator:
    threads: 1
  torax:
    threads: 1
  nice_dir:
    threads: 1
  nice_inv:
    threads: 1
  visualization:
    threads: 1
