ymmsl_version: v0.2
imports:
- from lib.local_programs import implementation source
- from lib.local_programs import implementation sink
models:
  test_sink_source_actor:
    components:
      source_component:
        description: source
        implementation: source
        ports:
          o_i: [equilibrium_out]
      sink_component:
        description: sink
        implementation: sink
        ports:
          f_init: [equilibrium_in]
    conduits:
      source_component.equilibrium_out: sink_component.equilibrium_in
settings:
  source_component.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/input/test_data_ids/"
  sink_component.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/sink_inv"
  sink_component.sink_mode: "w"
resources:
  source_component:
    threads: 1
  sink_component:
    threads: 1
