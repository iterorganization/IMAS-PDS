ymmsl_version: v0.1
model:
  name: test_sink_source_actor
  components:
    source_component:
      implementation: source_component
      ports:
        o_i: [equilibrium_out]
    sink_component:
      implementation: sink_component
      ports:
        f_init: [equilibrium_in]
  conduits:
    source_component.equilibrium_out: sink_component.equilibrium_in
settings:
  source_component.source_uri: "imas:hdf5?path=/work/imas/shared/imasdb/ITER/3/666666/3"
  sink_component.sink_uri: "imas:hdf5?path=/work/imas/shared/imasdb/ITER/3/666666/201"
implementations:
  sink_component:
    virtual_env: /home/ITER/sanderm/gitrepos/imas-m3/venv
    executable: python
    args: -u -m imas_m3.actors.sink_component
  source_component:
    virtual_env: /home/ITER/sanderm/gitrepos/imas-m3/venv
    executable: python
    args: -u -m imas_m3.actors.source_component
resources:
  source_component:
    threads: 1
  sink_component:
    threads: 1
