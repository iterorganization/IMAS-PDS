ymmsl_version: v0.2
# Smoke test for the NICE actors (see setup_files/easyconfigs/n/NICE/).
#
# Only nice_inv and nice_dir are tested here: one-shot actors (F_INIT in,
# O_F out) that fit this source -> actor -> sink topology. nice_evo is
# iterative (O_I/S, needs a feedback loop) -- see workflows/torax_nice_controller.
imports:
- from imas_muscle3 import implementation source_component
- from imas_muscle3 import implementation sink_component
- from lib.easybuild_programs import implementation nice_inv
- from lib.easybuild_programs import implementation nice_dir
models:
  test_nice_actor:
    components:
      source:
        description: source
        implementation: source_component
        ports:
          o_i: [equilibrium_out, wall_out, pf_active_out, pf_passive_out, iron_core_out]
      nice_inv:
        description: NICE inverse equilibrium
        implementation: nice_inv
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_f: [equilibrium_out, pf_active_out]
      nice_dir:
        description: NICE direct equilibrium
        implementation: nice_dir
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_f: [equilibrium_out]
      sink_inv:
        description: sink for nice_inv
        implementation: sink_component
        ports:
          f_init: [equilibrium_in, pf_active_in]
      sink_dir:
        description: sink for nice_dir
        implementation: sink_component
        ports:
          f_init: [equilibrium_in]
    conduits:
      source.equilibrium_out: nice_inv.equilibrium_in
      source.pf_active_out: nice_inv.pf_active_in
      source.wall_out: nice_inv.wall_in
      source.wall_out: nice_dir.wall_in
      source.pf_passive_out: nice_inv.pf_passive_in
      source.pf_passive_out: nice_dir.pf_passive_in
      source.iron_core_out: nice_inv.iron_core_in
      source.iron_core_out: nice_dir.iron_core_in
      nice_inv.equilibrium_out: nice_dir.equilibrium_in
      nice_inv.equilibrium_out: sink_inv.equilibrium_in
      nice_inv.pf_active_out: nice_dir.pf_active_in
      nice_inv.pf_active_out: sink_inv.pf_active_in
      nice_dir.equilibrium_out: sink_dir.equilibrium_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/input/test_data_ids/"
  sink_inv.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/sink_nice_inv"
  sink_inv.sink_mode: "w"
  sink_dir.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/sink_nice_dir"
  sink_dir.sink_mode: "w"
  nice_inv.xml_path: [PWD_PLACEHOLDER]/workflows/inverse_convergence/config_nice.xml
  nice_dir.xml_path: [PWD_PLACEHOLDER]/workflows/inverse_convergence/config_nice.xml
  muscle_remote_log_level: 'DEBUG'
resources:
  source:
    threads: 1
  sink_inv:
    threads: 1
  sink_dir:
    threads: 1
  nice_inv:
    threads: 1
  nice_dir:
    threads: 1
