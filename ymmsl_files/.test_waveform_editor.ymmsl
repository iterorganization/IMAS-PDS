ymmsl_version: v0.1
model:
  name: test_waveform_editor_actor
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out]
    waveform_editor:
      implementation: waveform_editor
      ports:
        f_init: [equilibrium_in]
        o_f: [ec_launchers_out, nbi_out]
    sink:
      implementation: sink
      ports:
        f_init: [ec_launchers_in, nbi_in]
  conduits:
    source.equilibrium_out: waveform_editor.equilibrium_in
    waveform_editor.ec_launchers_out: sink.ec_launchers_in
    waveform_editor.nbi_out: sink.nbi_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/input/test_data_ids/"
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/sink_waveform_editor/"
  waveform_editor.waveforms: [PWD_PLACEHOLDER]/run/Waveform-Editor/tests/muscle3_integration/waveforms.yaml
implementations:
  sink:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-MUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.sink_component
  source:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-MUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.source_component
  waveform_editor:
    virtual_env: [PWD_PLACEHOLDER]/run/Waveform-Editor/venv
    executable: waveform-editor
    args: actor
resources:
  source:
    threads: 1
  sink:
    threads: 1
  waveform_editor:
    threads: 1
