ymmsl_version: v0.1
model:
  name: test_torax_actor
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out]
    accumulator:
      implementation: accumulator
      ports:
        s: [equilibrium_in]
        o_f: [equilibrium_out]
    torax:
      implementation: torax
      ports:
        f_init: [equilibrium_f_init]
        o_f: [equilibrium_o_f]
    sink:
      implementation: sink
      ports:
        f_init: [equilibrium_in]
  conduits:
    source.equilibrium_out: accumulator.equilibrium_in
    accumulator.equilibrium_out: torax.equilibrium_f_init
    torax.equilibrium_o_f: sink.equilibrium_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/input/test_data_ids_torax"
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/sink_torax"
  muscle_remote_log_level: 'DEBUG'
  python_config_module: 'examples/basic_config.py'
implementations:
  source:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  sink:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  accumulator:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: -u -m imas_muscle3.actors.accumulator_component
  torax:
    base_env: CLEAN
    modules: Python Boost HDF5 libiconv OpenBLAS
    virtual_env: [PWD_PLACEHOLDER]/run/torax-m3/venv
    executable: python
    args: "-u -m torax_m3.torax_m3"
resources:
  source:
    threads: 1
  sink:
    threads: 1
  accumulator:
    threads: 1
  torax:
    threads: 1

