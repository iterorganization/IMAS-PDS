ymmsl_version: v0.2
imports:
- from imas_muscle3 import implementation source_component
- from imas_muscle3 import implementation sink_component
models:
  test_torax_actor:
    components:
      source:
        description: source
        implementation: source_component
        ports:
          o_i: [equilibrium_out]
      torax:
        description: TORAX transport
        implementation: torax
        ports:
          f_init: [equilibrium_in_f]
          o_f: [equilibrium_out_f]
      sink:
        description: sink
        implementation: sink_component
        ports:
          f_init: [equilibrium_in]
    conduits:
      source.equilibrium_out: torax.equilibrium_in_f
      torax.equilibrium_out_f: sink.equilibrium_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/input/test_data_ids_torax"
  source.iterative: False
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/sink_torax"
  sink.sink_mode: "w"
  muscle_remote_log_level: 'DEBUG'
  python_config_module: 'examples/basic_config.py'
programs:
  # NOT imported from lib.easybuild_programs: that shared `torax` entry's
  # JAX_COMPILATION_CACHE_DIR references $PDS_REPO, which only resolves
  # because bin/pds-run runs envsubst over local_programs.ymmsl before
  # MUSCLE3 parses it. This file is rendered by setup_files/setup_test_files.sh
  # instead (plain sed, no envsubst), so importing it here would leave
  # $PDS_REPO as a literal, unexpanded string.
  torax:
    base_env: clean
    modules: TORAX-MUSCLE3/0.1.3-intel-2025b-pds
    env:
      IMAS_VERSION: "4.0.0"
    executable: python
    args: "-u -m torax_muscle3.torax_actor"
resources:
  source:
    threads: 1
  sink:
    threads: 1
  torax:
    threads: 1
