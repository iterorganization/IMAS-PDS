ymmsl_version: v0.1
model:
  name: test_torax_actor
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out]
    torax:
      implementation: torax
      ports:
        f_init: [equilibrium_in_f]
        o_f: [equilibrium_out_f]
    sink:
      implementation: sink
      ports:
        f_init: [equilibrium_in]
  conduits:
    source.equilibrium_out: torax.equilibrium_in_f
    torax.equilibrium_out_f: sink.equilibrium_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/input/test_data_ids_torax"
  source.iterative: False
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/sink_torax"
  sink.sink_mode: "w"
  muscle_remote_log_level: 'DEBUG'
  python_config_module: 'examples/basic_config.py'
implementations:
  source:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  sink:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  torax:
    base_env: clean
    modules: PDS-TORAX-MUSCLE3
    virtual_env: $EBROOTTORAXMUSCLE3/venv
    env:
      IMAS_VERSION: "4.0.0"
    executable: python
    args: "-u -m torax_muscle3.torax_actor"
resources:
  source:
    threads: 1
  sink:
    threads: 1
  torax:
    threads: 1

