ymmsl_version: v0.1
model:
  name: torax_muscle3
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out]
    torax:
      implementation: torax
      ports:
        f_init: [equilibrium_in]
  conduits:
    source.equilibrium_out: torax.equilibrium_in
settings:
  source.source_uri: "imas:hdf5?path=/work/imas/shared/imasdb/ITER/3/130012/4"
  muscle_remote_log_level: 'DEBUG'
  python_config_module: 'torax.examples.basic_config'
implementations:
  source:
    executable: python
    args: "-u -m pds.utils.source_component"
  torax:
    executable: python
    args: "-u /home/ITER/sanderm/gitrepos/torax-m3/torax_m3/torax_m3.py"
resources:
  source:
    threads: 1
  torax:
    threads: 1

