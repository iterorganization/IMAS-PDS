ymmsl_version: v0.1
model:
  name: test_torax_actor
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out]
    torax:
      implementation: torax
      ports:
        f_init: [equilibrium_in]
        o_f: [equilibrium_out]
    sink:
      implementation: sink
      ports:
        f_init: [equilibrium_in]
  conduits:
    source.equilibrium_out: torax.equilibrium_in
    torax.equilibrium_out: sink.equilibrium_in
settings:
  source.source_uri: "imas:hdf5?path=/home/ITER/sanderm/gitrepos/pds/ymmsl_files/input/test_data_ids/"
  sink.sink_uri: "imas:hdf5?path=/home/ITER/sanderm/gitrepos/pds/ymmsl_files/output/sink_torax/"
  muscle_remote_log_level: 'DEBUG'
  python_config_module: 'torax.examples.basic_config'
implementations:
  source:
    virtual_env: $HOME/gitrepos/imas-m3/venv
    executable: python
    args: "-u -m imas_m3.actors.source_component"
  sink:
    virtual_env: $HOME/gitrepos/imas-m3/venv
    executable: python
    args: "-u -m imas_m3.actors.sink_component"
  torax:
    virtual_env: $HOME/gitrepos/torax-m3/venv
    executable: python
    args: "-u $HOME/gitrepos/torax-m3/torax_m3/torax_m3.py"
resources:
  source:
    threads: 1
  sink:
    threads: 1
  torax:
    threads: 1

