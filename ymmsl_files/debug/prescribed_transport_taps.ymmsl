ymmsl_version: v0.2

# prescribed_transport, with a "tap" sink on every stream between the top-level
# components, to find out which IDSs are passed around and which of their nodes are
# actually filled.
#
# This is the workflow's structure only: it takes the settings of a case built the
# normal way, so build the case first and stack its settings files after this one.
#
#   bin/pds-create-case prescribed_transport 105092
#
#   # --run-dir has to exist already; the manager will not create it
#   RUN=cases/runs/taps_prescribed_transport_105092
#   mkdir -p $RUN
#
#   muscle_manager --start-all --run-dir $RUN \
#       ymmsl_files/debug/prescribed_transport_taps.ymmsl \
#       cases/prescribed_transport_105092/workflow_settings.ymmsl \
#       ymmsl_files/debug/single_slice.ymmsl
#
# (add the case's scenario_settings.ymmsl to that list if it has one). The taps then
# leave one DBEntry per component under <run_dir>/taps/:
#
#   taps/source            what `source` sent to the waveform editor
#   taps/waveform_editor   what the waveform editor sent to the equilibrium solve
#   taps/equilibrium       what the equilibrium solve sent on (same as out_nice)
#
# Then list what is filled in each of them:
#
#   ci/list_filled_nodes.py cases/runs/taps_prescribed_transport_105092/taps/*
#
# The taps are ordinary sink actors, so they only see what crosses a conduit between
# the top-level components. Traffic *inside* the `equilibrium` submodel (the load
# balancer scattering slices to the NICE workers and gathering them back) carries the
# same IDSs one timeslice at a time and is not tapped here.

imports:
- from imas_muscle3 import implementation source_component
- from imas_muscle3 import implementation sink_component
- from imas_muscle3 import implementation recorder_component
- from lib.easybuild_programs import implementation waveform_editor
- from lib.easybuild_programs import implementation nice_inv
- from lib.easybuild_programs import implementation load_balancer

models:
  nice_inverse:
    description: NICE inverse solve, load-balanced over N workers
    ports:
      f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
      o_f: [equilibrium_out_f, pf_active_out_f]
    components:
      load_balancer:
        description: IMAS-aware NICE load balancer -- scatters slices, gathers results
        implementation: load_balancer
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_i: [equilibrium_scatter, wall_scatter, pf_active_scatter, pf_passive_scatter, iron_core_scatter]
          s: [equilibrium_gather, pf_active_gather]
          o_f: [equilibrium_out_f, pf_active_out_f]
      nice:
        description: NICE inverse worker
        implementation: nice_inv
        multiplicity: [1]
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_f: [equilibrium_out, pf_active_out]
    conduits:
      equilibrium_in: load_balancer.equilibrium_in
      wall_in: load_balancer.wall_in
      pf_active_in: load_balancer.pf_active_in
      pf_passive_in: load_balancer.pf_passive_in
      iron_core_in: load_balancer.iron_core_in
      load_balancer.equilibrium_scatter: nice.equilibrium_in
      load_balancer.wall_scatter: nice.wall_in
      load_balancer.pf_active_scatter: nice.pf_active_in
      load_balancer.pf_passive_scatter: nice.pf_passive_in
      load_balancer.iron_core_scatter: nice.iron_core_in
      nice.equilibrium_out: load_balancer.equilibrium_gather
      nice.pf_active_out: load_balancer.pf_active_gather
      load_balancer.equilibrium_out_f: equilibrium_out_f
      load_balancer.pf_active_out_f: pf_active_out_f

  prescribed_transport:
    description: Single-pass inverse solve against a prescribed boundary, with taps.
    components:
      source:
        description: source -- seeds the equilibrium trace
        implementation: source_component
        ports: {o_i: [equilibrium_out]}
      waveform_editor:
        description: waveform editor (designed Ip/B0 target + static machine description + coil-current seed)
        implementation: waveform_editor
        ports:
          f_init: [equilibrium_in]
          o_f: [equilibrium_out, wall_out, pf_active_out, pf_passive_out, iron_core_out]
      equilibrium:
        description: NICE inverse solve (load-balanced over N workers)
        implementation: nice_inverse
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_f: [equilibrium_out_f, pf_active_out_f]

      tap_source:
        description: tap -- everything `source` sends out
        implementation: sink_component
        ports: {f_init: [equilibrium_in]}
      tap_waveform_editor:
        description: tap -- everything the waveform editor sends out
        implementation: sink_component
        ports: {f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]}
      tap_equilibrium:
        description: tap -- everything the equilibrium solve sends out
        implementation: sink_component
        ports: {f_init: [equilibrium_in, pf_active_in]}

    conduits:
      source.equilibrium_out: [waveform_editor.equilibrium_in, tap_source.equilibrium_in]

      waveform_editor.equilibrium_out: [equilibrium.equilibrium_in, tap_waveform_editor.equilibrium_in]
      waveform_editor.wall_out: [equilibrium.wall_in, tap_waveform_editor.wall_in]
      waveform_editor.pf_active_out: [equilibrium.pf_active_in, tap_waveform_editor.pf_active_in]
      waveform_editor.pf_passive_out: [equilibrium.pf_passive_in, tap_waveform_editor.pf_passive_in]
      waveform_editor.iron_core_out: [equilibrium.iron_core_in, tap_waveform_editor.iron_core_in]

      equilibrium.equilibrium_out_f: tap_equilibrium.equilibrium_in
      equilibrium.pf_active_out_f: tap_equilibrium.pf_active_in

resources:
  prescribed_transport.equilibrium.nice: {threads: 2}
  prescribed_transport.source: {threads: 1}
  prescribed_transport.waveform_editor: {threads: 1}
  prescribed_transport.equilibrium.load_balancer: {threads: 1}
  prescribed_transport.tap_source: {threads: 1}
  prescribed_transport.tap_waveform_editor: {threads: 1}
  prescribed_transport.tap_equilibrium: {threads: 1}

settings:
  # `../../../` climbs out of the instance's own work directory, so the entries land
  # in <run_dir>/taps/ rather than under instances/.
  tap_source.sink_uri: "imas:hdf5?path=../../../taps/source"
  tap_source.sink_mode: "w"
  tap_waveform_editor.sink_uri: "imas:hdf5?path=../../../taps/waveform_editor"
  tap_waveform_editor.sink_mode: "w"
  tap_equilibrium.sink_uri: "imas:hdf5?path=../../../taps/equilibrium"
  tap_equilibrium.sink_mode: "w"
