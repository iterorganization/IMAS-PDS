ymmsl_version: v0.2
imports:
- from imas_muscle3 import implementation source_component
- from imas_muscle3 import implementation sink_component
- from imas_muscle3 import implementation accumulator_component
models:
  test_accumulator_actor:
    components:
      source:
        description: source
        implementation: source_component
        ports:
          o_i: [equilibrium_out]
      accumulator:
        description: accumulator
        implementation: accumulator_component
        ports:
          s: [equilibrium_in]
          o_f: [equilibrium_out]
      accumulator_optional_port:
        description: accumulator with an optional port connected
        implementation: accumulator_component
        ports:
          s: [equilibrium_in, t_next]
          o_f: [equilibrium_out]
      sink:
        description: sink
        implementation: sink_component
        ports:
          f_init: [equilibrium_in]
      sink_optional_port:
        description: sink for the optional-port accumulator
        implementation: sink_component
        ports:
          f_init: [equilibrium_in]
    conduits:
      source.equilibrium_out: accumulator.equilibrium_in
      source.equilibrium_out: accumulator_optional_port.equilibrium_in
      source.equilibrium_out: accumulator_optional_port.t_next
      accumulator.equilibrium_out: sink.equilibrium_in
      accumulator_optional_port.equilibrium_out: sink_optional_port.equilibrium_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/input/test_data_ids/"
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/sink_accumulator"
  sink.sink_mode: "w"
  sink_optional_port.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/sink_accumulator_optional_port"
  sink_optional_port.sink_mode: "w"
resources:
  source:
    threads: 1
  sink:
    threads: 1
  sink_optional_port:
    threads: 1
  accumulator:
    threads: 1
  accumulator_optional_port:
    threads: 1
