ymmsl_version: v0.1
model:
  name: test_visualization_actor
  components:
    source_component:
      implementation: source_component
      ports:
        o_i: [equilibrium_out]
    visualization_component:
      implementation: visualization_component
      ports:
        s: [equilibrium_in]
  conduits:
    source_component.equilibrium_out: visualization_component.equilibrium_in
settings:
  source_component.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/input/test_data_ids/"
  visualization_component.plot_file_path: "[PWD_PLACEHOLDER]/visualization/kinetic_profiles.py"
  visualization_component.throttle_interval: 0
  visualization_component.keep_alive: false
  visualization_component.open_browser: false
implementations:
  visualization_component:
    executable: [PWD_PLACEHOLDER]/run/IMAS-MUSCLE3/venv/bin/python
    args: -u -m imas_muscle3.actors.visualization_component
  source_component:
    executable: [PWD_PLACEHOLDER]/run/IMAS-MUSCLE3/venv/bin/python
    args: -u -m imas_muscle3.actors.source_component
resources:
  source_component:
    threads: 1
  visualization_component:
    threads: 1
