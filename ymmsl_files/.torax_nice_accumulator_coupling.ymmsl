ymmsl_version: v0.1
model:
  name: torax_nice_accumulator_coupling
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out, wall_out, pf_active_out, pf_passive_out, iron_core_out]
    nice_inv:
      implementation: nice_inv
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
        o_f: [equilibrium_out, pf_active_out]
    accumulator:
      implementation: accumulator
      ports:
        s: [equilibrium_in]
        o_f: [equilibrium_out]
    torax:
      implementation: torax
      ports:
        f_init: [equilibrium_f_init]
        o_f: [equilibrium_o_f]
    sink:
      implementation: sink
      ports:
        f_init: [equilibrium_in]
  conduits:
    source.equilibrium_out: nice_inv.equilibrium_in
    source.pf_active_out: nice_inv.pf_active_in
    source.pf_passive_out: nice_inv.pf_passive_in
    source.iron_core_out: nice_inv.iron_core_in
    source.wall_out: nice_inv.wall_in
    nice_inv.equilibrium_out: accumulator.equilibrium_in
    accumulator.equilibrium_out: torax.equilibrium_f_init
    torax.equilibrium_o_i: sink.equilibrium_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/input/test_data_ids/"
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/sink_torax_nice_accumulator/"
  nice_inv.xml_path: "[PWD_PLACEHOLDER]/nice/run/input/param.xml"
  torax.python_config_module: '[PWD_PLACEHOLDER]/scenario_configs/torax_default/config_torax.py'
  muscle_remote_log_level: 'DEBUG'
implementations:
  source:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  sink:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  accumulator:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.accumulator_component"
  torax:
    base_env: CLEAN
    modules: Python Boost HDF5 MUSCLE3
    virtual_env: [PWD_PLACEHOLDER]/run/torax/venv
    executable: python
    args: "-u -m torax._src.orchestration.run_muscle3"
  nice_inv:
    modules: SuiteSparse/7.7.0-intel-2023b libxml2
    executable: [PWD_PLACEHOLDER]/run/nice/run/nice_imas_inv_muscle3
resources:
  source:
    threads: 1
  sink:
    threads: 1
  accumulator:
    threads: 1
  torax:
    threads: 1
  nice_inv:
    threads: 1

