ymmsl_version: v0.1
model:
  name: torax_nice_accumulator_coupling
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out]
    nice:
      implementation: sink
      ports:
        f_init: [equilibrium_in]
        o_f: [equilibrium_out]
    accumulator:
      implementation: accumulator
      ports:
        s: [equilibrium_in]
        o_f: [equilibrium_out]
    torax:
      implementation: torax
      ports:
        f_init: [equilibrium_f_init]
        o_i: [equilibrium_o_i]
    sink:
      implementation: sink
      ports:
        f_init: [equilibrium_in]
  conduits:
    source.equilibrium_out: nice.equilibrium_in
    nice.equilibrium_out: accumulator.equilibrium_in
    accumulator.equilibrium_out: torax.equilibrium_f_init
    torax.equilibrium_o_i: sink.equilibrium_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/pds/ymmsl_files/input/test_data_ids/"
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/pds/ymmsl_files/output/sink_torax_nice_accumulator/"
  nice_inv.xml_path: "[PWD_PLACEHOLDER]/nice/run/input/param.xml"
  torax.python_config_module: 'torax.examples.basic_config'
  muscle_remote_log_level: 'DEBUG'
implementations:
  source:
    virtual_env: IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  sink:
    virtual_env: IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  accumulator:
    virtual_env: IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.accumulator_component"
  torax:
    base_env: CLEAN
    modules: Python Boost HDF5 MUSCLE3
    virtual_env: torax-m3/venv
    executable: python
    args: "-u -m torax_m3.torax_m3"
  nice_inv:
    modules: SuiteSparse/7.7.0-intel-2023b libxml2
    executable: nice/run/nice_imas_inv_muscle3
resources:
  source:
    threads: 1
  sink:
    threads: 1
  accumulator:
    threads: 1
  torax:
    threads: 1
  nice_inv:
    threads: 1

