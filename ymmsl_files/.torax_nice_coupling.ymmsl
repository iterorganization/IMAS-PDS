ymmsl_version: v0.1
model:
  name: torax_nice_coupling
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out, wall_out, pf_active_out, pf_passive_out, iron_core_out]
    nice_inv_init:
      implementation: nice_inv
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
        o_f: [equilibrium_out, pf_active_out]
    sink:
      implementation: sink
      ports:
        f_init: [equilibrium_in]
    sink_source:
      implementation: sink_source
      ports:
        f_init: [equilibrium_in]
        o_f: [wall_out, pf_active_out, pf_passive_out, iron_core_out]
    nice_inv:
      implementation: nice_inv
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
        o_f: [equilibrium_out, pf_active_out]
    torax:
      implementation: torax
      ports:
        f_init: [equilibrium_f_init]
        o_i: [equilibrium_o_i]
        s: [equilibrium_s]
        o_f: [equilibrium_o_f]
    olc:
      implementation: olc
      ports:
        f_init: [pf_active_in]
  conduits:
    source.equilibrium_out: nice_inv_init.equilibrium_in
    source.pf_active_out: nice_inv_init.pf_active_in
    source.pf_passive_out: nice_inv_init.pf_passive_in
    source.iron_core_out: nice_inv_init.iron_core_in
    source.wall_out: nice_inv_init.wall_in
    nice_inv_init.equilibrium_out: torax.equilibrium_f_init
    torax.equilibrium_o_i: nice_inv.equilibrium_in
    torax.equilibrium_o_i: sink_source.equilibrium_in
    sink_source.pf_passive_out: nice_inv.pf_passive_in
    sink_source.pf_active_out: nice_inv.pf_active_in
    sink_source.iron_core_out: nice_inv.iron_core_in
    sink_source.wall_out: nice_inv.wall_in
    nice_inv.equilibrium_out: torax.equilibrium_s
    nice_inv.pf_active_out: olc.pf_active_in
    torax.equilibrium_o_f: sink.equilibrium_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/input/test_data_ids/"
  sink_source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/input/test_data_ids/"
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/sink_torax/"
  olc.extra_rule_dirs: "[PWD_PLACEHOLDER]/pds_validation_tests"
  olc.rulesets: "iter-olc"
  olc.apply_generic: False
  xml_path: "[PWD_PLACEHOLDER]/nice/run/input/param.xml"
  muscle_remote_log_level: 'DEBUG'
  python_config_module: 'examples/basic_config.py'
implementations:
  sink:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  source:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  sink_source:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_source_component"
  olc:
    modules: IDS-Validator
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.olc_component"
  torax:
    base_env: CLEAN
    modules: Python Boost HDF5 MUSCLE3
    virtual_env: [PWD_PLACEHOLDER]/run/torax/venv
    executable: python
    args: "-u -m torax._src.orchestration.run_muscle3"
  nice_inv:
    modules: SuiteSparse/7.7.0-intel-2023b libxml2
    executable: [PWD_PLACEHOLDER]/run/nice/run/nice_imas_inv_muscle3
resources:
  source:
    threads: 1
  sink:
    threads: 1
  sink_source:
    threads: 1
  nice_inv_init:
    threads: 1
  nice_inv:
    threads: 1
  torax:
    threads: 1
  olc:
    threads: 1

