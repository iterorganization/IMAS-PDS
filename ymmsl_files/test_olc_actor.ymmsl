ymmsl_version: v0.1
model:
  name: test_olc_actor
  components:
    source:
      implementation: source
      ports:
        o_i: [pf_active_out]
    olc:
      implementation: olc
      ports:
        f_init: [pf_active_in]
  conduits:
    source.pf_active_out: olc.pf_active_in
settings:
  source.source_uri: "imas:hdf5?path=/work/imas/shared/imasdb/ITER_MD/3/111001/103"
  olc.extra_rule_dirs: "/home/ITER/sanderm/gitrepos/pds/pds_validation_tests"
  olc.rulesets: "iter-olc"
  olc.apply_generic: False
  olc.halt_on_error: False
  muscle_remote_log_level: 'DEBUG'
implementations:
  olc:
    virtual_env: /home/ITER/sanderm/gitrepos/imas_m3/venv
    executable: python
    args: -u -m imas_m3.actors.olc_component
  source:
    virtual_env: /home/ITER/sanderm/gitrepos/imas_m3/venv
    executable: python
    args: -u -m imas_m3.actors.source_component
resources:
  source:
    threads: 1
  olc:
    threads: 1
