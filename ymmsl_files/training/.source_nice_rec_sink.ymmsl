ymmsl_version: v0.1
model:
  name: source_nice_rec_sink
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out, wall_out, pf_active_out, pf_passive_out, iron_core_out]
    nice:
      implementation: nice_inv
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
        o_f: [equilibrium_out, pf_active_out]
    rec:
      implementation: recorder
      ports:
        s: [equilibrium_in, pf_active_in]
    sink:
      implementation: sink
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
  conduits:
    source.equilibrium_out: nice.equilibrium_in
    source.pf_active_out: nice.pf_active_in
    source.pf_passive_out:
    - nice.pf_passive_in
    - sink.pf_passive_in
    source.wall_out:
    - nice.wall_in
    - sink.wall_in
    source.iron_core_out:
    - nice.iron_core_in
    - sink.iron_core_in
    nice.equilibrium_out:
    - sink.equilibrium_in
    - rec.equilibrium_in
    nice.pf_active_out:
    - sink.pf_active_in
    - rec.pf_active_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/training_data/training_ids/"
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/cases/output/training/source_nice_rec_sink"
  sink.sink_mode: "x"
  nice.xml_path: [PWD_PLACEHOLDER]/training_data/nice_param.xml
  muscle_remote_log_level: 'DEBUG'
  rec.config: [PWD_PLACEHOLDER]/visualization/nice_inv.py
  rec.md: "wall=imas:hdf5?path=[PWD_PLACEHOLDER]/training_data/training_ids/ pf_active=imas:hdf5?path=[PWD_PLACEHOLDER]/training_data/training_ids/"
implementations:
  source:
    base_env: clean
    modules: IMAS-MUSCLE3/1.0.0-intel-2025b-pds
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  sink:
    base_env: clean
    modules: IMAS-MUSCLE3/1.0.0-intel-2025b-pds
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  nice_inv:
    base_env: clean
    modules: NICE/3.0.0.dev258-intel-2025b-pds
    env:
      IMAS_AL_DISABLE_VALIDATE: 1
      IMAS_VERSION: "4.0.0"
    executable: $EBROOTNICE/run/nice_imas_inv_muscle3
  recorder:
    base_env: clean
    modules: IMAS-MUSCLE3/1.0.0-intel-2025b-pds
    executable: python
    args: -u -m imas_muscle3.actors.recorder_component
resources:
  source:
    threads: 1
  nice:
    threads: 1
  rec:
    threads: 1
  sink:
    threads: 1
