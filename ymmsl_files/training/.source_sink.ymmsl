ymmsl_version: v0.1
model:
  name: source_sink
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out]
    sink:
      implementation: sink
      ports:
        f_init: [equilibrium_in]
  conduits:
    source.equilibrium_out: sink.equilibrium_in
settings:
  source.source_uri: "imas:hdf5?path=/home/ITER/sanderm/public/imasdb/ITER/training_ids"
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/training/source_sink"
implementations:
  source:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  sink:
    virtual_env: [PWD_PLACEHOLDER]/run/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
resources:
  source:
    threads: 1
  sink:
    threads: 1
