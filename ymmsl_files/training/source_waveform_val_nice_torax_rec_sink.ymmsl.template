ymmsl_version: v0.2
imports:
- from imas_muscle3 import implementation source_component
- from imas_muscle3 import implementation sink_component
- from imas_muscle3 import implementation recorder_component
- from imas_muscle3 import implementation olc_component
- from imas_muscle3 import implementation accumulator_component
- from lib.easybuild_programs import implementation waveform_editor
- from lib.easybuild_programs import implementation nice_inv
- from lib.easybuild_programs import implementation torax
models:
  source_waveform_val_nice_torax_rec_sink:
    components:
      source:
        description: source -- reads the equilibrium IDS from the training data
        implementation: source_component
        ports:
          o_i: [equilibrium_out, wall_out, pf_active_out, pf_passive_out, iron_core_out]
      waveform_editor:
        description: waveform editor -- designed Ip/B0 target
        implementation: waveform_editor
        ports:
          f_init: [equilibrium_in]
          o_f: [equilibrium_out]
      olc:
        description: IMAS-validator actor -- checks the equilibrium against a ruleset
        implementation: olc_component
        ports:
          f_init: [equilibrium_in]
      nice:
        description: NICE inverse solve -- computes the coil currents for the target shape
        implementation: nice_inv
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_f: [equilibrium_out, pf_active_out]
      accumulator:
        description: accumulator -- gathers single timeslices into one multi-timeslice IDS
        implementation: accumulator_component
        ports:
          s: [equilibrium_in]
          o_f: [equilibrium_out]
      torax:
        description: TORAX transport solver
        implementation: torax
        ports:
          f_init: [equilibrium_in_f]
          o_f: [equilibrium_out_f, core_profiles_out_f]
      rec:
        description: distill recorder -- writes a live-plottable copy of the NICE output
        implementation: recorder_component
        ports:
          s: [equilibrium_in, pf_active_in]
      sink:
        description: sink -- writes the solved equilibrium, coil currents and core profiles
        implementation: sink_component
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in, core_profiles_in]
    conduits:
      source.equilibrium_out: waveform_editor.equilibrium_in
      source.wall_out:
      - nice.wall_in
      - sink.wall_in
      source.pf_active_out: nice.pf_active_in
      source.pf_passive_out:
      - nice.pf_passive_in
      - sink.pf_passive_in
      source.iron_core_out:
      - nice.iron_core_in
      - sink.iron_core_in
      waveform_editor.equilibrium_out:
      - nice.equilibrium_in
      - olc.equilibrium_in
      nice.equilibrium_out:
      - rec.equilibrium_in
      - accumulator.equilibrium_in
      nice.pf_active_out:
      - sink.pf_active_in
      - rec.pf_active_in
      accumulator.equilibrium_out: torax.equilibrium_in_f
      torax.equilibrium_out_f: sink.equilibrium_in
      torax.core_profiles_out_f: sink.core_profiles_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/training_data/training_ids/"
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/cases/output/training/source_waveform_val_nice_torax_rec_sink"
  sink.sink_mode: "x"
  nice.xml_path: [PWD_PLACEHOLDER]/training_data/nice_param.xml
  muscle_remote_log_level: 'DEBUG'
  rec.config: [PWD_PLACEHOLDER]/visualization/nice_inv.py
  rec.md: "wall=imas:hdf5?path=[PWD_PLACEHOLDER]/training_data/training_ids/ pf_active=imas:hdf5?path=[PWD_PLACEHOLDER]/training_data/training_ids/"
  waveform_editor.waveforms: [PWD_PLACEHOLDER]/ymmsl_files/training/waveform_config.yaml
  olc.extra_rule_dirs: "[PWD_PLACEHOLDER]/pds_validation_tests"
  olc.rulesets: "training"
  olc.apply_generic: False
  olc.halt_on_error: True
  torax.python_config_module: '[PWD_PLACEHOLDER]/training_data/config_torax.py'
  torax.output_all_timeslices: true
resources:
  source:
    threads: 1
  nice:
    threads: 1
  rec:
    threads: 1
  sink:
    threads: 1
  olc:
    threads: 1
  waveform_editor:
    threads: 1
  accumulator:
    threads: 1
  torax:
    threads: 1
