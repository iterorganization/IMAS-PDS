ymmsl_version: v0.1
model:
  name: source_waveform_val_nice_torax_rec_sink
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out, wall_out, pf_active_out, pf_passive_out, iron_core_out]
    waveform_editor:
      implementation: waveform_editor
      ports:
        f_init: [equilibrium_in]
        o_f: [equilibrium_out]
    olc:
      implementation: olc
      ports:
        f_init: [equilibrium_in]
    nice:
      implementation: nice_inv
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
        o_f: [equilibrium_out, pf_active_out]
    accumulator:
      implementation: accumulator
      ports:
        s: [equilibrium_in]
        o_f: [equilibrium_out]
    torax:
      implementation: torax
      ports:
        f_init: [equilibrium_in_f]
        o_f: [equilibrium_out_f, core_profiles_out_f]
    rec:
      implementation: recorder
      ports:
        s: [equilibrium_in, pf_active_in]
    sink:
      implementation: sink
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in, core_profiles_in]
  conduits:
    source.equilibrium_out: waveform_editor.equilibrium_in
    source.wall_out:
    - nice.wall_in
    - sink.wall_in
    source.pf_active_out: nice.pf_active_in
    source.pf_passive_out:
    - nice.pf_passive_in
    - sink.pf_passive_in
    source.iron_core_out:
    - nice.iron_core_in
    - sink.iron_core_in
    waveform_editor.equilibrium_out:
    - nice.equilibrium_in
    - olc.equilibrium_in
    nice.equilibrium_out:
    - rec.equilibrium_in
    - accumulator.equilibrium_in
    nice.pf_active_out:
    - sink.pf_active_in
    - rec.pf_active_in
    accumulator.equilibrium_out: torax.equilibrium_in_f
    torax.equilibrium_out_f: sink.equilibrium_in
    torax.core_profiles_out_f: sink.core_profiles_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/training_data/training_ids/"
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/cases/output/training/source_waveform_val_nice_torax_rec_sink"
  sink.sink_mode: "x"
  nice.xml_path: [PWD_PLACEHOLDER]/training_data/nice_param.xml
  muscle_remote_log_level: 'DEBUG'
  rec.config: [PWD_PLACEHOLDER]/visualization/nice_inv.py
  rec.md: "wall=imas:hdf5?path=[PWD_PLACEHOLDER]/training_data/training_ids/ pf_active=imas:hdf5?path=[PWD_PLACEHOLDER]/training_data/training_ids/"
  waveform_editor.waveforms: [PWD_PLACEHOLDER]/ymmsl_files/training/waveform_config.yaml
  olc.extra_rule_dirs: "[PWD_PLACEHOLDER]/pds_validation_tests"
  olc.rulesets: "training"
  olc.apply_generic: False
  olc.halt_on_error: True
  torax.python_config_module: '[PWD_PLACEHOLDER]/training_data/config_torax.py'
  torax.output_all_timeslices: true
implementations:
  source:
    base_env: clean
    modules: IMAS-MUSCLE3/1.0.0-intel-2025b-pds
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  waveform_editor:
    base_env: clean
    modules: Waveform-Editor/0.3.1-intel-2025b
    executable: waveform-editor
    args: actor
  olc:
    base_env: clean
    modules: IMAS-MUSCLE3/1.0.0-intel-2025b-pds
    executable: python
    args: -u -m imas_muscle3.actors.olc_component
  sink:
    base_env: clean
    modules: IMAS-MUSCLE3/1.0.0-intel-2025b-pds
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  nice_inv:
    base_env: clean
    modules: NICE/3.0.0.dev258-intel-2025b-pds
    env:
      IMAS_AL_DISABLE_VALIDATE: 1
      IMAS_VERSION: "4.0.0"
    executable: $EBROOTNICE/run/nice_imas_inv_muscle3
  recorder:
    base_env: clean
    modules: IMAS-MUSCLE3/1.0.0-intel-2025b-pds
    executable: python
    args: -u -m imas_muscle3.actors.recorder_component
  accumulator:
    base_env: clean
    modules: IMAS-MUSCLE3/1.0.0-intel-2025b-pds
    executable: python
    args: "-u -m imas_muscle3.actors.accumulator_component"
  torax:
    base_env: clean
    modules: TORAX-MUSCLE3/0.1.2-intel-2025b-pds
    env:
      IMAS_VERSION: "4.0.0"
      JAX_COMPILATION_CACHE_DIR: [PWD_PLACEHOLDER]/tmp/jax_cache
      JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS: 0
    executable: python
    args: -u -m torax_muscle3.torax_actor

resources:
  source:
    threads: 1
  nice:
    threads: 1
  rec:
    threads: 1
  sink:
    threads: 1
  olc:
    threads: 1
  waveform_editor:
    threads: 1
  accumulator:
    threads: 1
  torax:
    threads: 1
