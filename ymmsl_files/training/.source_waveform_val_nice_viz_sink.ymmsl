ymmsl_version: v0.1
model:
  name: source_waveform_nice_viz_sink
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out, wall_out, pf_active_out, pf_passive_out, iron_core_out]
    waveform_editor:
      implementation: waveform_editor
      ports:
        f_init: [equilibrium_in]
        o_f: [equilibrium_out]
    olc:
      implementation: olc
      ports:
        f_init: [equilibrium_in]
    nice:
      implementation: nice_inv
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
        o_f: [equilibrium_out, pf_active_out]
    visualization:
      implementation: visualization_component
      ports:
        s: [equilibrium_in, pf_active_in,pf_active_md_in, wall_md_in]
    sink:
      implementation: sink
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
  conduits:
    source.equilibrium_out: waveform_editor.equilibrium_in
    source.pf_active_out:
    - nice.pf_active_in
    - visualization.pf_active_md_in
    source.pf_passive_out:
    - nice.pf_passive_in
    - sink.pf_passive_in
    source.wall_out:
    - nice.wall_in
    - sink.wall_in
    - visualization.wall_md_in
    source.iron_core_out:
    - nice.iron_core_in
    - sink.iron_core_in
    waveform_editor.equilibrium_out:
    - nice.equilibrium_in
    - olc.equilibrium_in
    nice.equilibrium_out:
    - sink.equilibrium_in
    - visualization.equilibrium_in
    nice.pf_active_out:
    - sink.pf_active_in
    - visualization.pf_active_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/training_data/training_ids/"
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/run/output/training/source_waveform_nice_viz_sink"
  sink.sink_mode: "x"
  nice.xml_path: [PWD_PLACEHOLDER]/training_data/nice_param.xml
  muscle_remote_log_level: 'DEBUG'
  visualization.plot_file_path: [PWD_PLACEHOLDER]/visualization/nice_inv.py
  visualization.automatic_mode: true
  waveform_editor.waveforms: [PWD_PLACEHOLDER]/ymmsl_files/training/waveform_config.yaml
  olc.extra_rule_dirs: "[PWD_PLACEHOLDER]/pds_validation_tests"
  olc.rulesets: "training"
  olc.apply_generic: False
  olc.halt_on_error: True
implementations:
  source:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  waveform_editor:
    base_env: clean
    modules: PDS-Waveform-Editor
    virtual_env: $EBROOTWAVEFORMEDITOR/venv
    executable: waveform-editor
    args: actor
  olc:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.olc_component
  sink:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  nice_inv:
    base_env: clean
    modules: PDS-NICE
    env:
      IMAS_AL_DISABLE_VALIDATE: 1
      IMAS_VERSION: "4.0.0"
    executable: $EBROOTNICE/run/nice_imas_inv_muscle3
  visualization_component:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.visualization_component
resources:
  source:
    threads: 1
  nice:
    threads: 1
  visualization:
    threads: 1
  sink:
    threads: 1
  olc:
    threads: 1
  waveform_editor:
    threads: 1
