ymmsl_version: v0.1
model:
  name: test_sink_source_actor
  components:
    source_component:
      implementation: source_component
      ports:
        o_i: [equilibrium_out]
    sink_component:
      implementation: sink_component
      ports:
        f_init: [equilibrium_in]
  conduits:
    source_component.equilibrium_out: sink_component.equilibrium_in
settings:
  source_component.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/pds/ymmsl_files/input/test_data_ids/"
  sink_component.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/pds/ymmsl_files/output/sink_inv/"
implementations:
  sink_component:
    virtual_env: [PWD_PLACEHOLDER]/IMAS-muscle3/venv
    executable: python
    args: -u -m imas_muscle3.actors.sink_component
  source_component:
    virtual_env: [PWD_PLACEHOLDER]/IMAS-muscle3/venv
    executable: python
    args: -u -m imas_muscle3.actors.source_component
resources:
  source_component:
    threads: 1
  sink_component:
    threads: 1
