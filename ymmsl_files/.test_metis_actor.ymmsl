ymmsl_version: v0.1
model:
  name: test_metis_actor
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out]
    metis:
      implementation: metis
      ports:
        f_init: [equilibrium]
        o_f: [equilibrium_output]
    sink:
      implementation: sink
      ports:
        f_init: [equilibrium_in]
  conduits:
    source.equilibrium_out: metis.equilibrium
    metis.equilibrium_output: sink.equilibrium_in
settings:
  source.source_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/pds/ymmsl_files/input/test_data_ids/"
  sink.sink_uri: "imas:hdf5?path=[PWD_PLACEHOLDER]/pds/ymmsl_files/output/sink_metis/"
  muscle_remote_log_level: 'debug'
implementations:
  source:
    virtual_env: [PWD_PLACEHOLDER]/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  sink:
    virtual_env: [PWD_PLACEHOLDER]/IMAS-muscle3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  metis: 
    modules: MATLAB
    env:
      DIR_METIS4MUSCLE3: [PWD_PLACEHOLDER]/metis/workflow/muscle3/mfile
    executable: matlab
    args: -batch "[s,t] = unix('which python');pyenv('Version',strtrim(t),'ExecutionMode','InProcess');addpath(getenv('DIR_METIS4MUSCLE3'));metis4muscle3(3);"
resources:
  source:
    threads: 1
  sink:
    threads: 1
  metis:
    threads: 1
