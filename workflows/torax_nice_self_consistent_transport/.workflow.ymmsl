ymmsl_version: v0.1
model:
  name: self_consistent_transport_[SHOT_NR]
  components:
    source:
      implementation: source
      ports:
        o_i: [equilibrium_out, wall_out, pf_active_out, pf_passive_out, iron_core_out, core_profiles_out]
    nice_inv:
      implementation: nice_inv
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
        o_f: [equilibrium_out, pf_active_out]
    accumulator:
      implementation: accumulator
      ports:
        s: [equilibrium_in, core_profiles_in]
        o_f: [equilibrium_out, core_profiles_out]
    acc2:
      implementation: accumulator
      ports:
        s: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in, core_profiles_in]
        o_f: [equilibrium_out, wall_out, pf_active_out, pf_passive_out, iron_core_out, core_profiles_out]
    torax:
      implementation: torax
      ports:
        f_init: [equilibrium_f_init, core_profiles_f_init]
        o_i: [equilibrium_o_i]
        o_f: [equilibrium_o_f, core_profiles_o_f]
    sink_nice:
      implementation: sink
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in, core_profiles_in]
    sink_torax:
      implementation: sink
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in, core_profiles_in]
    visualization_nice:
      implementation: visualization
      ports:
        s: [equilibrium_in, pf_active_in, wall_md_in, pf_active_md_in]
    visualization_torax:
      implementation: visualization
      ports:
        s: [equilibrium_in]
    validator:
      implementation: validator
      ports:
        f_init: [pf_active_in]
  conduits:
    source.core_profiles_out: sink_nice.core_profiles_in
    source.core_profiles_out: accumulator.core_profiles_in
    source.equilibrium_out: nice_inv.equilibrium_in
    source.pf_active_out: nice_inv.pf_active_in
    source.wall_out: nice_inv.wall_in
    source.pf_passive_out: nice_inv.pf_passive_in
    source.iron_core_out: nice_inv.iron_core_in
    source.wall_out: sink_nice.wall_in
    source.pf_passive_out: sink_nice.pf_passive_in
    source.iron_core_out: sink_nice.iron_core_in
    source.wall_out: acc2.wall_in
    source.pf_passive_out: acc2.pf_passive_in
    source.iron_core_out: acc2.iron_core_in
    source.pf_active_out: visualization_nice.pf_active_md_in
    source.wall_out: visualization_nice.wall_md_in
    nice_inv.equilibrium_out: sink_nice.equilibrium_in
    nice_inv.equilibrium_out: accumulator.equilibrium_in
    nice_inv.equilibrium_out: visualization_nice.equilibrium_in
    nice_inv.pf_active_out: sink_nice.pf_active_in
    nice_inv.pf_active_out: acc2.pf_active_in
    nice_inv.pf_active_out: visualization_nice.pf_active_in
    nice_inv.pf_active_out: validator.pf_active_in
    accumulator.equilibrium_out: torax.equilibrium_f_init
    accumulator.core_profiles_out: torax.core_profiles_f_init
    torax.equilibrium_o_i: visualization_torax.equilibrium_in
    torax.equilibrium_o_f: acc2.equilibrium_in
    torax.core_profiles_o_f: acc2.core_profiles_in
    acc2.equilibrium_out: sink_torax.equilibrium_in
    acc2.pf_active_out: sink_torax.pf_active_in
    acc2.pf_passive_out: sink_torax.pf_passive_in
    acc2.iron_core_out: sink_torax.iron_core_in
    acc2.wall_out: sink_torax.wall_in
    acc2.core_profiles_out: sink_torax.core_profiles_in

settings:
  source.source_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_in/"
  sink_nice.sink_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_out_nice"
  sink_torax.sink_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_out_torax"
  sink_nice.sink_mode: "w"
  sink_torax.sink_mode: "w"
  torax.output_all_timeslices: True
  nice_inv.xml_path: [SUBDIR_PLACEHOLDER]/config_nice.xml
  python_config_module: [SUBDIR_PLACEHOLDER]/config_torax.py
  visualization_nice.plot_file_path: [BASEDIR_PLACEHOLDER]/run/IMAS-MUSCLE3/imas_muscle3/visualization/examples/pds/pds.py
  visualization_nice.throttle_interval: 0.4
  visualization_nice.keep_alive: false
  visualization_torax.plot_file_path: [BASEDIR_PLACEHOLDER]/run/IMAS-MUSCLE3/imas_muscle3/visualization/examples/simple_1d_plot/simple_1d_plot.py
  visualization_torax.throttle_interval: 0.4
  visualization_torax.keep_alive: false
  validator.halt_on_error: True
  validator.extra_rule_dirs: [BASEDIR_PLACEHOLDER]/pds_validation_tests/
  validator.rulesets: iter-olc
  validator.apply_generic: False
  muscle_remote_log_level: 'DEBUG'
implementations:
  source:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-MUSCLE3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  sink:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-MUSCLE3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  accumulator:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-MUSCLE3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.accumulator_component"
  nice_inv:
    env: 
      IMAS_AL_DISABLE_VALIDATE: 1
    modules: SuiteSparse/7.7.0-intel-2023b libxml2
    executable: [BASEDIR_PLACEHOLDER]/run/nice/run/nice_imas_inv_muscle3
  torax:
    script: |
      #!/bin/bash
      module purge
      module load Python
      source [BASEDIR_PLACEHOLDER]/run/TORAX-MUSCLE3/venv/bin/activate
      export IMAS_VERSION="4.0.0"
      export JAX_COMPILATION_CACHE_DIR="[BASEDIR_PLACEHOLDER]/run/tmp/jax_cache"
      python -u -m torax_muscle3.torax_actor
  visualization:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-MUSCLE3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.visualization_component"
  validator:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-MUSCLE3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.olc_component"
resources:
  source:
    threads: 1
  sink_nice:
    threads: 1
  sink_torax:
    threads: 1
  accumulator:
    threads: 1
  acc2:
    threads: 1
  torax:
    threads: 1
  nice_inv:
    threads: 8
  visualization_nice:
    threads: 1
  visualization_torax:
    threads: 1
  validator:
    threads: 1
