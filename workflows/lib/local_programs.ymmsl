ymmsl_version: v0.2

# Local-installation program (implementation) definitions
# Import into a workflow with e.g.:
#   imports:
#   - from lib.local_programs import implementation torax
# and run with YMMSL_PATH pointing at the workflows/ directory (bin/pds-run does this).

# Actor codes come from the custom modules built by setup_files/custom_modules/build_*.sh
# (see setup_files/PDS.lua for why the official SDCC modules don't work for these).
#
# Every actor below declares `base_env: clean` plus its own `modules:`, so MUSCLE3 loads a
# fresh environment in that actor's own subprocess regardless of what the manager's shell
# or any other actor loaded -- deliberate, so no actor silently depends on PDS.lua's own
# eager load of PDS-IMAS-MUSCLE3.
#
programs:
  source:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.source_component

  sink:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.sink_component

  sink_source:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.sink_source_component

  validator:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.olc_component

  recorder:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.recorder_component

  accumulator:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.accumulator_component

  visualization:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.visualization_component

  waveform_editor:
    base_env: clean
    modules: PDS-Waveform-Editor
    virtual_env: $EBROOTWAVEFORMEDITOR/venv
    executable: waveform-editor
    args: actor

  nice_inv:
    base_env: clean
    modules: PDS-NICE
    env:
      IMAS_AL_DISABLE_VALIDATE: 1
      IMAS_VERSION: "4.0.0"
      OMP_NUM_THREADS: 2
    executable: $EBROOTNICE/run/nice_imas_inv_muscle3

  nice_dir:
    base_env: clean
    modules: PDS-NICE
    env:
      IMAS_AL_DISABLE_VALIDATE: 1
      IMAS_VERSION: "4.0.0"
      OMP_NUM_THREADS: 2
    executable: $EBROOTNICE/run/nice_imas_dir_muscle3

  torax:
    base_env: clean
    modules: PDS-TORAX-MUSCLE3
    virtual_env: $EBROOTTORAXMUSCLE3/venv
    env:
      IMAS_VERSION: "4.0.0"
      # $PDS_REPO is resolved by bin/pds-run's own envsubst pass over this
      # file before MUSCLE3 parses it, not by MUSCLE3's own env: handling.
      JAX_COMPILATION_CACHE_DIR: $PDS_REPO/tmp/jax_cache
      JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS: 0
    executable: python
    args: -u -m torax_muscle3.torax_actor

  # inverse_convergence specific:
  loop:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/inverse_convergence/outer_convergence_loop.py

  load_balancer:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/inverse_convergence/nice_load_balancer.py
