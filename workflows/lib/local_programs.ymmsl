ymmsl_version: v0.2

# Local-installation program (implementation) definitions
# Import into a workflow with e.g.:
#   imports:
#   - from lib.local_programs import implementation torax
# and run with YMMSL_PATH pointing at the workflows/ directory (bin/pds-run does this).

# Actor codes come from the custom modules built by
# setup_files/custom_modules/build_*.sh (see setup_files/PDS.lua for why:
# RPATH/PYTHONPATH conflicts rule out the official SDCC modules for these).
# `module load PDS` sets $EBROOTNICE / $EBROOTIMASMUSCLE3 /
# $EBROOTWAVEFORMEDITOR / $EBROOTTORAXMUSCLE3 to each one's install prefix.

programs:
  source:      {virtual_env: $EBROOTIMASMUSCLE3/venv, executable: python, args: -u -m imas_muscle3.actors.source_component}
  sink:        {virtual_env: $EBROOTIMASMUSCLE3/venv, executable: python, args: -u -m imas_muscle3.actors.sink_component}
  sink_source: {virtual_env: $EBROOTIMASMUSCLE3/venv, executable: python, args: -u -m imas_muscle3.actors.sink_source_component}
  validator:   {virtual_env: $EBROOTIMASMUSCLE3/venv, executable: python, args: -u -m imas_muscle3.actors.olc_component}
  recorder:    {virtual_env: $EBROOTIMASMUSCLE3/venv, executable: python, args: -u -m imas_muscle3.actors.recorder_component}
  waveform_editor: {virtual_env: $EBROOTWAVEFORMEDITOR/venv, executable: waveform-editor, args: actor}

  nice_inv:
    script: |
      #!/bin/bash
      export IMAS_AL_DISABLE_VALIDATE=1 IMAS_VERSION=4.0.0 OMP_NUM_THREADS=2
      exec $EBROOTNICE/run/nice_imas_inv_muscle3 "$@"

  torax:
    script: |
      #!/bin/bash
      export IMAS_VERSION=4.0.0 JAX_COMPILATION_CACHE_DIR=$PDS_REPO/tmp/jax_cache JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=0
      exec $EBROOTTORAXMUSCLE3/venv/bin/python -u -m torax_muscle3.torax_actor "$@"

  # inverse_convergence specific:
  loop:        {virtual_env: $EBROOTIMASMUSCLE3/venv, executable: python, args: -u $PDS_REPO/workflows/inverse_convergence/outer_convergence_loop.py}
  load_balancer: {virtual_env: $EBROOTIMASMUSCLE3/venv, executable: python, args: -u $PDS_REPO/workflows/inverse_convergence/nice_load_balancer.py}