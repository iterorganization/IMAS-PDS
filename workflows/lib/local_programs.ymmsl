ymmsl_version: v0.2

# Local-installation program (implementation) definitions.
# Import into a workflow with e.g.:
#   imports:
#   - from lib.local_programs import implementation torax
# and run with YMMSL_PATH pointing at the workflows/ directory (bin/pds-run does this).
#
# Workflows normally get the imas_muscle3-shipped actors (source_component,
# sink_component, recorder_component, etc.) via `from imas_muscle3 import implementation
# X`, which resolves straight from the installed imas_muscle3 package -- this repo's own
# $PDS_REPO/run/IMAS-MUSCLE3/venv counts as an install. The definitions below are kept as
# a `from lib.local_programs import implementation X` fallback for pointing a workflow at
# this repo's local venv explicitly, e.g. to pick up an editable-installed checkout ahead
# of whatever imas_muscle3 install would otherwise resolve. See lib/easybuild_programs.ymmsl
# for the EasyBuild-module-based form of everything below.

programs:
  # Every program below is `script:`, not the declarative virtual_env/executable/args
  # form, for two reasons that both rule out `base_env: clean`:
  #
  #  1. They need $PDS_REPO, which the PDS module sets -- `base_env: clean` runs `module
  #     purge` first, which would take it right back out. `virtual_env`/`executable`/
  #     `args` are plain text substituted into the generated script and expanded in the
  #     actor's OWN shell at run time (after any purge), not by the manager, so a purge
  #     leaves them with an empty $PDS_REPO prefix -- silently falling through to the
  #     system `python`/`PATH` instead of the intended venv: `python: can't open file
  #     '/workflows/...'`, `ModuleNotFoundError: No module named 'imas_muscle3'`, or
  #     `waveform-editor: not found`, depending on which reference broke.
  #  2. Without a purge, muscle_manager's own PYTHONPATH (inherited from the IMAS-MUSCLE3
  #     module: a Python-3.13 SciPy-bundle site-packages dir) leaks into the actor. `.
  #     venv/bin/activate` does not clear PYTHONPATH, so the module's numpy shadows the
  #     venv's own ABI-incompatible build unless it is unset first (same fix as `torax`
  #     below).
  source_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/run/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.source_component "$@"

  sink_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/run/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.sink_component "$@"

  sink_source_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/run/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.sink_source_component "$@"

  olc_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/run/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.olc_component "$@"

  recorder_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/run/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.recorder_component "$@"

  iterator_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/run/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.iterator_component "$@"

  passthrough_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/run/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.passthrough_component "$@"

  waveform_editor:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/run/Waveform-Editor/venv/bin/activate
      # Same as nice_inv/nice_evo_rd below: a multi-slice NICE-inverse equilibrium leaves
      # grids_ggd (not itself time-varying) at shape (1,) while the rest of the IDS has
      # one entry per slice, which IMAS's strict validator rejects as a coordinate
      # mismatch on write/convert -- confirmed live passing a 17-slice bootstrap solve
      # through evolutive_controller's waveform_editor.
      export IMAS_AL_DISABLE_VALIDATE=1
      exec waveform-editor actor "$@"

  temporal_coupler:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/run/IMAS-MUSCLE3/venv/bin/activate
      exec python -u $PDS_REPO/workflows/utils/temporal_coupler.py "$@"

  loop:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/run/IMAS-MUSCLE3/venv/bin/activate
      exec python -u $PDS_REPO/workflows/lib/actors/outer_convergence_loop.py "$@"

  load_balancer:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/run/IMAS-MUSCLE3/venv/bin/activate
      exec python -u $PDS_REPO/workflows/lib/actors/nice_load_balancer.py "$@"

  nice_inv:
    script: |
      #!/bin/bash
      source /etc/profile.d/modules.sh
      eval "$($LMOD_CMD bash load NICE/3.0.0-intel-2023b-DD-4.1.0)"
      export IMAS_AL_DISABLE_VALIDATE=1 IMAS_VERSION=4.0.0 OMP_NUM_THREADS=2
      exec $PDS_REPO/run/nice/run/nice_imas_inv_muscle3 "$@"

  nice_evo_rd:
    script: |
      #!/bin/bash
      source /usr/share/lmod/lmod/init/bash
      eval "$($LMOD_CMD bash load NICE/3.0.0-intel-2023b-DD-4.1.0 2>/dev/null)"
      export IMAS_AL_DISABLE_VALIDATE=1 IMAS_VERSION=4.0.0 OMP_NUM_THREADS=2
      exec $PDS_REPO/run/nice/run/nice_imas_evo_rd_muscle3 "$@"

  torax:
    script: |
      #!/bin/bash
      # unset PYTHONPATH: muscle_manager inherits it from the IMAS-MUSCLE3 module
      # (prepends a Python-3.13 SciPy-bundle site-packages dir), which shadows this
      # venv's own numpy build with an ABI-incompatible one for our Python 3.11.
      unset PYTHONPATH
      source $PDS_REPO/run/TORAX-MUSCLE3/venv/bin/activate
      export IMAS_VERSION=4.0.0 JAX_COMPILATION_CACHE_DIR=$PDS_REPO/run/tmp/jax_cache JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=0
      exec python -u -m torax_muscle3.torax_actor "$@"

  # METIS is always driven through MATLAB's pyenv()/py.* bridge and a module-installed
  # IMAS-AL-Matlab -- there is no repo-local build of it, so this is identical to
  # lib/easybuild_programs.ymmsl's `metis`.
  metis:
    script: |
      #!/bin/bash
      module purge
      module load METIS-IRFM/2026.08-pds IMAS-AL-Matlab/5.3.0-intel-2023b-DD-4.0.0
      # IMAS-AL-Matlab leaks its own numpy onto PYTHONPATH, conflicting with
      # $EBROOTMETIS/muscle3_venv's numpy.
      unset PYTHONPATH
      # $EBROOTMETIS/muscle3_venv is a dedicated Python 3.11 + muscle3==0.10.0
      # venv, matching both MATLAB's supported Python range and the real
      # manager's libmuscle version (see the METIS-IRFM easyconfig).
      exec matlab -batch "pyenv('Version','$EBROOTMETIS/muscle3_venv/bin/python','ExecutionMode','InProcess');addpath(getenv('DIR_METIS4MUSCLE3'));metis4muscle3(2);"

  # Explicitly pyenv() at the repo-local muscle3-0.10.0 venv python, NOT `which python`:
  # on this system that resolves to a stray user ~/.local muscle3-0.8.0 libmuscle install,
  # which is wire-incompatible with the 0.10.0 manager every other actor here uses --
  # produces a "socket closed while receiving" registration failure after MATLAB startup.
  # Unlike every other actor above, this one used to be the declarative env/modules/
  # executable/args form -- but env: values are set directly by the manager (not run
  # through a shell), so its $PDS_REPO never expanded: MATLAB's own getenv('PCS_PATH')
  # came back with the literal string "$PDS_REPO/run/pcs", addpath resolved that as a
  # relative path under the instance's workdir, and pcssp_pcs_add_paths (which that
  # addpath was supposed to put on the path) came back "unrecognized function or
  # variable". `export` lines in a script:, like every actor above, are expanded in the
  # actor's own shell instead, so $PDS_REPO resolves correctly.
  magnetic_controller:
    script: |
      #!/bin/bash
      module load IMAS-AL-Matlab/5.3.0-intel-2023b-DD-4.0.0
      module load MATLAB/2025b-r1-GCCcore-13.2.0
      export PCS_PATH=$PDS_REPO/run/pcs
      export CONTROLLER_PATH=$PDS_REPO/controllers/KCURR_RZIp
      export SCDDS_COREPATH=$PDS_REPO/run/pcs/pcssp/scdds
      # run() the controller by full path, not by name: NICE's own
      # runmatlab/muscle3/matlab_iter/ (added to the path by initNice4matlab.m
      # below) ships its own, much older, different-port-signature
      # muscle_controller_NICE_IMAS_iter_init.m, which shadows CONTROLLER_PATH's
      # despite being added to the path first -- confirmed on every NICE
      # install, local and EasyBuild alike, and not fixable by removing that
      # directory from the path (it also holds the Simulink .slx models the
      # real controller loads by name).
      # try/catch + exit(1): a bare error inside -batch (especially one thrown from deep
      # inside the py.* bridge, e.g. libmuscle's Instance() registration) can otherwise
      # surface as a silent `exit code 0, never registered` with zero output -- indistinguishable
      # from the script just not running. getReport() forces the real stack trace into
      # stdout/stderr and exit(1) makes muscle3 report it as an actual crash instead.
      #
      # The whole try/catch/end MUST be one physical line: -batch feeds its argument to
      # the parser more like sequential REPL input than a script file, so a newline
      # anywhere between `try` and `end` fails immediately with "This statement is
      # incomplete" (confirmed live) -- unlike the plain semicolon-separated statements
      # above, which parse fine across multiple lines.
      exec matlab -batch "try; pyenv('Version','$PDS_REPO/run/IMAS-MUSCLE3/venv/bin/python','ExecutionMode','InProcess'); addpath(getenv('PCS_PATH')); run('$PDS_REPO/run/nice/runmatlab/initNice4matlab.m'); pcssp_pcs_add_paths; comparisons.ExternalSCMLink.setupGitConfig(); addpath(getenv('CONTROLLER_PATH')); run(fullfile(getenv('CONTROLLER_PATH'),'muscle_controller_NICE_IMAS_iter_init.m')); catch ME; disp(getReport(ME)); exit(1); end"
