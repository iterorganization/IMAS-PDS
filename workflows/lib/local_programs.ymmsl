ymmsl_version: v0.2

# Local-installation program (implementation) definitions.
# Import into a workflow with e.g.:
#   imports:
#   - from lib.local_programs import implementation torax
# and run with YMMSL_PATH pointing at the workflows/ directory (bin/pds-run does this).
#
# Workflows normally get the imas_muscle3-shipped actors (source_component,
# sink_component, recorder_component, etc.) via `from imas_muscle3 import implementation
# X`, which resolves straight from the installed imas_muscle3 package -- this repo's own
# $PDS_REPO/local_installs/IMAS-MUSCLE3/venv counts as an install. The definitions below are kept as
# a `from lib.local_programs import implementation X` fallback for pointing a workflow at
# this repo's local venv explicitly, e.g. to pick up an editable-installed checkout ahead
# of whatever imas_muscle3 install would otherwise resolve. See lib/easybuild_programs.ymmsl
# for the EasyBuild-module-based form of everything below.

programs:
  # Every program below is `script:`, not the declarative virtual_env/executable/args
  # form, for two reasons that both rule out `base_env: clean`:
  #
  #  1. They need $PDS_REPO, which the PDS module sets -- `base_env: clean` runs `module
  #     purge` first, which would take it right back out. `virtual_env`/`executable`/
  #     `args` are plain text substituted into the generated script and expanded in the
  #     actor's OWN shell at run time (after any purge), not by the manager, so a purge
  #     leaves them with an empty $PDS_REPO prefix -- silently falling through to the
  #     system `python`/`PATH` instead of the intended venv: `python: can't open file
  #     '/workflows/...'`, `ModuleNotFoundError: No module named 'imas_muscle3'`, or
  #     `waveform-editor: not found`, depending on which reference broke.
  #  2. Without a purge, muscle_manager's own PYTHONPATH (inherited from the IMAS-MUSCLE3
  #     module: a Python-3.13 SciPy-bundle site-packages dir) leaks into the actor. `.
  #     venv/bin/activate` does not clear PYTHONPATH, so the module's numpy shadows the
  #     venv's own ABI-incompatible build unless it is unset first (same fix as `torax`
  #     below).
  source_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/local_installs/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.source_component "$@"

  sink_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/local_installs/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.sink_component "$@"

  sink_source_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/local_installs/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.sink_source_component "$@"

  olc_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/local_installs/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.olc_component "$@"

  recorder_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/local_installs/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.recorder_component "$@"

  iterator_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/local_installs/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.iterator_component "$@"

  passthrough_component:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/local_installs/IMAS-MUSCLE3/venv/bin/activate
      exec python -u -m imas_muscle3.actors.passthrough_component "$@"

  waveform_editor:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/local_installs/Waveform-Editor/venv/bin/activate
      # Same as nice_inv/nice_evo_rd below: a multi-slice NICE-inverse equilibrium leaves
      # grids_ggd (not itself time-varying) at shape (1,) while the rest of the IDS has
      # one entry per slice, which IMAS's strict validator rejects as a coordinate
      # mismatch on write/convert -- confirmed live passing a 17-slice bootstrap solve
      # through evolutive_controller's waveform_editor.
      export IMAS_AL_DISABLE_VALIDATE=1
      exec waveform-editor actor "$@"

  temporal_coupler:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/local_installs/IMAS-MUSCLE3/venv/bin/activate
      exec python -u $PDS_REPO/workflows/utils/temporal_coupler.py "$@"

  loop:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/local_installs/IMAS-MUSCLE3/venv/bin/activate
      exec python -u $PDS_REPO/workflows/lib/actors/outer_convergence_loop.py "$@"

  load_balancer:
    script: |
      #!/bin/bash
      unset PYTHONPATH
      source $PDS_REPO/local_installs/IMAS-MUSCLE3/venv/bin/activate
      exec python -u $PDS_REPO/workflows/lib/actors/nice_load_balancer.py "$@"

  nice_inv:
    script: |
      #!/bin/bash
      source /etc/profile.d/modules.sh
      eval "$($LMOD_CMD bash load NICE/3.0.0-intel-2023b-DD-4.1.0)"
      export IMAS_AL_DISABLE_VALIDATE=1 IMAS_VERSION=4.0.0 OMP_NUM_THREADS=2
      exec $PDS_REPO/local_installs/nice/run/nice_imas_inv_muscle3 "$@"

  nice_dir:
    script: |
      #!/bin/bash
      source /etc/profile.d/modules.sh
      eval "$($LMOD_CMD bash load NICE/3.0.0-intel-2023b-DD-4.1.0)"
      export IMAS_AL_DISABLE_VALIDATE=1 IMAS_VERSION=4.0.0 OMP_NUM_THREADS=2
      exec $PDS_REPO/local_installs/nice/run/nice_imas_dir_muscle3 "$@"

  nice_evo_rd:
    script: |
      #!/bin/bash
      source /usr/share/lmod/lmod/init/bash
      eval "$($LMOD_CMD bash load NICE/3.0.0-intel-2023b-DD-4.1.0 2>/dev/null)"
      export IMAS_AL_DISABLE_VALIDATE=1 IMAS_VERSION=4.0.0 OMP_NUM_THREADS=2
      exec $PDS_REPO/local_installs/nice/run/nice_imas_evo_rd_muscle3 "$@"

  nice_evo:
    script: |
      #!/bin/bash
      source /usr/share/lmod/lmod/init/bash
      eval "$($LMOD_CMD bash load NICE/3.0.0-intel-2023b-DD-4.1.0 2>/dev/null)"
      export IMAS_AL_DISABLE_VALIDATE=1 IMAS_VERSION=4.0.0 OMP_NUM_THREADS=2
      exec $PDS_REPO/local_installs/nice/run/nice_imas_evo_muscle3 "$@"

  torax:
    script: |
      #!/bin/bash
      # unset PYTHONPATH: muscle_manager inherits it from the IMAS-MUSCLE3 module
      # (prepends a Python-3.13 SciPy-bundle site-packages dir), which shadows this
      # venv's own numpy build with an ABI-incompatible one for our Python 3.11.
      unset PYTHONPATH
      source $PDS_REPO/local_installs/TORAX-MUSCLE3/venv/bin/activate
      export IMAS_VERSION=4.0.0 JAX_COMPILATION_CACHE_DIR=$PDS_REPO/local_installs/tmp/jax_cache JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=0
      exec python -u -m torax_muscle3.torax_actor "$@"

  # CHEASE: the iWrap MUSCLE3-Fortran actor built by setup_files/setup_chease.sh in
  # local_installs/chease/chease_m3 (it reads its code parameters from ../input/ next to
  # its bin/, with COCOS 17 set by that script). Its runtime libraries (IMAS AL, XMLlib,
  # INTERPOS, libmuscle_fortran, Intel runtime) come from the same modules it was built
  # against, so the build's own environment file is sourced instead of repeating that
  # module list here. That file starts with `module purge`, which unloads the PDS module
  # and with it $PDS_REPO, hence the copy first.
  chease:
    script: |
      #!/bin/bash
      pds_repo="$PDS_REPO"
      source /etc/profile.d/modules.sh
      source "$pds_repo/local_installs/chease/python/config_muscle3.sh"
      exec "$pds_repo/local_installs/chease/chease_m3/bin/chease.exe" "$@"

  # METIS is driven through MATLAB's pyenv()/py.* bridge and a module-installed
  # IMAS-AL-Matlab. The METIS code itself comes from the local_installs/metis checkout
  # made by setup_files/setup_metis.sh: metis4muscle3.m adds the METIS root (four levels
  # above its own directory) and runs zineb_path itself, so only its mfile directory is
  # put on the path here. The METIS-IRFM module is still loaded, but only for MATLAB and
  # its muscle3==0.10.0 Python venv (a local METIS checkout has no venv of its own); its
  # METIS code (DIR_METIS4MUSCLE3) is not used.
  metis:
    script: |
      #!/bin/bash
      # Saved before `module purge`, which unloads the PDS module and with it $PDS_REPO.
      pds_repo="$PDS_REPO"
      module purge
      module load METIS-IRFM/2026.08-pds IMAS-AL-Matlab/5.3.0-intel-2023b-DD-4.0.0
      # IMAS-AL-Matlab leaks its own numpy onto PYTHONPATH, conflicting with
      # $EBROOTMETIS/muscle3_venv's numpy.
      unset PYTHONPATH
      # $EBROOTMETIS/muscle3_venv is a dedicated Python 3.11 + muscle3==0.10.0
      # venv, matching both MATLAB's supported Python range and the real
      # manager's libmuscle version (see the METIS-IRFM easyconfig).
      exec matlab -batch "pyenv('Version','$EBROOTMETIS/muscle3_venv/bin/python','ExecutionMode','InProcess');addpath('$pds_repo/local_installs/metis/workflow/muscle3/mfile');metis4muscle3(2);"

  # Local PCS code only; NICE MATLAB tools, MUSCLE3 Python and the MATLAB IMAS module
  # come from the modules below, same as easybuild_programs.ymmsl's magnetic_controller
  # (USE_LOCAL_PCS needs only local_installs/pcs).
  magnetic_controller:
    script: |
      #!/bin/bash
      # Captured before `module purge` below: the PDS module sets PDS_REPO via
      # lmod's setenv(), which `module purge` unconditionally reverts -- even
      # though the manager also plain-exports PDS_REPO into this shell, purge
      # wipes it anyway (confirmed live, see the EasyBuild entry). Saved once as
      # pds_repo and reused below for controller_path and the local PCS/PCSSP
      # paths that replace the module's own.
      pds_repo="$PDS_REPO"
      controller_path="$pds_repo/controllers/KCURR_RZIp"
      module purge
      module load PCS/2026.08-pds NICE/3.0.0.dev446-intel-2025b-pds
      # IMAS-MATLAB, not the older IMAS-AL-Matlab: that one only exists built
      # against intel-2023b, so loading it here silently downgrades this
      # whole shell's toolchain out from under NICE's own intel-2025b build
      # (Boost, HDF5, GCCcore, ~40 packages -- confirmed live) rather than
      # just switching MATLAB versions. IMAS-MATLAB/*-intel-2025b-DD-4.1.1
      # matches NICE/IMAS-Core's own toolchain and DD version, so no
      # toolchain-wide reload happens -- only MATLAB itself still reloads
      # 2023b-r5 (PCS's pinned version) -> 2025b-r1, since PCS hasn't been
      # rebuilt against 2025b-r1 yet.
      module load IMAS-MATLAB/5.6.0-intel-2025b-DD-4.1.1
      # IMAS-MATLAB leaks its own numpy onto PYTHONPATH, conflicting with
      # $EBROOTPCS/muscle3_venv's numpy (same reason as the metis actor).
      unset PYTHONPATH
      # The PCS module exports EBROOTPCS and SCDDS_COREPATH (under $EBROOTPCS), but no
      # PCS_PATH -- same as in the EasyBuild entry. Here both PCS_PATH and
      # SCDDS_COREPATH are overridden to this repo's own local_installs/pcs checkout,
      # so no PCS/PCSSP code is read from $EBROOTPCS; only $EBROOTPCS/muscle3_venv's
      # Python is used below (pyenv), same as the EasyBuild entry.
      export PCS_PATH="$pds_repo/local_installs/pcs"
      export SCDDS_COREPATH="$pds_repo/local_installs/pcs/pcssp/scdds"
      export CONTROLLER_PATH="$controller_path"
      # NICE's own runmatlab/muscle3/matlab_iter/ (added to the path by
      # initNice4matlab.m below) ships its own, much older,
      # different-port-signature muscle_controller_NICE_IMAS_iter_init.m, which
      # shadows CONTROLLER_PATH's despite being added to the path first --
      # confirmed on every NICE install, local and EasyBuild alike, and not
      # something we can fix by removing that directory from the path (it also
      # holds the Simulink .slx models the real controller loads by name). So
      # `run()` it by full path instead of relying on name resolution to find
      # the right one.
      exec matlab -batch "pyenv('Version','$EBROOTPCS/muscle3_venv/bin/python','ExecutionMode','InProcess');addpath(getenv('PCS_PATH'));run('$EBROOTNICE/runmatlab/initNice4matlab.m');pcssp_pcs_add_paths;comparisons.ExternalSCMLink.setupGitConfig();addpath(getenv('CONTROLLER_PATH'));run(fullfile(getenv('CONTROLLER_PATH'),'muscle_controller_NICE_IMAS_iter_init.m'));"
