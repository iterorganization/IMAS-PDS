ymmsl_version: v0.2

# Local-installation program (implementation) definitions
# Import into a workflow with e.g.:
#   imports:
#   - from lib.local_programs import implementation torax
# and run with YMMSL_PATH pointing at the workflows/ directory (bin/pds-run does this).

# Actor codes come from the custom modules built by setup_files/custom_modules/build_*.sh
# (see setup_files/PDS.lua for why the official SDCC modules don't work for these).
#
# Every actor below declares `base_env: clean` plus its own `modules:`, so MUSCLE3 loads a
# fresh environment in that actor's own subprocess regardless of what the manager's shell
# or any other actor loaded -- deliberate, so no actor silently depends on PDS.lua's own
# eager load of PDS-IMAS-MUSCLE3.
#
programs:
  source:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.source_component

  sink:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.sink_component

  sink_source:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.sink_source_component

  validator:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.olc_component

  recorder:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.recorder_component

  accumulator:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.accumulator_component

  visualization:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.visualization_component

  waveform_editor:
    base_env: clean
    modules: PDS-Waveform-Editor
    virtual_env: $EBROOTWAVEFORMEDITOR/venv
    executable: waveform-editor
    args: actor

  iterator:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.iterator_component

  passthrough:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.passthrough_component

  # NOTE: origin/master's own new entry for this pointed at
  # workflows/utils/temporal_coupler.py, which doesn't exist -- the real
  # file lives at workflows/torax_nice_utils/temporal_coupler.py (unchanged
  # on both branches), used below instead.
  temporal_coupler:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/torax_nice_utils/temporal_coupler.py

  metis:
    script: |
      #!/bin/bash
      module purge
      module load PDS-METIS IMAS-AL-Matlab/5.3.0-intel-2023b-DD-4.0.0
      # IMAS-AL-Matlab leaks its own numpy onto PYTHONPATH, conflicting with
      # $EBROOTMETIS/muscle3_venv's numpy.
      unset PYTHONPATH
      # $EBROOTMETIS/muscle3_venv is a dedicated Python 3.11 + muscle3==0.10.0
      # venv, matching both MATLAB's supported Python range and the real
      # manager's libmuscle version (see build_metis.sh).
      exec matlab -batch "pyenv('Version','$EBROOTMETIS/muscle3_venv/bin/python','ExecutionMode','InProcess');addpath(getenv('DIR_METIS4MUSCLE3'));metis4muscle3(2);"

  nice_inv:
    base_env: clean
    modules: PDS-NICE
    env:
      IMAS_AL_DISABLE_VALIDATE: 1
      IMAS_VERSION: "4.0.0"
      OMP_NUM_THREADS: 2
    executable: $EBROOTNICE/run/nice_imas_inv_muscle3

  nice_dir:
    base_env: clean
    modules: PDS-NICE
    env:
      IMAS_AL_DISABLE_VALIDATE: 1
      IMAS_VERSION: "4.0.0"
      OMP_NUM_THREADS: 2
    executable: $EBROOTNICE/run/nice_imas_dir_muscle3

  nice_evo_rd:
    script: |
      #!/bin/bash
      source /usr/share/lmod/lmod/init/bash
      eval "$($LMOD_CMD bash load NICE/3.0.0-intel-2023b-DD-4.1.0 2>/dev/null)"
      export IMAS_AL_DISABLE_VALIDATE=1 IMAS_VERSION=4.0.0 OMP_NUM_THREADS=2
      exec $PDS_REPO/run/nice/run/nice_imas_evo_rd_muscle3 "$@"

  torax:
    base_env: clean
    modules: PDS-TORAX-MUSCLE3
    virtual_env: $EBROOTTORAXMUSCLE3/venv
    env:
      IMAS_VERSION: "4.0.0"
      # $PDS_REPO is resolved by bin/pds-run's own envsubst pass over this
      # file before MUSCLE3 parses it, not by MUSCLE3's own env: handling.
      JAX_COMPILATION_CACHE_DIR: $PDS_REPO/tmp/jax_cache
      JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS: 0
    executable: python
    args: -u -m torax_muscle3.torax_actor

  # inverse_convergence specific:
  loop:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/inverse_convergence/outer_convergence_loop.py

  load_balancer:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/inverse_convergence/nice_load_balancer.py
