ymmsl_version: v0.2

# Local-installation program (implementation) definitions
# Import into a workflow with e.g.:
#   imports:
#   - from lib.local_programs import implementation torax
# and run with YMMSL_PATH pointing at the workflows/ directory (bin/pds-run does this).

# Actor codes come from the custom modules built by setup_files/custom_modules/build_*.sh
# (see setup_files/PDS.lua for why: RPATH/PYTHONPATH conflicts rule out the official SDCC
# modules for these).
#
# Every actor below declares `base_env: clean` plus its own `modules:` -- MUSCLE3 does a
# fresh `module purge` + `module load <modules>` in that actor's own subprocess before
# activating its venv, from a clean slate, regardless of what `module load PDS` did (or
# didn't) load in the manager's shell, and regardless of what any other actor in this same
# run needs. This is deliberate, not redundant with PDS.lua eagerly loading
# PDS-IMAS-MUSCLE3 for muscle_manager/m3dash access: no actor should silently depend on
# that eager load, so it stays fully self-contained even if that changes later.
#
programs:
  source:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.source_component

  sink:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.sink_component

  sink_source:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.sink_source_component

  validator:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.olc_component

  recorder:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.recorder_component

  waveform_editor:
    base_env: clean
    modules: PDS-Waveform-Editor
    virtual_env: $EBROOTWAVEFORMEDITOR/venv
    executable: waveform-editor
    args: actor

  nice_inv:
    base_env: clean
    modules: PDS-NICE
    env:
      IMAS_AL_DISABLE_VALIDATE: 1
      IMAS_VERSION: "4.0.0"
      OMP_NUM_THREADS: 2
    executable: $EBROOTNICE/run/nice_imas_inv_muscle3

  torax:
    base_env: clean
    modules: PDS-TORAX-MUSCLE3
    virtual_env: $EBROOTTORAXMUSCLE3/venv
    env:
      IMAS_VERSION: "4.0.0"
      JAX_COMPILATION_CACHE_DIR: $PDS_REPO/tmp/jax_cache
      JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS: 0
    executable: python
    args: -u -m torax_muscle3.torax_actor

  # inverse_convergence specific:
  loop:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/inverse_convergence/outer_convergence_loop.py

  load_balancer:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/inverse_convergence/nice_load_balancer.py
