ymmsl_version: v0.2

# Submodel: METIS as a filler for lib/design's `transport` hole.
#
# The hole's contract is TORAX's signature:
#   f_init: [equilibrium_in_f, core_profiles_in_f, core_sources_in_f]
#   o_f:    [equilibrium_out_f, core_profiles_out_f]
#
# METIS declares all five of those names with matching operators -- metis4muscle3_port_list.m
# defines one fixed superset and notes "ports is only used if they are connected !" -- so no
# renaming is needed. The time semantics differ though, which is why a driver sits between
# the hole and METIS rather than the two being wired straight together. From the sources:
#
#   equilibrium_in_f    update_metis_input_on_equilibrium.m loops every received slice and
#                       interpolates to METIS's current time -- a whole trace works here.
#   core_profiles_in_f  make_external_data.m takes profiles_1d{end}, only the LAST slice,
#   core_sources_in_f   then accumulates across reuse iterations. A whole trace is
#                       silently truncated.
#   *_out_f             get_ids_time_slice.m emits ids_get_slice(..., t_cur, 2): ONE slice
#                       per reuse iteration, never a whole trace.
#
# lib/actors/metis_driver.py absorbs that difference, so lib/design keeps TORAX's shape and
# never learns METIS is different. METIS runs one reuse iteration per slice, in time order,
# because it carries state between calls -- see the actor's docstring.
#
# BLOCKED ON THE ENVIRONMENT, not on anything in this repo.
#
# METIS starts, picks up the ports and enters its time loop, then dies in
# metis4muscle3_read.m:71 on `Unrecognized function or variable 'imas_deserialize'`. That
# function is the IMAS Access Layer MATLAB HLI (module IMAS-AL-Matlab), which METIS does
# not ship and which has NO build for the intel-2025b toolchain this stack uses -- the
# newest is intel-2023b. Its imas_deserialize.mexa64 loads under 2025b but then wants
# libal-mex.so and libboost_filesystem 1.83, and `module load IMAS-AL-Matlab` will not
# complete because it conflicts with Boost/1.88 + IMAS-Core/5.7.1 that NICE, TORAX,
# IMAS-Python and METIS-IRFM all need.
#
# So this needs an IMAS-AL-Matlab built for intel-2025b (or a METIS wrapper that
# deserializes through the Python bridge it already opens with pyenv). Everything on the
# PDS side is in place and verified as far as it can be without that.

imports:
- from lib.programs import implementation metis
- from lib.programs import implementation metis_driver

models:
  transport_metis:
    description: METIS filling the design transport hole, driven slice-by-slice
    ports:
      f_init: [equilibrium_in_f, core_profiles_in_f, core_sources_in_f]
      o_f: [equilibrium_out_f, core_profiles_out_f]
    components:
      driver:
        description: splits the traces, calls METIS per slice, reassembles
        implementation: metis_driver
        ports:
          f_init: [equilibrium_in, core_profiles_in, core_sources_in]
          o_i: [equilibrium_call, core_profiles_call, core_sources_call]
          s: [equilibrium_reply, core_profiles_reply]
          o_f: [equilibrium_out_f, core_profiles_out_f]
      metis:
        description: METIS transport actor -- one reuse iteration per time slice
        implementation: metis
        # Both the *_f_init and *_in_f sets, fed the same slice. In METIS's port list both
        # carry operator F_INIT -- `direction` (init vs input) is METIS's own bookkeeping,
        # not MUSCLE3's. It decides its running mode by looking for a CONNECTED port whose
        # name ends in `_f_init` carrying a timestamp (get_workflow_mode.m); with only the
        # _in_f set wired it finds none, concludes it is in replay mode, and exits looking
        # for a saved METIS data file. lib/metis_dina.ymmsl fans out the same way.
        ports:
          f_init: [equilibrium_f_init, core_profiles_f_init, core_sources_f_init,
                   equilibrium_in_f, core_profiles_in_f, core_sources_in_f]
          o_f: [equilibrium_out_f, core_profiles_out_f]
    conduits:
      # model input ports -> driver
      equilibrium_in_f: driver.equilibrium_in
      core_profiles_in_f: driver.core_profiles_in
      core_sources_in_f: driver.core_sources_in
      # driver -> METIS, one slice per call, to both port sets (see the note above)
      driver.equilibrium_call: [metis.equilibrium_f_init, metis.equilibrium_in_f]
      driver.core_profiles_call: [metis.core_profiles_f_init, metis.core_profiles_in_f]
      driver.core_sources_call: [metis.core_sources_f_init, metis.core_sources_in_f]
      # METIS -> driver, one slice per reply
      metis.equilibrium_out_f: driver.equilibrium_reply
      metis.core_profiles_out_f: driver.core_profiles_reply
      # driver -> model output ports
      driver.equilibrium_out_f: equilibrium_out_f
      driver.core_profiles_out_f: core_profiles_out_f
