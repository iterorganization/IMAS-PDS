ymmsl_version: v0.2

# Program (implementation) definitions for the PDS workflows.
#
# Import into a workflow or lib model with e.g.:
#   imports:
#   - from lib.programs import implementation torax
# and run the manager with YMMSL_PATH pointing at the workflows/ directory.
#
# Every actor declares the modules it needs, so MUSCLE3 loads them in the actor's own
# subprocess rather than relying on the manager's environment. Actors need incompatible
# toolchains (MATLAB dies part-way through if it inherits the stack `module load PDS`
# produces), so no $EBROOT* or toolchain here may come from what the manager was started
# with. Most also declare `base_env: clean`, purging first; the three PDS-owned actors at
# the bottom cannot, because a purge would take $PDS_REPO with it (see the note there).
#
# $MODULEPATH is inherited -- `module use` your module tree before starting the manager.
# Module names are unversioned on purpose: the PDS-* builds are per-user, so each tree
# resolves its own default instead of this file pinning one person's.
#
# Expansion rules:
#   * only `modules`, `virtual_env`, `executable`, `args` and `script` are shell-expanded,
#     and after the module loads, so $EBROOT* works in them;
#   * `env:` values are NOT expanded -- anything with an install path goes elsewhere;
#   * a `script:` is used verbatim, skipping the generated module loading, so it must
#     purge and load for itself.
#
# `ports:` are declared only where a program has one fixed signature, turning a wrong hole
# fill into a static error. Omitted for the generic IMAS-MUSCLE3 actors and
# `waveform_editor` (they adapt to whatever is connected) and for `torax` (two incompatible
# signatures, so declaring either breaks the other).

programs:
  # ----- Waveform-Editor ---------------------------------------------------------------
  waveform_editor:
    description: Waveform-Editor actor -- owns the scenario's waveforms and data pointers
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    base_env: clean
    modules: Waveform-Editor/0.3.2-intel-2025b-pds
    virtual_env: $EBROOTWAVEFORMEDITOR/venv
    executable: waveform-editor
    args: actor

  # ----- NICE free-boundary equilibrium binaries ---------------------------------------
  nice_inv:
    description: NICE inverse solve -- fits coil currents to a target boundary
    ports:
      f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
      o_f: [equilibrium_out, pf_active_out]
    env:
      HDF5_USE_FILE_LOCKING: "FALSE"
      IMAS_AL_DISABLE_VALIDATE: "1"
      IMAS_VERSION: "4.0.0"
    base_env: clean
    modules: NICE/3.0.0.dev258-intel-2025b-pds
    executable: $EBROOTNICE/run/nice_imas_inv_muscle3

  # ----- TORAX transport ----------------------------------------------------------------
  torax:
    base_env: clean
    modules: TORAX-MUSCLE3/0.1.3-intel-2025b-pds
    env:
      IMAS_VERSION: "4.0.0"
      JAX_COMPILATION_CACHE_DIR: $PDS_REPO/tmp/jax_cache
      JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS: 0
    executable: python
    args: -u -m torax_muscle3.torax_actor

  # ----- METIS transport (MATLAB) -------------------------------------------------------
  # No `ports:`: METIS declares one fixed superset and uses only the connected ones.
  #
  # metis4muscle3's first argument is `debug_level` (0 = none, 1 = logfile, 2 = + debugger
  # stop on error, 3 = + keyboard stop), not a coupling mode. Kept at 1: a logfile is worth
  # having while the coupling is still being shaken out, but 2's debugger-stop-on-error has
  # no interactive session to stop into under `matlab -batch`. Drop to 0 once it is stable.
  #
  # METIS has no MATLAB-native MUSCLE3 client: it drives libmuscle through MATLAB's
  # pyenv()/py.* bridge, which pins the Python twice over -- libmuscle must match the
  # manager exactly (0.10.0), and the version must be one the bridge supports (3.9-3.12,
  # so not PDS-IMAS-MUSCLE3's 3.13). $EBROOTMETIS/muscle3_venv (see build_metis.sh) is a
  # 3.11 venv satisfying both; anything `which python` returns will not.
  #
  # IMAS-AL-Matlab, not IMAS-MATLAB: it pulls in MATLAB/2023b-r5, whose bridge supports
  # 3.11, and supplies the imas_deserialize that METIS does not ship.
  #
  # Uses `script:` rather than `modules:` because pyenv inherits this environment even in
  # InProcess mode, so PYTHONPATH must be unset before MATLAB starts or it imports a
  # mismatched numpy under the venv's Python.
    metis:
    script: |
      #!/bin/bash
      module purge
      module load METIS-IRFM/2026.08-pds IMAS-AL-Matlab/5.3.0-intel-2023b-DD-4.0.0
      # IMAS-AL-Matlab leaks its own numpy onto PYTHONPATH, conflicting with
      # $EBROOTMETIS/muscle3_venv's numpy.
      unset PYTHONPATH
      # $EBROOTMETIS/muscle3_venv is a dedicated Python 3.11 + muscle3==0.10.0
      # venv, matching both MATLAB's supported Python range and the real
      # manager's libmuscle version (see the METIS-IRFM easyconfig).
      exec matlab -batch "pyenv('Version','$EBROOTMETIS/muscle3_venv/bin/python','ExecutionMode','InProcess');addpath(getenv('DIR_METIS4MUSCLE3'));metis4muscle3(2);"

  # ----- PDS-owned actors (run in the IMAS-MUSCLE3 venv -- all import imas) -------------
  # These three declare `modules:` but not `base_env: clean`, unlike every actor above.
  # `modules:` is what matters here: it sets $EBROOTIMASMUSCLE3 itself, so `virtual_env`
  # resolves whether or not the manager was started with the PDS stack loaded. A purge
  # would additionally unset $PDS_REPO -- PDS.lua sets it, so unloading PDS takes it with
  # it -- and `args` below needs it to find the actor source. $PDS_REPO is the one thing
  # these actors do inherit from the manager, deliberately: it names which checkout to run,
  # so it cannot come from a module.
  loop:
    description: outer convergence loop (SEL submodel)
    ports:
      f_init: [equilibrium_in_f, core_profiles_in_f]
      o_i: [equilibrium_out_i, core_profiles_out_i]
      s: [pf_active_in_s, equilibrium_in_s, core_profiles_in_s]
      o_f: [equilibrium_out_f, pf_active_out_f, core_profiles_out_f, equilibrium_target_out_f]
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    modules: IMAS-MUSCLE3/1.0.0-intel-2025b-pds
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/lib/actors/outer_convergence_loop.py

  metis_driver:
    description: drives METIS slice-by-slice behind a whole-trace interface
    ports:
      f_init: [equilibrium_in, core_profiles_in, core_sources_in, pulse_schedule_in]
      o_i: [equilibrium_call, core_profiles_call, core_sources_call, pulse_schedule_call]
      s: [equilibrium_reply, core_profiles_reply]
      o_f: [equilibrium_out_f, core_profiles_out_f]
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    modules: IMAS-MUSCLE3/1.0.0-intel-2025b-pds
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/lib/actors/metis_driver.py

  load_balancer:
    description: IMAS-aware NICE load balancer -- scatters slices over N workers
    ports:
      f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
      o_i: [equilibrium_scatter, wall_scatter, pf_active_scatter, pf_passive_scatter, iron_core_scatter]
      s: [equilibrium_gather, pf_active_gather]
      o_f: [equilibrium_out_f, pf_active_out_f]
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    modules: IMAS-MUSCLE3/1.0.0-intel-2025b-pds
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/lib/actors/nice_load_balancer.py

