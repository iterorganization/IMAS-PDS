ymmsl_version: v0.2

# Program (implementation) definitions for the PDS workflows.
#
# Import into a workflow or lib model with e.g.:
#   imports:
#   - from lib.programs import implementation torax
# and run the manager with YMMSL_PATH pointing at the workflows/ directory.
#
# `module load PDS` sets $EBROOTNICE, $EBROOTIMASMUSCLE3, $EBROOTWAVEFORMEDITOR and
# $EBROOTTORAXMUSCLE3 to each actor's install prefix, and $PDS_REPO to the checkout. The
# installs are built by setup_files/custom_modules/build_*.sh; setup_files/PDS.lua says why
# the official SDCC modules cannot be used.
#
# Only `modules`, `virtual_env`, `executable`, `args` and `script` are shell-expanded.
# `env:` values are NOT, so anything referencing an install path belongs in a `script:`
# block. HDF5_USE_FILE_LOCKING=FALSE is a literal, so `env:` is fine for it; it is set on
# every program that opens an IDS entry, because several actors read the same entry
# concurrently off a network filesystem.
#
# `ports:` are declared only on programs with ONE fixed signature, where they turn a wrong
# hole fill into a static error. Not declared on: the generic IMAS-MUSCLE3 actors and
# `waveform_editor`, which adapt to whatever is connected; and `torax`, which has two
# incompatible signatures (design co-sim vs time-stepping co-sim) and takes no mode
# argument, so declaring either would make the other a hard error.

programs:

  # ----- IMAS-MUSCLE3 python actors (all present on the `develop` branch that
  # setup_files/setup_imas_muscle3.sh installs by default) -----------------------------
  source:
    description: IMAS source actor -- reads an IDS entry onto O_I/O_F ports
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.source_component

  sink:
    description: IMAS sink actor -- writes received IDSs to an entry
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.sink_component

  sink_source:
    description: IMAS sink_source actor -- time-aligned re-emitter
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.sink_source_component

  recorder:
    description: IMAS recorder actor -- distill-format run recording
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.recorder_component

  validator:
    description: IMAS open-loop-check actor -- rule validation
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.olc_component

  accumulator:
    description: IMAS accumulator actor -- gathers timeslices into a full trace
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.accumulator_component

  visualization:
    description: IMAS visualization actor -- live plotting
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.visualization_component

  # ----- Waveform-Editor ---------------------------------------------------------------
  waveform_editor:
    description: Waveform-Editor actor -- owns the scenario's waveforms and data pointers
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTWAVEFORMEDITOR/venv
    executable: waveform-editor
    args: actor

  # ----- NICE free-boundary equilibrium binaries ---------------------------------------
  nice_inv:
    description: NICE inverse solve -- fits coil currents to a target boundary
    ports:
      f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
      o_f: [equilibrium_out, pf_active_out]
    script: |
      #!/bin/bash
      export HDF5_USE_FILE_LOCKING=FALSE IMAS_AL_DISABLE_VALIDATE=1 IMAS_VERSION=4.0.0 OMP_NUM_THREADS=2
      exec $EBROOTNICE/run/nice_imas_inv_muscle3 "$@"

  # ----- TORAX transport ----------------------------------------------------------------
  torax:
    description: TORAX transport actor -- fills the `transport` hole (no ports, see header)
    script: |
      #!/bin/bash
      export HDF5_USE_FILE_LOCKING=FALSE
      export IMAS_VERSION=4.0.0 JAX_COMPILATION_CACHE_DIR=$PDS_REPO/tmp/jax_cache JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=0
      exec $EBROOTTORAXMUSCLE3/venv/bin/python -u -m torax_muscle3.torax_actor "$@"

  # ----- METIS transport (MATLAB) -------------------------------------------------------
  # No `ports:`: metis4muscle3_port_list.m declares one fixed superset and notes "ports is
  # only used if they are connected !", so METIS adapts to what the workflow wires.
  #
  # metis4muscle3's first argument is `debug_level`, not a coupling mode:
  #   0 = none, 1 = Matlab logfile, 2 = +debugger stop on error, 3 = +keyboard stop.
  # 2 is kept for equivalence with the previous definition; production should use 0.
  #
  # DIR_METIS4MUSCLE3 comes from the PDS-METIS module; the fallback is the wrapper bundled
  # with the official METIS-IRFM module, which supplies MATLAB either way. Note the
  # variable is EBROOTMETISMINIRFM, not EBROOTMETISIRFM: EasyBuild rewrites the hyphen in
  # METIS-IRFM to MIN. Exported in the script rather than set via `env:`, which is not
  # expanded.
  metis:
    description: METIS transport actor (debug_level 2)
    script: |
      #!/bin/bash
      export DIR_METIS4MUSCLE3=${DIR_METIS4MUSCLE3:-$EBROOTMETISMINIRFM/workflow/muscle3/mfile}
      # Match the DD the IMAS-MATLAB module was built against: imas_serialize takes no
      # version argument, so it emits whatever its MEX was compiled for. A literal, not
      # ${VAR:-default} -- these scripts go through os.path.expandvars, which does not
      # understand :- defaults and silently collapses them to an empty string.
      export IMAS_VERSION=4.1.1
      exec matlab -batch "[s,t] = unix('which python'); \
                          pyenv('Version',strtrim(t),'ExecutionMode','InProcess'); \
                          addpath(getenv('DIR_METIS4MUSCLE3')); \
                          metis4muscle3(2);"

  # ----- PDS-owned actors (run in the IMAS-MUSCLE3 venv -- all import imas) -------------
  loop:
    description: outer convergence loop (SEL submodel)
    ports:
      f_init: [equilibrium_in_f, core_profiles_in_f]
      o_i: [equilibrium_out_i, core_profiles_out_i]
      s: [pf_active_in_s, equilibrium_in_s, core_profiles_in_s]
      o_f: [equilibrium_out_f, pf_active_out_f, core_profiles_out_f, equilibrium_target_out_f]
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/lib/actors/outer_convergence_loop.py

  metis_driver:
    description: drives METIS slice-by-slice behind a whole-trace interface
    ports:
      f_init: [equilibrium_in, core_profiles_in, core_sources_in, pulse_schedule_in]
      o_i: [equilibrium_call, core_profiles_call, core_sources_call, pulse_schedule_call]
      s: [equilibrium_reply, core_profiles_reply]
      o_f: [equilibrium_out_f, core_profiles_out_f]
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/lib/actors/metis_driver.py

  load_balancer:
    description: IMAS-aware NICE load balancer -- scatters slices over N workers
    ports:
      f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
      o_i: [equilibrium_scatter, wall_scatter, pf_active_scatter, pf_passive_scatter, iron_core_scatter]
      s: [equilibrium_gather, pf_active_gather]
      o_f: [equilibrium_out_f, pf_active_out_f]
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/lib/actors/nice_load_balancer.py

