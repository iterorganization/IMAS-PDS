ymmsl_version: v0.2

# Program (implementation) definitions for the PDS workflows.
#
# Import into a workflow or lib model with e.g.:
#   imports:
#   - from lib.programs import implementation torax
# and run the manager with YMMSL_PATH pointing at the workflows/ directory.
#
# Every actor declares `base_env: clean` plus the modules it needs, so MUSCLE3 purges the
# environment and loads only those in the actor's own subprocess. Actors are separate
# processes precisely so they can have incompatible toolchains: MATLAB, for one, is killed
# part-way through if it inherits the eleven-module stack that `module load PDS` produces,
# while `module purge && module load IMAS-MATLAB` runs it fine. Nothing here should depend
# on what the person who started the manager happened to have loaded.
#
# $MODULEPATH is inherited, so `module use` your custom module tree before starting the
# manager -- `module purge` does not clear it. Module names are deliberately unversioned:
# the PDS-* builds are per-user (one tree has PDS-IMAS-MUSCLE3/1.0.0-local, another
# 1.0.0-pds-2026-08-10), so each tree resolves its own default rather than this file
# pinning one person's.
#
# Only `modules`, `virtual_env`, `executable`, `args` and `script` are shell-expanded, and
# they are expanded AFTER the module loads, so $EBROOT* works in them. `env:` values are
# NOT expanded, so anything referencing an install path has to go elsewhere.
#
# A program that sets `script:` has it used verbatim -- native_instantiator.py:231 skips the
# generated module loading entirely -- so a script must purge and load for itself.
#
# `ports:` are declared only on programs with ONE fixed signature, where they turn a wrong
# hole fill into a static error. Not declared on: the generic IMAS-MUSCLE3 actors and
# `waveform_editor`, which adapt to whatever is connected; and `torax`, which has two
# incompatible signatures (design co-sim vs time-stepping co-sim) and takes no mode
# argument, so declaring either would make the other a hard error.

programs:

  # ----- IMAS-MUSCLE3 python actors (all present on the `develop` branch that
  # setup_files/setup_imas_muscle3.sh installs by default) -----------------------------
  source:
    description: IMAS source actor -- reads an IDS entry onto O_I/O_F ports
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.source_component

  sink:
    description: IMAS sink actor -- writes received IDSs to an entry
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.sink_component

  sink_source:
    description: IMAS sink_source actor -- time-aligned re-emitter
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.sink_source_component

  recorder:
    description: IMAS recorder actor -- distill-format run recording
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    base_env: clean
    # matplotlib too: this actor runs the plot config named by its `config` setting
    # (visualization/*.py), and those import pyplot.
    modules: [PDS-IMAS-MUSCLE3, matplotlib]
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.recorder_component

  validator:
    description: IMAS open-loop-check actor -- rule validation
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.olc_component

  accumulator:
    description: IMAS accumulator actor -- gathers timeslices into a full trace
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.accumulator_component

  visualization:
    description: IMAS visualization actor -- live plotting
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    base_env: clean
    # matplotlib too: this actor runs the plot config named by its `config` setting
    # (visualization/*.py), and those import pyplot.
    modules: [PDS-IMAS-MUSCLE3, matplotlib]
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u -m imas_muscle3.actors.visualization_component

  # ----- Waveform-Editor ---------------------------------------------------------------
  waveform_editor:
    description: Waveform-Editor actor -- owns the scenario's waveforms and data pointers
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    base_env: clean
    modules: PDS-Waveform-Editor
    virtual_env: $EBROOTWAVEFORMEDITOR/venv
    executable: waveform-editor
    args: actor

  # ----- NICE free-boundary equilibrium binaries ---------------------------------------
  nice_inv:
    description: NICE inverse solve -- fits coil currents to a target boundary
    ports:
      f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
      o_f: [equilibrium_out, pf_active_out]
    env:
      HDF5_USE_FILE_LOCKING: "FALSE"
      IMAS_AL_DISABLE_VALIDATE: "1"
      IMAS_VERSION: "4.0.0"
    base_env: clean
    modules: PDS-NICE
    executable: $EBROOTNICE/run/nice_imas_inv_muscle3

  # ----- TORAX transport ----------------------------------------------------------------
  torax:
    description: TORAX transport actor -- fills the `transport` hole (no ports, see header)
    # Stays a script: JAX_COMPILATION_CACHE_DIR needs $PDS_REPO expanded, and `env:` values
    # are not expanded. A script is used verbatim, so it purges and loads for itself.
    script: |
      #!/bin/bash
      source /etc/profile.d/lmod.sh 2>/dev/null
      module purge
      module use ${PDS_MODULEPATH:-$HOME/public/modules}
      module load PDS-TORAX-MUSCLE3
      export HDF5_USE_FILE_LOCKING=FALSE IMAS_VERSION=4.0.0
      export JAX_COMPILATION_CACHE_DIR=$PDS_REPO/tmp/jax_cache
      export JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=0
      exec $EBROOTTORAXMUSCLE3/venv/bin/python -u -m torax_muscle3.torax_actor "$@"

  # ----- METIS transport (MATLAB) -------------------------------------------------------
  # No `ports:`: metis4muscle3_port_list.m declares one fixed superset and notes "ports is
  # only used if they are connected !", so METIS adapts to what the workflow wires.
  #
  # metis4muscle3's first argument is `debug_level`, not a coupling mode:
  #   0 = none, 1 = Matlab logfile, 2 = +debugger stop on error, 3 = +keyboard stop.
  # 2 is kept for equivalence with the previous definition; production should use 0.
  #
  # METIS runs in a purged environment with only its own modules, and crucially with its own
  # Python. metis4muscle3.m has no MATLAB-native MUSCLE3 client -- it drives Python's real
  # libmuscle through MATLAB's pyenv()/py.* bridge, which constrains that Python twice over:
  #
  #   * its libmuscle must match the manager exactly (0.10.0), or registration fails with a
  #     wire-protocol "Unknown session" error;
  #   * it must be a version MATLAB's py.* bridge supports -- 3.9-3.12, and not the 3.13 that
  #     PDS-IMAS-MUSCLE3's venv uses.
  #
  # $EBROOTMETIS/muscle3_venv (built by setup_files/custom_modules/build_metis.sh) is a
  # dedicated Python 3.11 venv with muscle3==0.10.0 that satisfies both. Taking whatever
  # `which python` returns instead picks up the unsupported 3.13 and MATLAB dies mid-run.
  #
  # PYTHONPATH is unset because pyenv inherits this process's environment even in InProcess
  # mode, and would otherwise import a mismatched numpy under the venv's own Python.
  #
  # Done in `script:` rather than `base_env: clean` + `modules:` because a program that sets
  # `script:` has it used verbatim -- native_instantiator.py:231 skips the generated module
  # loading entirely.
  metis:
    description: METIS transport actor (debug_level 2)
    script: |
      #!/bin/bash
      source /etc/profile.d/lmod.sh 2>/dev/null
      module purge
      module use ${PDS_MODULEPATH:-$HOME/public/modules}
      module load METIS-IRFM
      module load PDS-METIS
      module load IMAS-MATLAB
      unset PYTHONPATH
      export IMAS_VERSION=4.1.1
      export HDF5_USE_FILE_LOCKING=FALSE
      exec matlab -batch "pyenv('Version','$EBROOTMETIS/muscle3_venv/bin/python','ExecutionMode','InProcess');addpath(getenv('DIR_METIS4MUSCLE3'));metis4muscle3(2);"

  # ----- PDS-owned actors (run in the IMAS-MUSCLE3 venv -- all import imas) -------------
  loop:
    description: outer convergence loop (SEL submodel)
    ports:
      f_init: [equilibrium_in_f, core_profiles_in_f]
      o_i: [equilibrium_out_i, core_profiles_out_i]
      s: [pf_active_in_s, equilibrium_in_s, core_profiles_in_s]
      o_f: [equilibrium_out_f, pf_active_out_f, core_profiles_out_f, equilibrium_target_out_f]
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/lib/actors/outer_convergence_loop.py

  metis_driver:
    description: drives METIS slice-by-slice behind a whole-trace interface
    ports:
      f_init: [equilibrium_in, core_profiles_in, core_sources_in, pulse_schedule_in]
      o_i: [equilibrium_call, core_profiles_call, core_sources_call, pulse_schedule_call]
      s: [equilibrium_reply, core_profiles_reply]
      o_f: [equilibrium_out_f, core_profiles_out_f]
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/lib/actors/metis_driver.py

  load_balancer:
    description: IMAS-aware NICE load balancer -- scatters slices over N workers
    ports:
      f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
      o_i: [equilibrium_scatter, wall_scatter, pf_active_scatter, pf_passive_scatter, iron_core_scatter]
      s: [equilibrium_gather, pf_active_gather]
      o_f: [equilibrium_out_f, pf_active_out_f]
    env: {HDF5_USE_FILE_LOCKING: "FALSE"}
    virtual_env: $EBROOTIMASMUSCLE3/venv
    executable: python
    args: -u $PDS_REPO/workflows/lib/actors/nice_load_balancer.py

