ymmsl_version: v0.2

# Core model: forward co-simulation, equilibrium exchanged VIA the temporal coupler.
# Replaces torax_nice_controller.
#
# Three separate evolutive models exist rather than one with a swappable link, because a
# single model carrying both the direct conduits and the coupler conduits would leave two
# senders on `transport.equilibrium_in_s` and `nice_evo.equilibrium_s`. check_consistent()
# does not flag that, but it is a double-wire at runtime. lib/direct_cosim.ymmsl.template's
# own header reached the same conclusion.
#
#   evolutive_direct   direct both ways, nice_evo          (replaces evolutive)
#   evolutive_coupled  via temporal_coupler, nice_evo      (this file; torax_nice_controller)
#   evolutive_rd       direct + core_profiles, nice_evo_rd (torax_nice_rd_controller)
#
# Port names are taken from the two WORKING controller templates, not from
# lib/direct_cosim.ymmsl.template: that file declares the transport hole with
# equilibrium_f_init / equilibrium_s / equilibrium_o_i, but TORAX's actual ports are
# equilibrium_in_f / equilibrium_in_s / equilibrium_out_i. It has never been runnable, so
# the mismatch went unnoticed.

imports:
- from lib.programs import implementation source
- from lib.programs import implementation sink
- from lib.programs import implementation sink_source
- from lib.programs import implementation visualization
- from lib.programs import implementation torax
- from lib.programs import implementation nice_evo
- from lib.programs import implementation temporal_coupler
- from lib.programs import implementation magnetic_controller

models:
  evolutive_coupled:
    description: Forward co-simulation with the equilibrium exchange mediated by a temporal coupler.
    components:
      source:
        description: source -- initial IDSs for both peers
        implementation: source
        ports: {o_i: [equilibrium_out, pf_active_out, wall_out, pf_passive_out, iron_core_out, core_profiles_out]}

      transport:
        description: transport co-sim peer (hole; fill = torax)
        implementation: torax
        ports:
          f_init: [equilibrium_in_f, core_profiles_in_f]
          s: [equilibrium_in_s]
          o_i: [equilibrium_out_i, core_profiles_out_i]

      nice_evo:
        description: NICE evolutive co-sim peer
        implementation: nice_evo
        ports:
          f_init: [equilibrium_f_init, wall_f_init, pf_active_f_init, pf_passive_f_init, iron_core_f_init]
          s: [equilibrium_s, pf_active_s]
          o_i: [equilibrium_o_i, pf_active_o_i]

      temporal_coupler:
        description: zero-order-hold coupler between the two peers
        implementation: temporal_coupler
        ports:
          s: [a_in, b_in]
          o_i: [a_out, b_out]

      magnetic_controller:
        description: PCS magnetic (SCDDS) controller
        implementation: magnetic_controller
        optional: true
        ports:
          f_init: [equilibrium_in_f, pf_active_in_f]
          s: [equilibrium_in_s, pf_active_in_s]
          o_i: [pf_active_out_i]

      sink_source:
        description: re-emit static machine description into the transport sink
        implementation: sink_source
        ports:
          f_init: [equilibrium_in]
          o_f: [wall_out, pf_active_out, pf_passive_out, iron_core_out]

      sink_source_nice:
        description: re-emit machine description for NICE-side visualization
        implementation: sink_source
        ports:
          f_init: [equilibrium_in]
          o_f: [wall_out, pf_active_out]

      sink_nice:
        description: sink -- NICE evolutive outputs
        implementation: sink
        ports: {f_init: [equilibrium_in, pf_active_in]}

      sink_torax:
        description: sink -- transport outputs
        implementation: sink
        ports: {f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in, core_profiles_in]}

      sink_controller:
        description: sink -- PCS controller outputs
        implementation: sink
        optional: true
        ports: {f_init: [equilibrium_in, pf_active_in]}

      visualization_nice:
        description: live plotting, NICE side
        implementation: visualization
        optional: true
        ports: {s: [equilibrium_in, pf_active_in, wall_md_in, pf_active_md_in]}

      visualization_torax:
        description: live plotting, transport side
        implementation: visualization
        optional: true
        ports: {s: [equilibrium_in]}

    conduits:
      source.equilibrium_out: [transport.equilibrium_in_f, magnetic_controller.equilibrium_in_f, nice_evo.equilibrium_f_init]
      source.pf_active_out: [magnetic_controller.pf_active_in_f, nice_evo.pf_active_f_init]
      source.pf_passive_out: nice_evo.pf_passive_f_init
      source.iron_core_out: nice_evo.iron_core_f_init
      source.wall_out: nice_evo.wall_f_init
      source.core_profiles_out: transport.core_profiles_in_f

      # equilibrium exchange, mediated
      transport.equilibrium_out_i: temporal_coupler.a_in
      nice_evo.equilibrium_o_i: temporal_coupler.b_in
      temporal_coupler.a_out: transport.equilibrium_in_s
      temporal_coupler.b_out: nice_evo.equilibrium_s

      transport.equilibrium_out_i: [sink_source.equilibrium_in, visualization_torax.equilibrium_in, sink_torax.equilibrium_in]

      sink_source_nice.wall_out: visualization_nice.wall_md_in
      sink_source_nice.pf_active_out: visualization_nice.pf_active_md_in
      sink_source.pf_active_out: sink_torax.pf_active_in
      sink_source.pf_passive_out: sink_torax.pf_passive_in
      sink_source.wall_out: sink_torax.wall_in
      sink_source.iron_core_out: sink_torax.iron_core_in

      nice_evo.equilibrium_o_i: [magnetic_controller.equilibrium_in_s, sink_nice.equilibrium_in, visualization_nice.equilibrium_in, sink_source_nice.equilibrium_in]
      nice_evo.pf_active_o_i: [magnetic_controller.pf_active_in_s, sink_nice.pf_active_in, visualization_nice.pf_active_in]

      magnetic_controller.pf_active_out_i: [nice_evo.pf_active_s, sink_controller.pf_active_in]
