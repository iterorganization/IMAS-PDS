ymmsl_version: v0.1
model:
  name: metis_nice_inv_from_dina_[SHOT_NR]
  components:
    source_nice:
      implementation: source_nice
      ports:
        f_init: [equilibrium_in]
        o_f: [pf_active_out, pf_passive_out, wall_out, iron_core_out]
    source_metis:
      implementation: source_metis
      ports:
        o_f: [pulse_schedule_out, core_profiles_out, core_sources_out]
    nice_inv:
      implementation: nice_inv
      ports:
        f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
        o_f: [equilibrium_out, pf_active_out]
    sink_metis:
      implementation: sink_metis
      ports:
        f_init: [equilibrium_in,pulse_schedule_in,plasma_profiles_in,plasma_sources_in,summary_in]         
    sink_nice:
      implementation: sink_metis
      ports:
        f_init: [equilibrium_in,pf_active_in]
    metis:
      implementation: metis
      ports:
        f_init: [pulse_schedule_f_init,pulse_schedule_in_f,core_profiles_in_f,core_sources_in_f]
        o_f: [equilibrium_out_f,pulse_schedule_out_f,plasma_profiles_out_f,plasma_sources_out_f,summary_out_f]
  conduits:
    metis.equilibrium_out_f: nice_inv.equilibrium_in
    metis.equilibrium_out_f: source_nice.equilibrium_in
    metis.equilibrium_out_f: sink_metis.equilibrium_in
    source_metis.pulse_schedule_out: metis.pulse_schedule_f_init
    source_metis.pulse_schedule_out: metis.pulse_schedule_in_f
    source_metis.core_profiles_out: metis.core_profiles_in_f
    source_metis.core_sources_out: metis.core_sources_in_f
    source_nice.pf_active_out: nice_inv.pf_active_in
    source_nice.pf_passive_out: nice_inv.pf_passive_in
    source_nice.iron_core_out: nice_inv.iron_core_in
    source_nice.wall_out: nice_inv.wall_in
    nice_inv.equilibrium_out: sink_nice.equilibrium_in
    nice_inv.pf_active_out: sink_nice.pf_active_in
    metis.pulse_schedule_out_f: sink_metis.pulse_schedule_in
    metis.plasma_profiles_out_f: sink_metis.plasma_profiles_in
    metis.plasma_sources_out_f: sink_metis.plasma_sources_in 
    metis.summary_out_f: sink_metis.summary_in 
settings:
  source_nice.source_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_dina_in/" 
  source_metis.source_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_metis_in/"
  sink_metis.sink_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_metis_out"
  sink_metis.sink_mode: "w"
  sink_nice.sink_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_nice_out"
  sink_nice.sink_mode: "w"
  metis.metis_computation: 1
  # this value sould be tune if psi_LCFS is a constrainte in NICE inverse
  metis.metis_psioffset: [PSI_OFFSET]
  metis.metis_external_data_equilibrium: 0
  # param.xml should maybe also be optimized to get the correct evolution of the coil currents
  nice_inv.xml_path: "[SUBDIR_PLACEHOLDER]/param.xml"
  muscle_remote_log_level: 'DEBUG'
  python_config_module: 'examples/basic_config.py'

#----------------- -------------
# 3- external data used in METIS
#------------------------------- 
# METIS switch for the use of external data read in IDSs

# From equilibrium IDS
#---------------------
  metis.metis_external_data_equilibrium: 0
  metis.metis_external_data_current_diffusion: 0

# From IDS plasma_profiles (need equilibrium IDS  for precise coordinates transformation)
#----------------------------------------------------------------------------------------
  metis.metis_external_data_electron_temperature: 1
  metis.metis_external_data_electron_density: 1
  metis.metis_external_data_ion_temperature: 1
  metis.metis_external_data_charge_effective: 1
  metis.metis_external_data_momentum: 0

# From IDS plasma_sources (need equilibrium IDS  for precise coordinates transformation)
#---------------------------------------------------------------------------------------
  metis.metis_external_data_LHCD: 0
  metis.metis_external_data_ECRH: 1
  metis.metis_external_data_ICRH: 0
  metis.metis_external_data_NBI:  0
  metis.metis_external_data_PLINE: 0
  metis.metis_external_data_runaway: 0


implementations:
  sink_metis:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  sink_nice:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  source_nice:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    executable: python
    args: "-u -m imas_muscle3.actors.sink_source_component"
  source_metis:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  metis:
    script: |
      #!/bin/bash
      module purge
      module load PDS-METIS IMAS-AL-Matlab/5.3.0-intel-2023b-DD-4.0.0
      # IMAS-AL-Matlab leaks its own numpy onto PYTHONPATH, conflicting with
      # $EBROOTMETIS/muscle3_venv's numpy.
      unset PYTHONPATH
      # $EBROOTMETIS/muscle3_venv is a dedicated Python 3.11 + muscle3==0.10.0
      # venv, matching both MATLAB's supported Python range and the real
      # manager's libmuscle version (see build_metis.sh).
      exec matlab -batch "pyenv('Version','$EBROOTMETIS/muscle3_venv/bin/python','ExecutionMode','InProcess');addpath(getenv('DIR_METIS4MUSCLE3'));metis4muscle3(2);"
  nice_inv:
    env: 
      IMAS_AL_DISABLE_VALIDATE: 1
    base_env: clean
    modules: PDS-NICE
    executable: nice_imas_inv_muscle3
resources:
  source_nice:
    threads: 1
  source_metis:
    threads: 1
  sink_metis:
    threads: 1
  sink_nice:
    threads: 1
  nice_inv:
    threads: 1
  metis:
    threads: 10
  
