ymmsl_version: v0.2
imports:
- from imas_muscle3 import implementation source_component
- from imas_muscle3 import implementation sink_component
- from imas_muscle3 import implementation sink_source_component
- from imas_muscle3 import implementation recorder_component
- from lib.local_programs import implementation torax
- from lib.local_programs import implementation nice_evo
- from lib.local_programs import implementation magnetic_controller
- from lib.local_programs import implementation temporal_coupler
models:
  magnetically_controlled_[SHOT_NR]:
    components:
      source:
        description: source
        implementation: source_component
        ports:
          o_i: [equilibrium_out, pf_active_out, wall_out, pf_passive_out, iron_core_out, core_profiles_out]
      torax:
        description: transport
        implementation: torax
        ports:
          f_init: [equilibrium_in_f, core_profiles_in_f]
          s: [equilibrium_in_s]
          o_i: [equilibrium_out_i, core_profiles_out_i]
      sink_source:
        description: re-emit machine description for the TORAX-side sink
        implementation: sink_source_component
        ports:
          f_init: [equilibrium_in]
          o_f: [wall_out, pf_active_out, pf_passive_out, iron_core_out]
      sink_source_nice:
        description: re-emit machine description for the NICE-side recorder
        implementation: sink_source_component
        ports:
          f_init: [equilibrium_in]
          o_f: [wall_out, pf_active_out]
      magnetic_controller:
        description: PCS/PCSSP magnetic controller
        implementation: magnetic_controller
        ports:
          f_init: [equilibrium_in_f, pf_active_in_f]
          s: [equilibrium_in_s, pf_active_in_s]
          o_i: [pf_active_out_i]
      nice_evo:
        description: NICE evolutive equilibrium
        implementation: nice_evo
        ports:
          f_init: [equilibrium_f_init, wall_f_init, pf_active_f_init, pf_passive_f_init, iron_core_f_init]
          s: [equilibrium_s, pf_active_s]
          o_i: [equilibrium_o_i, pf_active_o_i]
      sink_nice:
        description: sink for NICE output
        implementation: sink_component
        ports:
          f_init: [equilibrium_in, pf_active_in]
      sink_torax:
        description: sink for TORAX output
        implementation: sink_component
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in, core_profiles_in]
      sink_controller:
        description: sink for controller output
        implementation: sink_component
        ports:
          f_init: [equilibrium_in, pf_active_in]
      rec_nice:
        description: distill recorder (NICE evolutive outputs)
        implementation: recorder_component
        ports:
          s: [equilibrium_in, pf_active_in]
      rec_torax:
        description: distill recorder (TORAX per-step outputs)
        implementation: recorder_component
        ports:
          s: [equilibrium_in]
      temporal_coupler:
        description: keeps TORAX and NICE on a common time axis
        implementation: temporal_coupler
        ports:
          s: [a_in, b_in]
          o_i: [a_out, b_out]
    conduits:
      source.equilibrium_out: torax.equilibrium_in_f
      source.equilibrium_out: magnetic_controller.equilibrium_in_f
      source.pf_active_out: magnetic_controller.pf_active_in_f
      source.equilibrium_out: nice_evo.equilibrium_f_init
      source.pf_active_out: nice_evo.pf_active_f_init
      source.pf_passive_out: nice_evo.pf_passive_f_init
      source.iron_core_out: nice_evo.iron_core_f_init
      source.wall_out: nice_evo.wall_f_init
      source.core_profiles_out: torax.core_profiles_in_f

      torax.equilibrium_out_i: temporal_coupler.a_in
      nice_evo.equilibrium_o_i: temporal_coupler.b_in
      temporal_coupler.a_out: torax.equilibrium_in_s
      temporal_coupler.b_out: nice_evo.equilibrium_s

      torax.equilibrium_out_i: sink_source.equilibrium_in
      torax.equilibrium_out_i: rec_torax.equilibrium_in
      torax.equilibrium_out_i: sink_torax.equilibrium_in

      sink_source.pf_active_out: sink_torax.pf_active_in
      sink_source.pf_passive_out: sink_torax.pf_passive_in
      sink_source.wall_out: sink_torax.wall_in
      sink_source.iron_core_out: sink_torax.iron_core_in

      nice_evo.equilibrium_o_i: magnetic_controller.equilibrium_in_s
      nice_evo.equilibrium_o_i: sink_nice.equilibrium_in
      nice_evo.equilibrium_o_i: rec_nice.equilibrium_in
      nice_evo.equilibrium_o_i: sink_source_nice.equilibrium_in
      nice_evo.pf_active_o_i: magnetic_controller.pf_active_in_s
      nice_evo.pf_active_o_i: sink_nice.pf_active_in
      nice_evo.pf_active_o_i: rec_nice.pf_active_in
      magnetic_controller.pf_active_out_i: nice_evo.pf_active_s
      magnetic_controller.pf_active_out_i: sink_controller.pf_active_in
settings:
  source.source_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_out_nice"
  source.iterative: false
  source.t_min: [TSTART_PLACEHOLDER]
  sink_source.source_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_in"
  sink_source_nice.source_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_out_nice2"
  sink_nice.sink_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_out_nice_evo"
  sink_controller.sink_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_out_controller"
  sink_torax.sink_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_out_torax"
  sink_nice.sink_mode: "w"
  sink_controller.sink_mode: "w"
  sink_torax.sink_mode: "w"
  torax.output_all_timeslices: False
  xml_path: [SUBDIR_PLACEHOLDER]/config_nice.xml
  python_config_module: [SUBDIR_PLACEHOLDER]/config_torax.py
  rec_nice.format: distill
  rec_nice.auto: False
  rec_nice.config: [BASEDIR_PLACEHOLDER]/visualization/nice_inv.py
  rec_torax.format: distill
  rec_torax.auto: False
  rec_torax.config: [BASEDIR_PLACEHOLDER]/visualization/kinetic_profiles.py
  muscle_remote_log_level: 'DEBUG'
  nice_evo.t_interval: 0.01   #Need to match torax dt
  nice_evo.dt: 0.01
resources:
  source:
    threads: 1
  sink_source:
    threads: 1
  sink_source_nice:
    threads: 1
  sink_nice:
    threads: 1
  sink_controller:
    threads: 1
  sink_torax:
    threads: 1
  torax:
    threads: 1
  nice_evo:
    threads: 1
  magnetic_controller:
    threads: 1
  rec_nice:
    threads: 1
  rec_torax:
    threads: 1
  temporal_coupler:
    threads: 1
