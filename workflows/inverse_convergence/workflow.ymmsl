ymmsl_version: v0.2

# inverse_convergence -- inverse pulse design converged against TORAX transport.
#
# The full lib/design graph with nothing pruned. Run it by stacking a case, or use a
# self-contained case that imports this model:
#
#   muscle_manager --start-all $PDS_REPO/cases/105084_convergence.ymmsl

imports:
- from lib.design import implementation design

models:
  inverse_convergence:
    description: Inverse pulse design converged against TORAX transport.
    components:
      run:
        description: the design coupling
        implementation: design
        ports: {}   # design has no model ports; everything is internal
