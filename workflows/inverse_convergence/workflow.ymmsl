ymmsl_version: v0.2
# Consolidated inverse_convergence workflow -- structure + programs only; no scenario data.
# This file is STATIC and checkout-independent: the only absolute anchor is $PDS_REPO. The
# `bin/pds-inverse` launcher stacks this with the shared settings.ymmsl knobs and the
# scenario's settings.ymmsl data paths, expands ${PDS_REPO}/${SCEN} in them, and starts the
# manager:  bin/pds-inverse <shot>   (MUSCLE3 does not interpolate settings values, hence the
# expansion). Even launched directly it works if PDS_REPO is exported: base_env defaults to
# MANAGER, so instances inherit it and their generated bash start scripts expand $PDS_REPO.
#
# The loop driver is a clean Submodel-Execution-Loop component -- one full whole-trace pulse
# out (O_I), one full pulse in (S) per Picard iteration -- so the coupling is a pipeline:
#   loop --target--> we --(+Ip,B0)--> lb(nice) --equilibrium--> torax --evolved--> loop
#                                          \--coils-----------------------------> loop
# The waveform editor (we) overlays the designed Ip(t)/B0 onto the target equilibrium in
# place (its input port equilibrium_in selects overlay mode); nice's equilibrium goes
# DIRECTLY to torax; nice's coils return to the loop for the convergence check. nice_lb.py
# does slice -> scatter[W] -> gather -> assemble.
models:
  inverse_convergence:
    components:
      loop:     {description: outer convergence loop (SEL submodel), implementation: loop, ports: {o_i: [target_out, wall_out, pf_active_out, pf_passive_out, iron_core_out, core_profiles_out], s: [coils_in, equilibrium_result_in, core_profiles_result_in]}}
      we:       {description: waveform editor (designed Ip/B0 + imported heating), implementation: we, ports: {f_init: [equilibrium_in], o_f: [equilibrium_out, core_sources_out]}}
      lb:       {description: IMAS-aware NICE load balancer, implementation: lb, ports: {f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in], o_i: [equilibrium_scatter, wall_scatter, pf_active_scatter, pf_passive_scatter, iron_core_scatter], s: [equilibrium_gather, pf_active_gather], o_f: [equilibrium_out_f, pf_active_out_f]}}
      nice_inv: {description: nice, implementation: nice_inv, multiplicity: [8], ports: {f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in], o_f: [equilibrium_out, pf_active_out]}}
      torax:    {description: transport, implementation: torax, ports: {f_init: [equilibrium_in_f, core_profiles_in_f, core_sources_in_f], o_f: [equilibrium_out_f, core_profiles_out_f]}}
      # Distill recorders: terminal sinks that tap (fan-out) the solver outputs
      # and distill each whole-trace IDS into a compact Zarr store -- one file
      # per Picard iteration (occurrence) -- for the muscle3-dashboard viewer.
      # Pure observers: they add no conduit the producers wait on, so they never
      # change the result. To disable, comment these two components, their four
      # recorder conduits below, the `recorder` program and the resources.
      rec_nice:  {description: distill recorder (NICE inverse outputs), implementation: recorder, ports: {s: [equilibrium_in, pf_active_in]}}
      rec_torax: {description: distill recorder (TORAX per-step outputs), implementation: recorder, ports: {s: [equilibrium_in, core_profiles_in]}}
    conduits:
      loop.target_out: we.equilibrium_in
      we.equilibrium_out: lb.equilibrium_in
      we.core_sources_out: torax.core_sources_in_f
      loop.wall_out: lb.wall_in
      loop.pf_active_out: lb.pf_active_in
      loop.pf_passive_out: lb.pf_passive_in
      loop.iron_core_out: lb.iron_core_in
      lb.equilibrium_scatter: nice_inv.equilibrium_in
      lb.wall_scatter: nice_inv.wall_in
      lb.pf_active_scatter: nice_inv.pf_active_in
      lb.pf_passive_scatter: nice_inv.pf_passive_in
      lb.iron_core_scatter: nice_inv.iron_core_in
      nice_inv.equilibrium_out: lb.equilibrium_gather
      nice_inv.pf_active_out: lb.pf_active_gather
      loop.core_profiles_out: torax.core_profiles_in_f
      # Each O_F below fans out (list value) to its normal consumer AND a distill
      # recorder tap -- the recorder is an extra receiver, not a new key.
      lb.equilibrium_out_f: [torax.equilibrium_in_f, rec_nice.equilibrium_in]
      lb.pf_active_out_f: [loop.coils_in, rec_nice.pf_active_in]
      torax.equilibrium_out_f: [loop.equilibrium_result_in, rec_torax.equilibrium_in]
      torax.core_profiles_out_f: [loop.core_profiles_result_in, rec_torax.core_profiles_in]
programs:
  loop:        {virtual_env: $PDS_REPO/../opt/venv-m3091-actors, executable: python, args: -u $PDS_REPO/workflows/inverse_convergence/outer_convergence_loop.py}
  lb:          {virtual_env: $PDS_REPO/../opt/venv-m3091-actors, executable: python, args: -u $PDS_REPO/workflows/inverse_convergence/nice_lb.py}
  recorder:    {virtual_env: $PDS_REPO/../opt/venv-m3091-actors, executable: python, args: -u -m imas_muscle3.actors.distill_component}
  we:          {virtual_env: $PDS_REPO/../opt/venv-m3091-actors, executable: waveform-editor, args: actor}
  nice_inv:
    script: |
      #!/bin/bash
      source /usr/share/lmod/lmod/init/bash
      eval "$($LMOD_CMD bash load NICE/3.0.0-intel-2023b-DD-4.1.0 2>/dev/null)"
      source $PDS_REPO/../opt/muscle3-0.10.0-intel/bin/muscle3.env
      export IMAS_AL_DISABLE_VALIDATE=1 IMAS_VERSION=4.0.0 OMP_NUM_THREADS=2
      exec $PDS_REPO/nice/run/nice_imas_inv_muscle3 "$@"
  torax:
    script: |
      #!/bin/bash
      source /usr/share/lmod/lmod/init/bash
      eval "$($LMOD_CMD bash load Python 2>/dev/null)"
      source $PDS_REPO/run/TORAX-MUSCLE3/venv/bin/activate
      export IMAS_VERSION=4.0.0 JAX_COMPILATION_CACHE_DIR=$PDS_REPO/run/tmp/jax_cache
      exec python -u -m torax_muscle3.torax_actor "$@"
resources: {nice_inv: {threads: 2}, torax: {threads: 8}, rec_nice: {threads: 1}, rec_torax: {threads: 1}}
