ymmsl_version: v0.2
# Consolidated inverse_convergence workflow -- structure + programs only; no scenario data.
# Also needs settings from somewhere else.
#
# Programs come from lib.local_programs (see workflows/lib/local_programs.ymmsl); resolve
# with YMMSL_PATH pointing at the workflows/ directory (bin/pds-run does this). Swap to
# lib.easybuild_programs for EasyBuild-module-based implementations, but see that file's
# header -- none of its IMAS-MUSCLE3/NICE-module entries work with the 0.10.0 manager yet.
imports:
- from lib.local_programs import implementation source
- from lib.local_programs import implementation sink
- from lib.local_programs import implementation sink_source
- from lib.local_programs import implementation validator
- from lib.local_programs import implementation loop
- from lib.local_programs import implementation lb
- from lib.local_programs import implementation recorder
- from lib.local_programs import implementation we
- from lib.local_programs import implementation nice_inv
- from lib.local_programs import implementation torax
models:
  inverse_convergence:
    components:
      source:     {description: source, implementation: source, ports: {o_i: [equilibrium_out, core_profiles_out]}}
      sink_torax: {description: sink torax, implementation: sink, ports: {f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in, core_profiles_in]}}
      sink_nice:  {description: sink nice, implementation: sink, ports: {f_init: [equilibrium_in, pf_active_in]}}
      validator:  {description: imas-validator, implementation: validator, ports: {f_init: [pf_active_in]}}
      loop:       {description: outer convergence loop (SEL submodel), implementation: loop, ports: {f_init: [equilibrium_in_f, core_profiles_in_f], o_i: [equilibrium_out_i, core_profiles_out_i], s: [pf_active_in_s, equilibrium_in_s, core_profiles_in_s], o_f: [equilibrium_out_f, pf_active_out_f, core_profiles_out_f, equilibrium_target_out_f]}}
      we:         {description: waveform editor (designed Ip/B0 + imported heating + static machine description + coil-current seed), implementation: we, ports: {f_init: [equilibrium_in, core_profiles_in], o_f: [equilibrium_out, core_sources_out, core_profiles_out, wall_out, pf_passive_out, iron_core_out, pf_active_out]}}
      lb:         {description: IMAS-aware NICE load balancer, implementation: lb, ports: {f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in], o_i: [equilibrium_scatter, wall_scatter, pf_active_scatter, pf_passive_scatter, iron_core_scatter], s: [equilibrium_gather, pf_active_gather], o_f: [equilibrium_out_f, pf_active_out_f]}}
      nice_inv:   {description: nice, implementation: nice_inv, multiplicity: [1], ports: {f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in], o_f: [equilibrium_out, pf_active_out]}}
      torax:      {description: transport, implementation: torax, ports: {f_init: [equilibrium_in_f, core_profiles_in_f, core_sources_in_f], o_f: [equilibrium_out_f, core_profiles_out_f]}}
      rec_nice:  {description: distill recorder (NICE inverse outputs), implementation: recorder, ports: {s: [equilibrium_in, pf_active_in]}}
      rec_torax: {description: distill recorder (TORAX per-step outputs), implementation: recorder, ports: {s: [equilibrium_in, core_profiles_in]}}
      md_final:   {description: machine description for the final pass (coils-triggered), implementation: sink_source, ports: {f_init: [pf_active_in], o_f: [wall_out, pf_passive_out, iron_core_out]}}
      lb_final:   {description: NICE load balancer (final linear-model pass), implementation: lb, ports: {f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in], o_i: [equilibrium_scatter, wall_scatter, pf_active_scatter, pf_passive_scatter, iron_core_scatter], s: [equilibrium_gather, pf_active_gather], o_f: [equilibrium_out_f, pf_active_out_f]}}
      nice_final: {description: nice with linear-model output, implementation: nice_inv, multiplicity: [1], ports: {f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in], o_f: [equilibrium_out, pf_active_out]}}
    conduits:
      source.equilibrium_out: loop.equilibrium_in_f
      source.core_profiles_out: loop.core_profiles_in_f
      loop.equilibrium_out_i: we.equilibrium_in
      we.equilibrium_out: lb.equilibrium_in
      we.core_sources_out: torax.core_sources_in_f
      we.wall_out: lb.wall_in
      we.pf_passive_out: lb.pf_passive_in
      we.iron_core_out: lb.iron_core_in
      we.pf_active_out: lb.pf_active_in
      lb.equilibrium_scatter: nice_inv.equilibrium_in
      lb.wall_scatter: nice_inv.wall_in
      lb.pf_active_scatter: nice_inv.pf_active_in
      lb.pf_passive_scatter: nice_inv.pf_passive_in
      lb.iron_core_scatter: nice_inv.iron_core_in
      nice_inv.equilibrium_out: lb.equilibrium_gather
      nice_inv.pf_active_out: lb.pf_active_gather
      loop.core_profiles_out_i: we.core_profiles_in
      we.core_profiles_out: torax.core_profiles_in_f
      lb.equilibrium_out_f: [torax.equilibrium_in_f, rec_nice.equilibrium_in, sink_nice.equilibrium_in]
      lb.pf_active_out_f: [loop.pf_active_in_s, rec_nice.pf_active_in, sink_nice.pf_active_in]
      torax.equilibrium_out_f: [loop.equilibrium_in_s, rec_torax.equilibrium_in]
      torax.core_profiles_out_f: [loop.core_profiles_in_s, rec_torax.core_profiles_in]
      loop.equilibrium_out_f: sink_torax.equilibrium_in
      loop.pf_active_out_f: [sink_torax.pf_active_in, lb_final.pf_active_in, md_final.pf_active_in, validator.pf_active_in]
      loop.core_profiles_out_f: sink_torax.core_profiles_in
      loop.equilibrium_target_out_f: lb_final.equilibrium_in
      md_final.wall_out: lb_final.wall_in
      md_final.pf_passive_out: lb_final.pf_passive_in
      md_final.iron_core_out: lb_final.iron_core_in
      lb_final.equilibrium_scatter: nice_final.equilibrium_in
      lb_final.wall_scatter: nice_final.wall_in
      lb_final.pf_active_scatter: nice_final.pf_active_in
      lb_final.pf_passive_scatter: nice_final.pf_passive_in
      lb_final.iron_core_scatter: nice_final.iron_core_in
      nice_final.equilibrium_out: lb_final.equilibrium_gather
      nice_final.pf_active_out: lb_final.pf_active_gather
resources: {nice_inv: {threads: 2}, torax: {threads: 8}, rec_nice: {threads: 1}, rec_torax: {threads: 1}, nice_final: {threads: 2}}
