ymmsl_version: v0.2

# inverse_convergence -- inverse pulse design converged against TORAX transport.
#
# Run it by building a case directory from this model and submitting that:
#
#   bin/pds-create-case inverse_convergence 105084
#   sbatch bin/pds-run-case.sbatch cases/inverse_convergence_105084
#
# Components:
#
#   equilibrium  nice_inverse      whole-trace NICE inverse solve (batch mode)
#   transport    transport         transport co-simulation (TORAX only, for now)
#
# `nice_inverse` is one NICE inverse actor solving the whole trace in batch mode.
#
# `equilibrium` and `transport` are each a thin single-implementation subworkflow so the
# code behind them can be swapped later without touching the top-level model.

imports:
- from imas_muscle3 import implementation source_component
- from imas_muscle3 import implementation sink_component
- from imas_muscle3 import implementation recorder_component
- from imas_muscle3 import implementation olc_component
- from lib.easybuild_programs import implementation loop
- from lib.easybuild_programs import implementation waveform_editor
- from lib.easybuild_programs import implementation torax
- from lib.easybuild_programs import implementation nice_inv
- from lib.easybuild_programs import implementation psi_anchor

models:
  nice_inverse:
    description: NICE inverse solve of the whole trace in one batch call
    ports:
      f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
      o_f: [equilibrium_out, pf_active_out]
    components:
      psi_anchor:
        description: re-gauge profiles_1d.psi onto the designed psi_boundary (the Picard
          state returns from TORAX in TORAX's own gauge, tens of Wb away, and NICE reads
          its boundary-flux target off psi[-1])
        implementation: psi_anchor
        ports:
          f_init: [equilibrium_in]
          o_f: [equilibrium_out]
      nice:
        description: NICE inverse; a multi-slice equilibrium_in is solved in batch mode,
          chunks of consecutive slices in parallel over the actor's threads warm-starting
          along the chunk (setting batch_chunk_slices, default one chunk per thread). On the
          2nd+ Picard iteration each slice restarts from its own previous solution.
        implementation: nice_inv
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_f: [equilibrium_out, pf_active_out]
      recorder_equilibrium:
        description: distill recorder (NICE inverse outputs)
        implementation: recorder_component
        ports: {s: [equilibrium_in, pf_active_in]}
    conduits:
      equilibrium_in: psi_anchor.equilibrium_in
      psi_anchor.equilibrium_out: nice.equilibrium_in
      wall_in: nice.wall_in
      pf_active_in: nice.pf_active_in
      pf_passive_in: nice.pf_passive_in
      iron_core_in: nice.iron_core_in
      # recorder_equilibrium is inside this model, so this is a plain internal conduit
      # rather than a port exposed across the model boundary.
      nice.equilibrium_out: [equilibrium_out, recorder_equilibrium.equilibrium_in]
      nice.pf_active_out: [pf_active_out, recorder_equilibrium.pf_active_in]

  transport:
    description: transport co-simulation (TORAX only, for now)
    ports:
      f_init: [equilibrium_in_f, core_profiles_in_f, core_sources_in_f]
      o_i: [equilibrium_out_i, core_profiles_out_i]
      o_f: [equilibrium_out_f, core_profiles_out_f]
    components:
      torax:
        description: TORAX transport solve
        implementation: torax
        ports:
          f_init: [equilibrium_in_f, core_profiles_in_f, core_sources_in_f]
          o_i: [equilibrium_out_i, core_profiles_out_i]
          o_f: [equilibrium_out_f, core_profiles_out_f]
    conduits:
      equilibrium_in_f: torax.equilibrium_in_f
      core_profiles_in_f: torax.core_profiles_in_f
      core_sources_in_f: torax.core_sources_in_f
      torax.equilibrium_out_i: equilibrium_out_i
      torax.core_profiles_out_i: core_profiles_out_i
      torax.equilibrium_out_f: equilibrium_out_f
      torax.core_profiles_out_f: core_profiles_out_f

  inverse_convergence:
    description: Inverse pulse design converged against TORAX transport.
    components:
      source:
        description: source -- seeds the equilibrium and core_profiles traces
        implementation: source_component
        ports: {o_i: [equilibrium_out, core_profiles_out]}

      loop:
        description: outer convergence loop (SEL submodel)
        implementation: loop
        ports:
          f_init: [equilibrium_in_f, core_profiles_in_f]
          o_i: [equilibrium_out_i, core_profiles_out_i]
          s: [pf_active_in_s, equilibrium_in_s, core_profiles_in_s]
          o_f: [equilibrium_out_f, pf_active_out_f, core_profiles_out_f, equilibrium_target_out_f]

      waveform_editor:
        description: waveform editor (designed Ip/B0 + imported heating + static machine description + coil-current seed)
        implementation: waveform_editor
        ports:
          f_init: [equilibrium_in, core_profiles_in]
          o_f: [equilibrium_out, core_sources_out, core_profiles_out, wall_out, pf_passive_out, iron_core_out, pf_active_out]

      equilibrium:
        description: NICE inverse solve of the whole trace (batch mode)
        implementation: nice_inverse
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_f: [equilibrium_out, pf_active_out]

      transport:
        description: transport co-simulation (TORAX only, for now)
        implementation: transport
        ports:
          f_init: [equilibrium_in_f, core_profiles_in_f, core_sources_in_f]
          o_i: [equilibrium_out_i, core_profiles_out_i]
          o_f: [equilibrium_out_f, core_profiles_out_f]

      sink_equilibrium:
        description: sink -- NICE inverse outputs
        implementation: sink_component
        ports: {f_init: [equilibrium_in, pf_active_in]}

      sink_transport:
        description: sink -- converged pulse
        implementation: sink_component
        optional: true
        ports: {f_init: [equilibrium_in, pf_active_in, core_profiles_in]}

      recorder_transport:
        description: distill recorder (TORAX per-step outputs)
        implementation: recorder_component
        optional: true
        ports: {s: [equilibrium_in, core_profiles_in]}

      validator:
        description: imas-validator on the converged coil currents
        implementation: olc_component
        optional: true
        ports: {f_init: [pf_active_in]}

    conduits:
      source.equilibrium_out: loop.equilibrium_in_f
      source.core_profiles_out: loop.core_profiles_in_f

      loop.equilibrium_out_i: waveform_editor.equilibrium_in
      loop.core_profiles_out_i: waveform_editor.core_profiles_in

      waveform_editor.equilibrium_out: equilibrium.equilibrium_in
      waveform_editor.wall_out: equilibrium.wall_in
      waveform_editor.pf_passive_out: equilibrium.pf_passive_in
      waveform_editor.iron_core_out: equilibrium.iron_core_in
      waveform_editor.pf_active_out: equilibrium.pf_active_in
      waveform_editor.core_sources_out: transport.core_sources_in_f
      waveform_editor.core_profiles_out: transport.core_profiles_in_f

      equilibrium.equilibrium_out: [transport.equilibrium_in_f, sink_equilibrium.equilibrium_in]
      equilibrium.pf_active_out: [loop.pf_active_in_s, sink_equilibrium.pf_active_in]

      transport.equilibrium_out_i: recorder_transport.equilibrium_in
      transport.core_profiles_out_i: recorder_transport.core_profiles_in
      transport.equilibrium_out_f: loop.equilibrium_in_s
      transport.core_profiles_out_f: loop.core_profiles_in_s

      loop.equilibrium_out_f: sink_transport.equilibrium_in
      loop.core_profiles_out_f: sink_transport.core_profiles_in
      loop.pf_active_out_f: [sink_transport.pf_active_in, validator.pf_active_in]
