#!/bin/bash
#SBATCH -J inv_conv
#SBATCH -p all
#SBATCH -A iter
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --time=00:40:00
set -euo pipefail

# Self-contained run step for the consolidated inverse_convergence workflow (replaces the
# old run_simulation.sh + create_runnable_files.sh). The outer Picard convergence runs
# INSIDE MUSCLE3, so there is no shell RERUN loop. Submit from the repo root, e.g.:
#   sbatch workflows/inverse_convergence/run_job.sbatch 105084
# or run inline (run_workflow.sh does this): bash run_job.sbatch 105084
#
# Everything the actors need to locate their installs travels through ONE exported variable,
# $PDS_REPO: workflow.ymmsl resolves $PDS_REPO at instance-launch time (base_env=MANAGER, so
# instances inherit this environment; their start scripts are bash and expand it). MUSCLE3
# does NOT interpolate settings values, so the per-scenario data paths are written here as a
# concrete paths.ymmsl overlay and stacked last:
#   workflow.ymmsl  (structure + programs, static)
#   settings.ymmsl  (per-scenario knobs, committed)
#   paths.ymmsl     (scenario data URIs/paths, generated below)

REPO="${SLURM_SUBMIT_DIR:-$PWD}"
# PDS_REPO is the single absolute anchor the actors resolve at launch (workflow.ymmsl uses
# $PDS_REPO for venvs, scripts and binaries). Deriving it from the submit/working dir suits a
# development checkout run from the repo root; on a fixed install, pin it to an absolute path.
export PDS_REPO="$REPO"
WF="$REPO/workflows/inverse_convergence"
SCEN_NAME="${1:-${SHOT_NR:-105084}}"
SCEN="$WF/scenarios/$SCEN_NAME"
SHOT="$SCEN_NAME"
MANAGER="$REPO/../opt/venv-m3091-actors/bin/muscle_manager"

[[ -f "$WF/workflow.ymmsl" ]]   || { echo "Missing $WF/workflow.ymmsl" >&2; exit 1; }
[[ -f "$SCEN/settings.ymmsl" ]] || { echo "Missing $SCEN/settings.ymmsl" >&2; exit 1; }

# NICE/TORAX configs: a scenario-local override wins, else the shared workflow default.
NICE_CFG="$SCEN/config_nice.xml";  [[ -f "$NICE_CFG" ]]  || NICE_CFG="$WF/config_nice.xml"
TORAX_CFG="$SCEN/config_torax.py"; [[ -f "$TORAX_CFG" ]] || TORAX_CFG="$WF/config_torax.py"

RUNDIR="$SCEN/tmp/m3_runs/run-$(date +%F-%H%M%S)"
mkdir -p "$RUNDIR"
echo "Using running directory: $RUNDIR"

cat > "$RUNDIR/paths.ymmsl" <<EOF
ymmsl_version: v0.2
# Generated by run_job.sbatch -- scenario data paths for $SHOT (settings are not interpolated).
settings:
  loop.source_uri: "imas:hdf5?path=$SCEN/tmp/data/${SHOT}_in/"
  loop.sink_uri: "imas:hdf5?path=$SCEN/tmp/data/${SHOT}_out_nice"
  we.waveforms: $SCEN/waveforms.yaml
  nice_inv.xml_path: $NICE_CFG
  torax.python_config_module: $TORAX_CFG
EOF

"$MANAGER" --start-all \
  "$WF/workflow.ymmsl" "$SCEN/settings.ymmsl" "$RUNDIR/paths.ymmsl" \
  --run-dir "$RUNDIR"
echo "MANAGER_EXIT=$?"
