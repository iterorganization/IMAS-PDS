ymmsl_version: v0.2

# Generic settings for inverse_convergence, stacked after workflow.ymmsl by
# bin/pds-create-case / bin/pds-run. ${SHOT} is filled in by pds-create-case. A shot
# needing different values (MD_LAYOUT=combined's own waveforms.yaml, a calibrated
# config_torax.py, a narrower loop window, ...) overrides them via
# cases/overrides/inverse_convergence_<shot>.ymmsl.

resources:
  inverse_convergence.equilibrium.nice: {threads: 2}
  inverse_convergence.transport.torax: {threads: 8}
  inverse_convergence.equilibrium.recorder_equilibrium: {threads: 1}
  inverse_convergence.recorder_transport: {threads: 1}

settings:
  # Pulse design (generic, placeholders filled per shot) + input DBEntry, from pds-scenarios.
  waveform_editor.waveforms: ${PDS_REPO}/workflows/inverse_convergence/waveforms.yaml
  source.source_uri: "imas:hdf5?path=${SCENARIOS_REPO}/${SHOT}/data/in"
  source.iterative: False
  equilibrium.recorder_equilibrium.md: "wall=imas:hdf5?path=${SCENARIOS_REPO}/${SHOT}/data/in_md pf_active=imas:hdf5?path=${SCENARIOS_REPO}/${SHOT}/data/in_md"

  # Convergence defaults; a scenario may override any of these.
  loop.cold_start: False
  loop.max_iterations: 2
  loop.max_slices: 0
  loop.tolerance: 1000.0
  loop.rel_tolerance: 0.03

  # Solvers.
  equilibrium.nice.xml_path: ${PDS_REPO}/workflows/inverse_convergence/config_nice_inverse.xml
  transport.torax.python_config_module: ${PDS_REPO}/workflows/inverse_convergence/config_torax.py
  transport.torax.output_all_timeslices: True
  transport.torax.fixed_dt: 0.3

  # Output. `../../../` climbs out of the instance's own work directory, so the entries
  # land next to the run's logs in <run_dir>/ rather than under instances/.
  sink_equilibrium.sink_uri: "imas:hdf5?path=../../../out_nice"
  sink_equilibrium.sink_mode: "w"
  sink_transport.sink_uri: "imas:hdf5?path=../../../out_torax"
  sink_transport.sink_mode: "w"

  # Recording.
  equilibrium.recorder_equilibrium.format: distill
  equilibrium.recorder_equilibrium.auto: False
  equilibrium.recorder_equilibrium.config: ${PDS_REPO}/visualization/nice_inv.py
  recorder_transport.format: distill
  recorder_transport.auto: False
  recorder_transport.config: ${PDS_REPO}/visualization/kinetic_profiles.py

  # Validation.
  validator.halt_on_error: False
  validator.extra_rule_dirs: ${PDS_REPO}/pds_validation_tests
  validator.rulesets: iter-olc
  validator.apply_generic: False

  muscle_remote_log_level: 'INFO'
