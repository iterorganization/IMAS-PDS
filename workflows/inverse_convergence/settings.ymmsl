ymmsl_version: v0.2
# Shared knobs for inverse_convergence, stacked onto the static workflow.ymmsl. The
# scenario-local scenarios/<shot>/settings.ymmsl (data URIs/paths) is stacked after this.
settings:
  # loop.cold_start: True
  loop.cold_start: False
  loop.max_iterations: 2
  loop.max_slices: 0
  loop.tolerance: 1000.0
  loop.rel_tolerance: 0.03
  torax.output_all_timeslices: True
  source.iterative: False
  sink_nice.sink_mode: "w"
  sink_torax.sink_mode: "w"
  source.source_uri: "imas:hdf5?path=${SCEN}/tmp/data/${SHOT}_in/"
  sink_nice.sink_uri: "imas:hdf5?path=${SCEN}/tmp/data/${SHOT}_out_nice"
  sink_torax.sink_uri: "imas:hdf5?path=${SCEN}/tmp/data/${SHOT}_out_torax"
  we.waveforms: ${SCEN}/waveforms.yaml
  # NICE recorder: distill via the State class in the (shared) plot file, so
  # the stored quantities and the dashboard plots that read them stay in
  # lockstep. auto off: only the plot file's groups, no auto-discovered ones.
  # `md` (read by muscle3-dashboard, ignored by the recorder) locates the
  # static machine-description IDSs the Plotter overlays (wall, coil geometry).
  rec_nice.format: distill
  rec_nice.auto: False
  rec_nice.config: ${PDS_REPO}/visualization/nice_inv.py
  rec_nice.md: "wall=imas:hdf5?path=${SCEN}/tmp/data/${SHOT}_in_md_we pf_active=imas:hdf5?path=${SCEN}/tmp/data/${SHOT}_in_md_we"
  # TORAX recorder: same one-file contract, no geometry overlays (no md).
  rec_torax.format: distill
  rec_torax.auto: False
  rec_torax.config: ${PDS_REPO}/visualization/kinetic_profiles.py
  nice_inv.xml_path: ${PDS_REPO}/workflows/inverse_convergence/config_nice.xml
  # Final linear-model pass: md_final serves the static machine description to
  # lb_final (its o_f fires once, gated on the loop's converged coils; no
  # sink_uri, so it stores nothing). nice_final runs the same NICE xml as the
  # in-loop nice_inv but with outputForControl switched on through the actor's
  # output_for_control setting, so it writes the linear-model A,B,C matrices
  # per timestamp in its instance workdir (output/linearModel_t<time>/).
  md_final.source_uri: "imas:hdf5?path=${SCEN}/tmp/data/${SHOT}_in_md_we"
  nice_final.xml_path: ${PDS_REPO}/workflows/inverse_convergence/config_nice.xml
  nice_final.output_for_control: 1
  torax.python_config_module: ${PDS_REPO}/workflows/inverse_convergence/config_torax.py
  validator.halt_on_error: False
  validator.extra_rule_dirs: ${PDS_REPO}/pds_validation_tests
  validator.rulesets: iter-olc
  validator.apply_generic: False
  muscle_remote_log_level: 'INFO'
