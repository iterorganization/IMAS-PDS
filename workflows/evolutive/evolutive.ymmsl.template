ymmsl_version: v0.2

# Top-level workflow B: evolutive.
# Wraps the `direct_cosim` subworkflow (nice_evo <-> torax direct co-simulation) as a
# single nested component `cosim`. The scenario disables the optional controller +
# temporal_coupler, fills transport=torax and nice_evo=nice_evo (swap to nice_evo_rd for
# the resistive-diffusion variant), and supplies settings.
#
# Resolve with YMMSL_PATH pointing at the workflows/ directory.

imports:
- from lib.direct_cosim import implementation direct_cosim
- from lib.programs import implementation source
- from lib.programs import implementation torax
- from lib.programs import implementation nice_evo
- from lib.programs import implementation nice_evo_rd
- from lib.programs import implementation magnetic_controller
- from lib.programs import implementation temporal_coupler
- from lib.programs import implementation visualization

models:
  evolutive:
    description: Evolutive nice_evo <-> torax direct co-simulation wrapper.
    components:
      cosim:
        description: One direct co-simulation run.
        implementation: direct_cosim
        ports: {}
