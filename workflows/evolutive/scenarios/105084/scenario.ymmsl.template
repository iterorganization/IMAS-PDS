ymmsl_version: v0.2

# Scenario 105084 for the evolutive workflow (default = pure direct co-sim).
# Disables the optional PCS controller + temporal coupler + their dedicated sink, fills
# transport=torax and nice_evo=nice_evo, enables both visualizations. To run the
# resistive-diffusion variant, change evolutive.cosim.nice_evo to nice_evo_rd (and add
# core_profiles_s / core_profiles_f_init ports + conduits per torax_nice_rd_controller).
# To run the controller variant, set evolutive.cosim.temporal_coupler /
# evolutive.cosim.magnetic_controller / evolutive.cosim.sink_controller to their fills
# (see the note in lib/direct_cosim.ymmsl about removing the two direct conduits first).
# Placeholders are expanded by create_runnable_files.sh -> hence .template.

custom_implementations:
  evolutive.cosim.source: source
  evolutive.cosim.transport: torax
  evolutive.cosim.nice_evo: nice_evo
  evolutive.cosim.temporal_coupler: null
  evolutive.cosim.magnetic_controller: null
  evolutive.cosim.sink_controller: null
  evolutive.cosim.visualization_nice: visualization
  evolutive.cosim.visualization_torax: visualization

settings:
  evolutive.cosim.source.source_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_out_nice"
  evolutive.cosim.source.iterative: false
  evolutive.cosim.source.t_min: [TSTART_PLACEHOLDER]
  evolutive.cosim.sink_source.source_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_in"
  evolutive.cosim.sink_source_nice.source_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_out_nice2"
  evolutive.cosim.sink_nice.sink_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_out_nice_evo"
  evolutive.cosim.sink_torax.sink_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_out_torax"
  evolutive.cosim.sink_nice.sink_mode: "w"
  evolutive.cosim.sink_torax.sink_mode: "w"
  evolutive.cosim.transport.output_all_timeslices: false
  evolutive.cosim.transport.python_config_module: [SUBDIR_PLACEHOLDER]/config_torax.py
  evolutive.cosim.nice_evo.xml_path: [SUBDIR_PLACEHOLDER]/config_nice.xml
  evolutive.cosim.nice_evo.t_interval: 0.01
  evolutive.cosim.nice_evo.dt: 0.01
  evolutive.cosim.visualization_nice.plot_file_path: [BASEDIR_PLACEHOLDER]/visualization/nice_inv.py
  evolutive.cosim.visualization_nice.throttle_interval: 0.4
  evolutive.cosim.visualization_nice.keep_alive: false
  evolutive.cosim.visualization_torax.plot_file_path: [BASEDIR_PLACEHOLDER]/visualization/torax.py
  evolutive.cosim.visualization_torax.throttle_interval: 0.4
  evolutive.cosim.visualization_torax.keep_alive: false
  muscle_remote_log_level: 'DEBUG'
