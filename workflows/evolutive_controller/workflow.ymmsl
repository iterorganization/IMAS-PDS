ymmsl_version: v0.2
# Consolidated magnetic_control workflow structure; no scenario data.
# Also needs settings from somewhere else.
#
# Programs are lib.easybuild_programs (EasyBuild-module-based) or, for
# source/sink/recorder/passthrough_component, the imas_muscle3 package directly --
# no repo-local venv builds required. Resolve with YMMSL_PATH pointing at the
# workflows/ directory (bin/pds-run does this).
#
# Settings come from workflows/evolutive_controller/settings.ymmsl

imports:
- from imas_muscle3 import implementation source_component
- from imas_muscle3 import implementation sink_component
- from imas_muscle3 import implementation recorder_component
- from imas_muscle3 import implementation passthrough_component
- from lib.easybuild_programs import implementation waveform_editor
- from lib.easybuild_programs import implementation torax
- from lib.easybuild_programs import implementation nice_evo_rd
- from lib.easybuild_programs import implementation magnetic_controller
- from lib.easybuild_programs import implementation temporal_coupler

models:
  evolutive_controller:
    components:
      source:  {description: NICE-reconstructed equilibrium from a completed inverse_convergence run, implementation: source_component, ports: {o_i: [equilibrium_out]}}
      waveform_editor: {description: waveform editor (passes through received equilibrium + assembles core_sources/core_profiles + static MD + coil-current seed from DINA), implementation: waveform_editor, ports: {f_init: [equilibrium_in], o_f: [equilibrium_out, core_sources_out, core_profiles_out, wall_out, pf_passive_out, iron_core_out, pf_active_out]}}
      torax:   {description: transport (self-consistent ohmic + radiation; ECRH actuator imported via core_sources_in_f), implementation: torax, ports: {f_init: [equilibrium_in_f, core_profiles_in_f, core_sources_in_f], s: [equilibrium_in_s], o_i: [equilibrium_out_i, core_profiles_out_i]}}
      nice_evo_rd: {description: nice evolutive free-boundary + resistive-diffusion solve, implementation: nice_evo_rd, ports: {f_init: [equilibrium_f_init, wall_f_init, pf_active_f_init, pf_passive_f_init, iron_core_f_init, core_profiles_f_init], s: [equilibrium_s, pf_active_s, core_profiles_s], o_i: [equilibrium_o_i, pf_active_o_i]}}
      magnetic_controller: {description: PCSSP magnetic (SCDDS) controller, implementation: magnetic_controller, ports: {f_init: [equilibrium_in_f, pf_active_in_f], s: [equilibrium_in_s, pf_active_in_s], o_i: [pf_active_out_i]}}
      sink_equilibrium:       {description: sink -- NICE evolutive outputs, implementation: sink_component, ports: {f_init: [equilibrium_in, pf_active_in]}}
      sink_transport:      {description: sink -- TORAX outputs, implementation: sink_component, ports: {f_init: [equilibrium_in, core_profiles_in]}}
      sink_control: {description: sink -- controller outputs, implementation: sink_component, ports: {f_init: [pf_active_in]}}
      rec_equilibrium:  {description: distill recorder (NICE evo_rd outputs), implementation: recorder_component, ports: {s: [equilibrium_in, pf_active_in]}}
      rec_transport: {description: distill recorder (TORAX per-step outputs), implementation: recorder_component, ports: {s: [equilibrium_in, core_profiles_in]}}
      temporal_coupler: {description: temporal coupler between torax and nice_evo_rd equilibrium feedback loop (also carries torax's core_profiles onward to nice_evo_rd), implementation: temporal_coupler, ports: {s: [a_in_equilibrium, a_in_core_profiles, b_in_equilibrium], o_i: [a_out_equilibrium, b_out_equilibrium, b_out_core_profiles]}}
    conduits:
      source.equilibrium_out: waveform_editor.equilibrium_in

      waveform_editor.equilibrium_out: [torax.equilibrium_in_f, magnetic_controller.equilibrium_in_f, nice_evo_rd.equilibrium_f_init]
      waveform_editor.pf_active_out: [magnetic_controller.pf_active_in_f, nice_evo_rd.pf_active_f_init]
      waveform_editor.wall_out: nice_evo_rd.wall_f_init
      waveform_editor.pf_passive_out: nice_evo_rd.pf_passive_f_init
      waveform_editor.iron_core_out: nice_evo_rd.iron_core_f_init
      waveform_editor.core_profiles_out: [torax.core_profiles_in_f, nice_evo_rd.core_profiles_f_init]
      waveform_editor.core_sources_out: torax.core_sources_in_f

      torax.equilibrium_out_i: [temporal_coupler.a_in_equilibrium, sink_transport.equilibrium_in, rec_transport.equilibrium_in]
      torax.core_profiles_out_i: [temporal_coupler.a_in_core_profiles, sink_transport.core_profiles_in, rec_transport.core_profiles_in]

      temporal_coupler.a_out_equilibrium: torax.equilibrium_in_s
      temporal_coupler.b_out_equilibrium: nice_evo_rd.equilibrium_s
      temporal_coupler.b_out_core_profiles: nice_evo_rd.core_profiles_s

      nice_evo_rd.equilibrium_o_i: [temporal_coupler.b_in_equilibrium, magnetic_controller.equilibrium_in_s, sink_equilibrium.equilibrium_in, rec_equilibrium.equilibrium_in]
      nice_evo_rd.pf_active_o_i: [magnetic_controller.pf_active_in_s, sink_equilibrium.pf_active_in, rec_equilibrium.pf_active_in]

      magnetic_controller.pf_active_out_i: [nice_evo_rd.pf_active_s, sink_control.pf_active_in]
resources: {evolutive_controller.torax: {threads: 8}, evolutive_controller.nice_evo_rd: {threads: 2}, evolutive_controller.magnetic_controller: {threads: 1}, evolutive_controller.rec_equilibrium: {threads: 1}, evolutive_controller.rec_transport: {threads: 1}, evolutive_controller.temporal_coupler: {threads: 1}}