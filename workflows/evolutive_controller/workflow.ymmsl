ymmsl_version: v0.2
# Consolidated magnetic_control workflow structure; no scenario data.
# Also needs programs and settings from somewhere else.
#
# Programs come from lib.local_programs (see workflows/lib/local_programs.ymmsl);
# resolve # with YMMSL_PATH pointing at the workflows/ directory (bin/pds-run does this).
# Swap to lib.easybuild_programs for EasyBuild-module-based implementations
#
# Settings come from workflows/magnetic_control/settings.ymmsl

imports:
- from imas_muscle3 import implementation source_component
- from imas_muscle3 import implementation sink_component
- from imas_muscle3 import implementation recorder_component
- from imas_muscle3 import implementation passthrough_component
- from lib.easybuild_programs import implementation waveform_editor
# - from lib.easybuild_programs import implementation torax
- from lib.local_programs import implementation torax
- from lib.local_programs import implementation nice_evo_rd
- from lib.local_programs import implementation temporal_coupler

models:
  evolutive_controller:
    components:
      source:  {description: NICE-reconstructed equilibrium from a completed inverse_convergence run, implementation: source_component, ports: {o_i: [equilibrium_out]}}
      waveform_editor: {description: waveform editor (passes through received equilibrium + assembles core_sources/core_profiles + static MD + coil-current seed from DINA), implementation: waveform_editor, ports: {f_init: [equilibrium_in], o_f: [equilibrium_out, core_sources_out, core_profiles_out, wall_out, pf_passive_out, iron_core_out, pf_active_out]}}
      torax:   {description: transport (self-consistent ohmic + radiation; ECRH actuator imported via core_sources_in_f), implementation: torax, ports: {f_init: [equilibrium_in_f, core_profiles_in_f, core_sources_in_f], s: [equilibrium_in_s], o_i: [equilibrium_out_i, core_profiles_out_i]}}
      nice_evo_rd: {description: nice evolutive free-boundary + resistive-diffusion solve, implementation: nice_evo_rd, ports: {f_init: [equilibrium_f_init, wall_f_init, pf_active_f_init, pf_passive_f_init, iron_core_f_init, core_profiles_f_init], s: [equilibrium_s, pf_active_s, core_profiles_s], o_i: [equilibrium_o_i, pf_active_o_i]}}
      magnetic_controller: {description: PCSSP magnetic (SCDDS) controller, implementation: magnetic_controller, ports: {f_init: [equilibrium_in_f, pf_active_in_f], s: [equilibrium_in_s, pf_active_in_s], o_i: [pf_active_out_i]}}
      sink_nice:       {description: sink nice, implementation: sink_component, ports: {f_init: [equilibrium_in, pf_active_in]}}
      sink_torax:      {description: sink torax, implementation: sink_component, ports: {f_init: [equilibrium_in, core_profiles_in]}}
      sink_controller: {description: sink controller, implementation: sink_component, ports: {f_init: [pf_active_in]}}
      rec_nice:  {description: distill recorder (NICE evo_rd outputs), implementation: recorder_component, ports: {s: [equilibrium_in, pf_active_in]}}
      rec_torax: {description: distill recorder (TORAX per-step outputs), implementation: recorder_component, ports: {s: [equilibrium_in, core_profiles_in]}}
      temporal_coupler: {description: temporal coupler between torax and nice_evo_rd equilibrium feedback loop (also carries torax's core_profiles onward to nice_evo_rd), implementation: temporal_coupler, ports: {s: [a_in_equilibrium, a_in_core_profiles, b_in_equilibrium], o_i: [a_out_equilibrium, b_out_equilibrium, b_out_core_profiles]}}
    conduits:
      source.equilibrium_out: waveform_editor.equilibrium_in

      waveform_editor.equilibrium_out: [torax.equilibrium_in_f, magnetic_controller.equilibrium_in_f, nice_evo_rd.equilibrium_f_init]
      waveform_editor.pf_active_out: [magnetic_controller.pf_active_in_f, nice_evo_rd.pf_active_f_init]
      waveform_editor.wall_out: nice_evo_rd.wall_f_init
      waveform_editor.pf_passive_out: nice_evo_rd.pf_passive_f_init
      waveform_editor.iron_core_out: nice_evo_rd.iron_core_f_init
      waveform_editor.core_profiles_out: [torax.core_profiles_in_f, nice_evo_rd.core_profiles_f_init]
      waveform_editor.core_sources_out: torax.core_sources_in_f

      torax.equilibrium_out_i: [temporal_coupler.a_in_equilibrium, sink_torax.equilibrium_in, rec_torax.equilibrium_in]
      torax.core_profiles_out_i: [temporal_coupler.a_in_core_profiles, sink_torax.core_profiles_in, rec_torax.core_profiles_in]

      temporal_coupler.a_out_equilibrium: torax.equilibrium_in_s
      temporal_coupler.b_out_equilibrium: nice_evo_rd.equilibrium_s
      temporal_coupler.b_out_core_profiles: nice_evo_rd.core_profiles_s

      nice_evo_rd.equilibrium_o_i: [temporal_coupler.b_in_equilibrium, magnetic_controller.equilibrium_in_s, sink_nice.equilibrium_in, rec_nice.equilibrium_in]
      nice_evo_rd.pf_active_o_i: [magnetic_controller.pf_active_in_s, sink_nice.pf_active_in, rec_nice.pf_active_in]

      magnetic_controller.pf_active_out_i: [nice_evo_rd.pf_active_s, sink_controller.pf_active_in]
programs:
  # Original pre-refactor inline definition (kept alongside lib.local_programs' version) --
  # this one lives in $WF/workflow.ymmsl so bin/pds-run's envsubst expands $PDS_REPO before
  # the manager ever parses it, unlike lib.local_programs.ymmsl which is loaded straight off
  # YMMSL_PATH. Testing whether that difference (vs. the script: form in local_programs.ymmsl)
  # matters for the silent early-exit issue.
  magnetic_controller:
    env:
      PCS_PATH: $PDS_REPO/run/pcs
      CONTROLLER_PATH: $PDS_REPO/controllers/magnetic_controller
      SCDDS_COREPATH: $PDS_REPO/run/pcs/pcssp/scdds
    modules: IMAS-AL-Matlab/5.3.0-intel-2023b-DD-4.0.0 MATLAB/2025b-r1-GCCcore-13.2.0
    executable: matlab
    # Explicitly pyenv() at the repo-local muscle3-0.10.0 venv python, NOT `which python`:
    # on this system that resolves to a stray user ~/.local muscle3-0.8.0 libmuscle install,
    # which is wire-incompatible with the 0.10.0 manager every other actor here uses --
    # produces a "socket closed while receiving" registration failure after MATLAB startup.
    args: -batch "pyenv('Version','$PDS_REPO/run/IMAS-MUSCLE3/venv/bin/python','ExecutionMode','InProcess');
                  addpath(getenv('PCS_PATH'));
                  run('$PDS_REPO/run/nice/runmatlab/initNice4matlab.m');
                  pcssp_pcs_add_paths;
                  comparisons.ExternalSCMLink.setupGitConfig();
                  addpath(getenv('CONTROLLER_PATH'));
                  muscle_controller_NICE_IMAS_iter_init;"
resources: {torax: {threads: 8}, nice_evo_rd: {threads: 2}, magnetic_controller: {threads: 1}, rec_nice: {threads: 1}, rec_torax: {threads: 1}, temporal_coupler: {threads: 1}}