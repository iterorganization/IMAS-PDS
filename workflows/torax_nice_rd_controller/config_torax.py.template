def get_t_values(imas_uri):
    import imas
    import numpy as np
    with imas.DBEntry(imas_uri, 'r') as db:
        eq = db.get('equilibrium')
        t_initial = eq.time[0]
        t_final = eq.time[-1]
    return t_initial, t_final

