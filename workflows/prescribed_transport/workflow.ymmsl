ymmsl_version: v0.2
# Consolidated prescribed_transport workflow structure; no scenario data.
# Also needs programs and settings from somewhere else.
#
# Programs come from lib.easybuild_programs (see workflows/lib/easybuild_programs.ymmsl);
# resolve with YMMSL_PATH pointing at the workflows/ directory (bin/pds-run does this).
# To override one actor (e.g. your own build), copy easybuild_programs.ymmsl to
# lib/easybuild_programs_<yourname>.ymmsl and repoint just that actor's import here.
#
# Settings come from workflows/prescribed_transport/settings.ymmsl

imports:
- from imas_muscle3 import implementation source_component
- from imas_muscle3 import implementation sink_component
- from imas_muscle3 import implementation recorder_component
- from lib.easybuild_programs import implementation waveform_editor
- from lib.easybuild_programs import implementation nice_inv
models:
  prescribed_transport:
    components:
      source:   {description: source, implementation: source_component, ports: {o_i: [equilibrium_out]}}
      waveform_editor: {description: waveform editor (designed Ip/B0 target + static machine description + coil-current seed), implementation: waveform_editor, ports: {f_init: [equilibrium_in], o_f: [equilibrium_out, wall_out, pf_active_out, pf_passive_out, iron_core_out]}}
      nice_inv: {description: nice, implementation: nice_inv, ports: {f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in], o_f: [equilibrium_out, pf_active_out]}}
      sink:     {description: sink, implementation: sink_component, ports: {f_init: [equilibrium_in, pf_active_in]}}
      rec_nice: {description: distill recorder (NICE inverse outputs), implementation: recorder_component, ports: {s: [equilibrium_in, pf_active_in]}}
    conduits:
      source.equilibrium_out: waveform_editor.equilibrium_in
      waveform_editor.equilibrium_out: nice_inv.equilibrium_in
      waveform_editor.wall_out: nice_inv.wall_in
      waveform_editor.pf_active_out: nice_inv.pf_active_in
      waveform_editor.pf_passive_out: nice_inv.pf_passive_in
      waveform_editor.iron_core_out: nice_inv.iron_core_in
      nice_inv.equilibrium_out: [sink.equilibrium_in, rec_nice.equilibrium_in]
      nice_inv.pf_active_out: [sink.pf_active_in, rec_nice.pf_active_in]
resources: {nice_inv: {threads: 2}, rec_nice: {threads: 1}}
