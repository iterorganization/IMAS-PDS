ymmsl_version: v0.1
model:
  name: metis_nice_inv_from_dina_[SHOT_NR]
  components:
    source_metis:
      implementation: source_metis
      ports:
        o_f: [pulse_schedule_out, core_profiles_out, core_sources_out]
    sink_metis:
      implementation: sink_metis
      ports:
        f_init: [equilibrium_in,pulse_schedule_in,plasma_profiles_in,plasma_sources_in,summary_in]         
    metis:
      implementation: metis
      ports:
        f_init: [pulse_schedule_f_init,pulse_schedule_in_f,core_profiles_in_f,core_sources_in_f]
        o_f: [equilibrium_out_f,pulse_schedule_out_f,plasma_profiles_out_f,plasma_sources_out_f,summary_out_f]
  conduits:
    metis.equilibrium_out_f: sink_metis.equilibrium_in
    source_metis.pulse_schedule_out: metis.pulse_schedule_f_init
    source_metis.pulse_schedule_out: metis.pulse_schedule_in_f
    source_metis.core_profiles_out: metis.core_profiles_in_f
    source_metis.core_sources_out: metis.core_sources_in_f
    metis.pulse_schedule_out_f: sink_metis.pulse_schedule_in
    metis.plasma_profiles_out_f: sink_metis.plasma_profiles_in
    metis.plasma_sources_out_f: sink_metis.plasma_sources_in 
    metis.summary_out_f: sink_metis.summary_in 
settings:
  source_metis.source_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_metis_in/"
  sink_metis.sink_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_metis_out/"
  metis.metis_computation: 1
  # this value sould be tune if psi_LCFS is a constrainte in NICE inverse
  metis.metis_psioffset: 9.0
  metis.metis_external_data_equilibrium: 0
  muscle_remote_log_level: 'DEBUG'
  python_config_module: 'examples/basic_config.py'

#----------------- -------------
# 3- external data used in METIS
#------------------------------- 
# METIS switch for the use of external data read in IDSs

# From equilibrium IDS
#---------------------
  metis.metis_external_data_equilibrium: 0
  metis.metis_external_data_current_diffusion: 0

# From IDS plasma_profiles (need equilibrium IDS  for precise coordinates transformation)
#----------------------------------------------------------------------------------------
  metis.metis_external_data_electron_temperature: 1
  metis.metis_external_data_electron_density: 1
  metis.metis_external_data_ion_temperature: 1
  metis.metis_external_data_charge_effective: 1
  metis.metis_external_data_momentum: 0

# From IDS plasma_sources (need equilibrium IDS  for precise coordinates transformation)
#---------------------------------------------------------------------------------------
  metis.metis_external_data_LHCD: 0
  metis.metis_external_data_ECRH: 1
  metis.metis_external_data_ICRH: 0
  metis.metis_external_data_NBI:  0
  metis.metis_external_data_PLINE: 0
  metis.metis_external_data_runaway: 0


implementations:
  sink_metis:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-MUSCLE3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  source_metis:
    virtual_env: [BASEDIR_PLACEHOLDER]/run/IMAS-MUSCLE3/venv
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  metis: 
    env: 
      DIR_METIS4MUSCLE3: [BASEDIR_PLACEHOLDER]/run/metis/workflow/muscle3/mfile
    executable: matlab
    args: -batch "[s,t] = unix('which python');pyenv('Version',strtrim(t),'ExecutionMode','InProcess');addpath(getenv('DIR_METIS4MUSCLE3'));metis4muscle3(2);"
#    args: -r "[s,t] = unix('which python');pyenv('Version',strtrim(t),'ExecutionMode','InProcess');addpath(getenv('DIR_METIS4MUSCLE3'));metis4muscle3(3);"
resources:
  source_metis:
    threads: 1
  sink_metis:
    threads: 1
  metis:
    threads: 10
  
