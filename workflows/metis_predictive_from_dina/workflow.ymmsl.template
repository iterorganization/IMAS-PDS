ymmsl_version: v0.1
model:
  name: metis_from_dina_[SHOT_NR]
  components:
    source_metis:
      implementation: source_metis
      ports:
        o_f: [pulse_schedule_out, core_profiles_out, core_sources_out]
    sink_metis:
      implementation: sink_metis
      ports:
        f_init: [equilibrium_in,pulse_schedule_in,plasma_profiles_in,plasma_sources_in,summary_in]         
    metis:
      implementation: metis
      ports:
        f_init: [pulse_schedule_f_init,pulse_schedule_in_f,core_profiles_in_f,core_sources_in_f]
        o_f: [equilibrium_out_f,pulse_schedule_out_f,plasma_profiles_out_f,plasma_sources_out_f,summary_out_f]
  conduits:
    metis.equilibrium_out_f: sink_metis.equilibrium_in
    source_metis.pulse_schedule_out: metis.pulse_schedule_f_init
    source_metis.pulse_schedule_out: metis.pulse_schedule_in_f
    source_metis.core_profiles_out: metis.core_profiles_in_f
    source_metis.core_sources_out: metis.core_sources_in_f
    metis.pulse_schedule_out_f: sink_metis.pulse_schedule_in
    metis.plasma_profiles_out_f: sink_metis.plasma_profiles_in
    metis.plasma_sources_out_f: sink_metis.plasma_sources_in 
    metis.summary_out_f: sink_metis.summary_in 
settings:
  source_metis.source_uri: "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_metis_in/"
  sink_metis.sink_uri:     "imas:hdf5?path=[SUBDIR_PLACEHOLDER]/tmp/data/[SHOT_NR]_metis_out/"
  metis.metis_computation: 1
  # this value sould be tune if psi_LCFS is a constrainte in NICE inverse
  metis.metis_psioffset: 9.0 
  metis.metis_external_data_equilibrium: 0
  muscle_remote_log_level: 'DEBUG'
  python_config_module: 'examples/basic_config.py'

#----------------- -------------
# 3- external data used in METIS
#------------------------------- 
# METIS switch for the use of external data read in IDSs

# From equilibrium IDS
#---------------------
  metis.metis_external_data_equilibrium: 0
  metis.metis_external_data_current_diffusion: 0

# From IDS plasma_profiles (need equilibrium IDS  for precise coordinates transformation)
#----------------------------------------------------------------------------------------
  metis.metis_external_data_electron_temperature: 0
  metis.metis_external_data_electron_density: 0
  metis.metis_external_data_ion_temperature: 0
  metis.metis_external_data_charge_effective: 0
  metis.metis_external_data_momentum: 0

# From IDS plasma_sources (need equilibrium IDS  for precise coordinates transformation)
#---------------------------------------------------------------------------------------
  metis.metis_external_data_LHCD: 0
  metis.metis_external_data_ECRH: 0
  metis.metis_external_data_ICRH: 0
  metis.metis_external_data_NBI:  0
  metis.metis_external_data_PLINE: 0
  metis.metis_external_data_runaway: 0


implementations:
  sink_metis:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    executable: python
    args: "-u -m imas_muscle3.actors.sink_component"
  source_metis:
    base_env: clean
    modules: PDS-IMAS-MUSCLE3
    executable: python
    args: "-u -m imas_muscle3.actors.source_component"
  metis:
    script: |
      #!/bin/bash
      module purge
      module load PDS-METIS IMAS-AL-Matlab/5.3.0-intel-2023b-DD-4.0.0
      # IMAS-AL-Matlab's dependency chain (via IMAS-AL-Core -> SciPy-bundle)
      # sets PYTHONPATH to its own numpy; matlab's pyenv(...) below inherits
      # this process's environment even in InProcess mode, so it would try
      # to import that mismatched numpy under $EBROOTMETIS/muscle3_venv's
      # own Python otherwise. Confirmed empirically: unsetting it here fixes
      # it.
      unset PYTHONPATH
      # metis4muscle3.m talks to the manager via Python's real libmuscle
      # (see `pyenv(...)` below), NOT a matlab-native MUSCLE3 client -- so
      # this must be a Python whose libmuscle version matches the actual
      # muscle_manager (0.10.0, from PDS-IMAS-MUSCLE3) exactly, or
      # registration fails with a wire-protocol "Unknown session X
      # requested" error (confirmed). It also must be a Python version
      # MATLAB's `py.*` bridge actually supports (3.9-3.11 for this
      # MATLAB/2023b-r5) -- 3.13, what PDS-IMAS-MUSCLE3's own venv uses, is
      # not supported by any MATLAB version installed on this cluster
      # (confirmed against MathWorks' own compatibility table; not even
      # MATLAB/2025b-r1 goes past 3.12). $EBROOTMETIS/muscle3_venv (built by
      # build_metis.sh) is a small, dedicated Python-3.11 venv with just
      # `muscle3==0.10.0` pip-installed, to satisfy both constraints at
      # once -- instead of PDS-IMAS-MUSCLE3's venv (wrong Python version) or
      # whatever `python` happens to be on PATH (previously "worked" only
      # via a personal, stale ~/.local pip install of libmuscle 0.8.0 -- a
      # real version mismatch against the real 0.10.0 manager, the actual
      # root cause of the "Unknown session" error).
      exec matlab -batch "pyenv('Version','$EBROOTMETIS/muscle3_venv/bin/python','ExecutionMode','InProcess');addpath(getenv('DIR_METIS4MUSCLE3'));metis4muscle3(2);"
resources:
  source_metis:
    threads: 1
  sink_metis:
    threads: 1
  metis:
    threads: 10
  
