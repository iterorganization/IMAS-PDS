ymmsl_version: v0.2

# Generic settings for plasmaless_controller, stacked after workflow.ymmsl by
# bin/pds-create-case / bin/pds-run. ${SHOT} is filled in by pds-create-case. As for
# evolutive_controller, the pulse window (source.t_min/t_max, plasmaless.t_end) is
# per-shot: every shot needs cases/overrides/plasmaless_controller_<shot>.ymmsl.

settings:
  # Initial state: preprocess.sh (run once by bin/pds-create-case) reads the NICE
  # inverse equilibrium and pf_active (nice_out) of a completed
  # metis_nice_inverse_from_dina run for the same shot (cases/runs/<case> convention of
  # bin/pds-create-case / bin/pds-run-case.sbatch) in the window source.t_min/t_max
  # (below and in the case override), applies this directory's waveforms.yaml
  # (equilibrium time slices passed through; pf_active = machine description of
  # pds-scenarios ${SHOT}/data/in_md with the inverse coil currents/voltages) and writes
  # the result to ${CASE_DIR}/preprocess/initial_state. Nothing is read from
  # ${SHOT}/data/in. source sends that entry as one whole-window message per IDS
  # (iterative: False); the entry holds only the window, so the same t_min/t_max select
  # all of it.
  source.source_uri: "imas:hdf5?path=${CASE_DIR}/preprocess/initial_state"
  source.iterative: False
  source.t_min: 0.0

  # Plasmaless model: step and exchange period (must be equal), same value as
  # nice_evo_rd in evolutive_controller.
  plasmaless.dt: 0.01
  plasmaless.t_interval: 0.01
  # Model machine description (em_coupling, pf_active, pf_passive, DD 4): not set here,
  # the actor's default is data/md_dd4 of the plasmaless repository it runs from
  # (local_installs/plasma-tokamak-circuits, or PLASMALESS_REPO if set; see the
  # plasmaless program in lib/local_programs.ymmsl).
  # Set plasmaless.md_uri to use another entry.
  # Optional actor settings (defaults are the actor's own; neither is set here):
  # - plasmaless.linear_model_dir (default empty): absolute path of a directory holding
  #   an external linear model (linear_model.json descriptor + A, B, C matrix files; see
  #   the plasmaless repository README, section "External linear model"). Empty or
  #   absent = the plasma-free coil+vessel circuit model built from the machine
  #   description (the default, used by plasmaless_controller_105084). A linear model is
  #   specific to one pulse and one time, so it is set per shot in
  #   cases/overrides/plasmaless_controller_<shot>.ymmsl (example:
  #   plasmaless_controller_105073.ymmsl, NICE linearisation of 105073 at 84.4176 s).
  # - plasmaless.operating_point (default descriptor; only with a linear model):
  #   descriptor = absolute coil currents, Ip and magnetic axis start at the model's
  #   linearisation point; f_init = start from the F_INIT scenario values at t0.

  # Output. `../../../` climbs out of the instance's own work directory, so the entries
  # land next to the run's logs in <run_dir>/ rather than under instances/.
  sink_equilibrium.sink_uri: "imas:hdf5?path=../../../out_plasmaless"
  sink_control.sink_uri: "imas:hdf5?path=../../../out_controller"
  sink_equilibrium.sink_mode: "w"
  sink_control.sink_mode: "w"

  # Live figures (m3dash): coil currents, passive loop currents and applied coil
  # voltages; the recorder writes Zarr stores under
  # <run_dir>/instances/recorder_plasmaless/workdir/<port>/.
  recorder_plasmaless.config: ${PDS_REPO}/visualization/plasmaless_currents.py

  muscle_remote_log_level: 'INFO'
