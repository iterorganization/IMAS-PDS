ymmsl_version: v0.2

# metis_convergence -- inverse pulse design converged against METIS transport.
#
# The same design graph inverse_convergence uses, with the `transport` role filled by
# METIS instead of TORAX. Everything else -- the outer loop, both NICE solves, the sinks,
# recorders and validator -- is identical.
#
#   muscle_manager --start-all $PDS_REPO/cases/<shot>_metis_convergence.ymmsl
#
# METIS emits one time slice per reuse iteration where the design loop expects a whole
# trace; `transport_metis` bridges the two with a driver actor -- see its ports:
#
#   equilibrium_in_f    every received slice is interpolated to METIS's current time, so a
#                       whole trace works.
#   core_profiles_in_f  only the LAST slice is read, then accumulated across reuse
#   core_sources_in_f   iterations. A whole trace is silently truncated.
#   *_out_f             one slice per reuse iteration, never a whole trace.
#
# METIS runs one reuse iteration per slice, in time order, because it carries state
# between calls. It decodes received IDSs with imas_deserialize, which it does not ship:
# that comes from the IMAS Access Layer MATLAB HLI (IMAS-AL-Matlab).

imports:
- from imas_muscle3 import implementation source_component
- from imas_muscle3 import implementation sink_component
- from imas_muscle3 import implementation recorder_component
- from imas_muscle3 import implementation olc_component
- from lib.easybuild_programs import implementation loop
- from lib.easybuild_programs import implementation waveform_editor
- from lib.easybuild_programs import implementation nice_inv
- from lib.easybuild_programs import implementation load_balancer
- from lib.easybuild_programs import implementation metis
- from lib.easybuild_programs import implementation metis_driver

models:
  nice_inverse:
    description: NICE inverse solve, load-balanced over N workers
    ports:
      f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
      o_f: [equilibrium_out, pf_active_out]
    components:
      load_balancer:
        description: IMAS-aware NICE load balancer -- scatters slices, gathers results
        implementation: load_balancer
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_i: [equilibrium_scatter, wall_scatter, pf_active_scatter, pf_passive_scatter, iron_core_scatter]
          s: [equilibrium_gather, pf_active_gather]
          o_f: [equilibrium_out_f, pf_active_out_f]
      nice:
        description: NICE inverse worker
        implementation: nice_inv
        multiplicity: [1]
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_f: [equilibrium_out, pf_active_out]
    conduits:
      # model input ports -> load balancer
      equilibrium_in: load_balancer.equilibrium_in
      wall_in: load_balancer.wall_in
      pf_active_in: load_balancer.pf_active_in
      pf_passive_in: load_balancer.pf_passive_in
      iron_core_in: load_balancer.iron_core_in
      # scatter to the workers
      load_balancer.equilibrium_scatter: nice.equilibrium_in
      load_balancer.wall_scatter: nice.wall_in
      load_balancer.pf_active_scatter: nice.pf_active_in
      load_balancer.pf_passive_scatter: nice.pf_passive_in
      load_balancer.iron_core_scatter: nice.iron_core_in
      # gather from the workers
      nice.equilibrium_out: load_balancer.equilibrium_gather
      nice.pf_active_out: load_balancer.pf_active_gather
      # load balancer -> model output ports
      load_balancer.equilibrium_out_f: equilibrium_out
      load_balancer.pf_active_out_f: pf_active_out

  transport_metis:
    description: METIS filling the design transport role, driven slice-by-slice
    ports:
      f_init: [equilibrium_in_f, core_profiles_in_f, core_sources_in_f]
      o_f: [equilibrium_out_f, core_profiles_out_f]
    components:
      source_ps:
        description: the METIS pulse_schedule, from the scenario's metis_in entry
        implementation: source_component
        ports: {o_f: [pulse_schedule_out]}
      driver:
        description: splits the traces, calls METIS per slice, reassembles
        implementation: metis_driver
        ports:
          f_init: [equilibrium_in, core_profiles_in, core_sources_in, pulse_schedule_in]
          o_i: [equilibrium_call, core_profiles_call, core_sources_call, pulse_schedule_call]
          s: [equilibrium_reply, core_profiles_reply]
          o_f: [equilibrium_out_f, core_profiles_out_f]
      metis:
        description: METIS transport actor -- one reuse iteration per time slice
        implementation: metis
        # Both the *_f_init and *_in_f sets, fed the same slice: both carry operator F_INIT
        # (init vs input is METIS's own bookkeeping, not MUSCLE3's), and METIS picks its
        # running mode from a connected `_f_init` port carrying a timestamp. With only the
        # _in_f set wired it assumes replay mode and exits looking for a saved data file.
        #
        # o_i, NOT o_f: equilibrium_out_f is a finalisation port, sent once when the whole
        # run ends. equilibrium_out_i is written every reuse iteration, which is what a
        # per-slice conversation needs.
        ports:
          f_init: [pulse_schedule_f_init, pulse_schedule_in_f,
                   equilibrium_f_init, equilibrium_in_f,
                   core_profiles_in_f, core_sources_in_f]
          o_i: [equilibrium_out_i]
    conduits:
      # model input ports -> driver
      equilibrium_in_f: driver.equilibrium_in
      core_profiles_in_f: driver.core_profiles_in
      core_sources_in_f: driver.core_sources_in
      # the pulse programme, which the design graph does not carry
      source_ps.pulse_schedule_out: driver.pulse_schedule_in
      # driver -> METIS, one slice per call: pulse_schedule drives METIS's clock,
      # core_profiles/core_sources constrain it, and the equilibrium is NICE's solve.
      #
      # The equilibrium also needs `metis_external_data_equilibrium: 1` in the case: METIS
      # requires both a connected port and that setting, so wiring alone does nothing.
      driver.equilibrium_call: [metis.equilibrium_f_init, metis.equilibrium_in_f]
      driver.core_profiles_call: metis.core_profiles_in_f
      driver.core_sources_call: metis.core_sources_in_f
      driver.pulse_schedule_call: [metis.pulse_schedule_f_init, metis.pulse_schedule_in_f]
      # METIS -> driver, one slice per reply. core_profiles is not requested back, so the
      # driver echoes the trace it was given on that lane.
      metis.equilibrium_out_i: driver.equilibrium_reply
      # driver -> model output ports
      driver.equilibrium_out_f: equilibrium_out_f
      driver.core_profiles_out_f: core_profiles_out_f

  design:
    description: Inverse pulse design, converged against METIS transport.
    components:
      source:
        description: source -- seeds the equilibrium and core_profiles traces
        implementation: source_component
        ports: {o_i: [equilibrium_out, core_profiles_out]}

      loop:
        description: outer convergence loop (SEL submodel)
        implementation: loop
        ports:
          f_init: [equilibrium_in_f, core_profiles_in_f]
          o_i: [equilibrium_out_i, core_profiles_out_i]
          s: [pf_active_in_s, equilibrium_in_s, core_profiles_in_s]
          o_f: [equilibrium_out_f, pf_active_out_f, core_profiles_out_f, equilibrium_target_out_f]

      waveform_editor:
        description: waveform editor (designed Ip/B0 + imported heating + static machine description + coil-current seed)
        implementation: waveform_editor
        ports:
          f_init: [equilibrium_in, core_profiles_in]
          o_f: [equilibrium_out, core_sources_out, core_profiles_out, wall_out, pf_passive_out, iron_core_out, pf_active_out]

      solve:
        description: NICE inverse solve (load-balanced over N workers)
        implementation: nice_inverse
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_f: [equilibrium_out, pf_active_out]

      transport:
        description: METIS transport, driven slice-by-slice behind the whole-trace interface
        implementation: transport_metis
        ports:
          f_init: [equilibrium_in_f, core_profiles_in_f, core_sources_in_f]
          o_f: [equilibrium_out_f, core_profiles_out_f]

      sink_nice:
        description: sink -- NICE inverse outputs
        implementation: sink_component
        ports: {f_init: [equilibrium_in, pf_active_in]}

      rec_nice:
        description: distill recorder (NICE inverse outputs)
        implementation: recorder_component
        ports: {s: [equilibrium_in, pf_active_in]}

      sink_torax:
        description: sink -- converged pulse
        implementation: sink_component
        optional: true
        ports: {f_init: [equilibrium_in, pf_active_in, core_profiles_in]}

      rec_torax:
        description: distill recorder (METIS per-step outputs)
        implementation: recorder_component
        optional: true
        ports: {s: [equilibrium_in, core_profiles_in]}

      validator:
        description: imas-validator on the converged coil currents
        implementation: olc_component
        optional: true
        ports: {f_init: [pf_active_in]}

      we_final:
        description: waveform editor -- machine description for the final pass (replaces md_final)
        implementation: waveform_editor
        optional: true
        ports:
          f_init: [pf_active_in]
          o_f: [wall_out, pf_passive_out, iron_core_out]

      final_solve:
        description: NICE inverse solve, linear-model output (load-balanced over N workers)
        implementation: nice_inverse
        optional: true
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_f: [equilibrium_out, pf_active_out]

    conduits:
      source.equilibrium_out: loop.equilibrium_in_f
      source.core_profiles_out: loop.core_profiles_in_f

      loop.equilibrium_out_i: waveform_editor.equilibrium_in
      loop.core_profiles_out_i: waveform_editor.core_profiles_in

      waveform_editor.equilibrium_out: solve.equilibrium_in
      waveform_editor.wall_out: solve.wall_in
      waveform_editor.pf_passive_out: solve.pf_passive_in
      waveform_editor.iron_core_out: solve.iron_core_in
      waveform_editor.pf_active_out: solve.pf_active_in
      waveform_editor.core_sources_out: transport.core_sources_in_f
      waveform_editor.core_profiles_out: transport.core_profiles_in_f

      solve.equilibrium_out: [transport.equilibrium_in_f, rec_nice.equilibrium_in, sink_nice.equilibrium_in]
      solve.pf_active_out: [loop.pf_active_in_s, rec_nice.pf_active_in, sink_nice.pf_active_in]

      transport.equilibrium_out_f: [loop.equilibrium_in_s, rec_torax.equilibrium_in]
      transport.core_profiles_out_f: [loop.core_profiles_in_s, rec_torax.core_profiles_in]

      loop.equilibrium_out_f: sink_torax.equilibrium_in
      loop.core_profiles_out_f: sink_torax.core_profiles_in
      loop.pf_active_out_f: [sink_torax.pf_active_in, final_solve.pf_active_in, we_final.pf_active_in, validator.pf_active_in]
      loop.equilibrium_target_out_f: final_solve.equilibrium_in

      we_final.wall_out: final_solve.wall_in
      we_final.pf_passive_out: final_solve.pf_passive_in
      we_final.iron_core_out: final_solve.iron_core_in

  metis_convergence:
    description: Inverse pulse design converged against METIS transport.
    components:
      run:
        description: the design coupling
        implementation: design
        ports: {}   # design has no model ports; everything is internal
