#!/bin/bash
# pds-inverse -- run the inverse_convergence workflow for one scenario (shot).
#
# Stacks the static workflow.ymmsl, the shared settings.ymmsl knobs and the scenario's
# settings.ymmsl data paths, expanding ${PDS_REPO} and ${SCEN} in each (MUSCLE3 does not
# interpolate settings and runs each instance in its own work_dir, so paths must be
# absolute). The manager creates its own run_<model>_<timestamp>/ in the runs directory.
#
#   pds-inverse [shot]           # shot defaults to $SHOT_NR, else 105084
#
# PDS_REPO defaults to this script's repo (its parent dir); export it to pin a fixed install.
# Runs land in $PDS_RUNS (default <repo>/../runs/pds_inverse) -- alongside the repo on the
# shared filesystem, kept out of the repo tree but not under node-local $HOME.
set -euo pipefail

PDS_REPO="${PDS_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export PDS_REPO
WF="$PDS_REPO/workflows/inverse_convergence"
export SHOT="${1:-${SHOT_NR:-105084}}"
export SCEN="$WF/scenarios/$SHOT"
MANAGER="${MANAGER:-$PDS_REPO/../opt/venv-m3091-actors/bin/muscle_manager}"
RUNS="${PDS_RUNS:-$(dirname "$PDS_REPO")/runs/pds_inverse}"
[[ -d "$SCEN" ]] || { echo "pds-inverse: no scenario dir $SCEN" >&2; exit 1; }

gen=$(mktemp -d); trap 'rm -rf "$gen"' EXIT
stack=()
i=0
for f in "$WF/workflow.ymmsl" "$WF/settings.ymmsl" "$SCEN/settings.ymmsl"; do
  out="$gen/$(printf '%02d_%s' "$i" "$(basename "$f")")"
  envsubst '${PDS_REPO} ${SCEN} ${SHOT}' < "$f" > "$out"
  stack+=("$out"); i=$((i + 1))
done

# The `we` actor reads its waveform config by path (the we.waveforms setting), not as a
# stacked file, but that config also contains ${SCEN}; expand it too and override
# we.waveforms to point at the expanded copy (last in the stack wins).
if [[ -f "$SCEN/waveforms.yaml" ]]; then
  envsubst '${PDS_REPO} ${SCEN} ${SHOT}' < "$SCEN/waveforms.yaml" > "$gen/waveforms.yaml"
  printf 'ymmsl_version: v0.2\nsettings: {we.waveforms: %s}\n' "$gen/waveforms.yaml" > "$gen/99_we.ymmsl"
  stack+=("$gen/99_we.ymmsl")
fi

mkdir -p "$RUNS"; cd "$RUNS"   # manager creates run_<model>_<timestamp>/ here
"$MANAGER" --start-all "${stack[@]}"
