#!/bin/bash
# pds-run-case -- submit a case folder (built by bin/pds-create-case) as a Slurm job.
#
#   pds-run-case <case-dir> [overlay.ymmsl ...]
#   e.g. pds-run-case cases/inverse_convergence_105073
#
# Thin `sbatch` wrapper around bin/pds-run-case.sbatch -- see that script's header for what
# actually happens once the job starts. If sbatch isn't on PATH (no Slurm on this machine),
# runs bin/pds-run-case.sbatch directly under bash instead. To override Slurm resources
# (time, cpus, ...), submit bin/pds-run-case.sbatch directly instead:
#
#   sbatch --time=00:20:00 --cpus-per-task=8 bin/pds-run-case.sbatch cases/prescribed_transport_105084
#
#   pds-run-case --postprocess-only <case-dir> [<run-dir>]
#   e.g. pds-run-case --postprocess-only cases/inverse_convergence_105073
#
# Skips submission entirely: just re-runs the generic + hook postprocessing (via
# bin/pds-postprocess) for an existing run, no Slurm job involved.
set -euo pipefail

[[ $# -ge 1 ]] || { echo "usage: $0 <case-dir> [overlay.ymmsl ...]" >&2; exit 1; }

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "$1" == "--postprocess-only" ]]; then
  shift
  exec "$BIN_DIR/pds-postprocess" "$@"
fi

if command -v sbatch >/dev/null 2>&1; then
  exec sbatch "$BIN_DIR/pds-run-case.sbatch" "$@"
else
  exec bash "$BIN_DIR/pds-run-case.sbatch" "$@"
fi
