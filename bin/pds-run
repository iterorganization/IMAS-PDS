#!/bin/bash
# pds-run -- run a MUSCLE3 workflow for one scenario (shot).
#
#   pds-run <workflow> [shot]        # shot defaults to $SHOT_NR if unset
#   e.g. pds-run inverse_convergence 105084
#
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: pds-run <workflow> [shot]" >&2
  exit 1
fi

PDS_REPO="${PDS_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export PDS_REPO

gen=$(mktemp -d); trap 'rm -rf "$gen"' EXIT

mkdir -p "$gen/lib"
envsubst '/home/ITER/blokhus/public/pds ${SCEN} ${SHOT}' \
  < "$PDS_REPO/workflows/lib/local_programs.ymmsl" > "$gen/lib/local_programs.ymmsl"

export YMMSL_PATH="$gen:$PDS_REPO/workflows${YMMSL_PATH:+:$YMMSL_PATH}"
WF_NAME="$1"
WF="$PDS_REPO/workflows/$WF_NAME"
export SHOT="${2:-${SHOT_NR:-}}"
[[ -n "$SHOT" ]] || { echo "pds-run: no shot given and \$SHOT_NR unset" >&2; exit 1; }
export SCEN="$WF/scenarios/$SHOT"

if [[ -z "${MANAGER:-}" ]]; then
  : "${PDS_MODULEPATH:=/home/ITER/blokhus/public/modules/all}"
  if [[ -z "${EBROOTIMASMINMUSCLE3:-}" ]]; then
    LMOD_INIT="/usr/share/lmod/lmod/init/bash"
    if [[ -f "$LMOD_INIT" ]]; then
      source "$LMOD_INIT"
      module use "$PDS_MODULEPATH" 2>/dev/null || true
      module load IMAS-MUSCLE3/1.0.0-intel-2025b-pds 2>/dev/null || true
    fi
  fi
  : "${EBROOTIMASMINMUSCLE3:?pds-run: IMAS-MUSCLE3/1.0.0-intel-2025b-pds not loaded and could not be loaded automatically -- run 'module use $PDS_MODULEPATH && module load PDS' first}"
  MANAGER="$(command -v muscle_manager)"
  : "${MANAGER:?pds-run: muscle_manager not on PATH even though IMAS-MUSCLE3 is loaded -- its MUSCLE3 dependency is missing}"
fi
RUNS="${PDS_RUNS:-$SCEN/tmp/runs}"
[[ -d "$WF" ]] || { echo "pds-run: no workflow dir $WF" >&2; exit 1; }
[[ -d "$SCEN" ]] || { echo "pds-run: no scenario dir $SCEN" >&2; exit 1; }

stack=()
i=0
for f in "$WF/workflow.ymmsl" "$WF/settings.ymmsl"; do
  out="$gen/$(printf '%02d_%s' "$i" "$(basename "$f")")"
  envsubst '/home/ITER/blokhus/public/pds ${SCEN} ${SHOT}' < "$f" > "$out"
  stack+=("$out"); i=$((i + 1))
done
if [[ -f "$SCEN/settings.ymmsl" ]]; then
  out="$gen/$(printf '%02d_%s' "$i" "settings.ymmsl")"
  envsubst '/home/ITER/blokhus/public/pds ${SCEN} ${SHOT}' < "$SCEN/settings.ymmsl" > "$out"
  stack+=("$out"); i=$((i + 1))
fi

waveforms_src=""
[[ -f "$SCEN/waveforms.yaml" ]] && waveforms_src="$SCEN/waveforms.yaml"
[[ -z "$waveforms_src" ]] && [[ -f "$WF/waveforms.yaml" ]] && waveforms_src="$WF/waveforms.yaml"
if [[ -n "$waveforms_src" ]]; then
  envsubst '/home/ITER/blokhus/public/pds ${SCEN} ${SHOT}' < "$waveforms_src" > "$gen/waveforms.yaml"
  printf 'ymmsl_version: v0.2\nsettings: {waveform_editor.waveforms: %s}\n' "$gen/waveforms.yaml" > "$gen/99_waveform_editor.ymmsl"
  stack+=("$gen/99_waveform_editor.ymmsl")
fi

mkdir -p "$RUNS"; cd "$RUNS"
"$MANAGER" --start-all "${stack[@]}"
