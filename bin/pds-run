#!/bin/bash
# pds-run -- run a MUSCLE3 workflow for one scenario (shot).
#
# Stacks the workflow's static workflow.ymmsl, its shared settings.ymmsl knobs and the
# scenario's settings.ymmsl (if present), expanding ${PDS_REPO}, ${SCEN} and ${SHOT} in each
# (MUSCLE3 does not interpolate settings and runs each instance in its own work_dir, so paths
# must be absolute). The manager creates its own run_<model>_<timestamp>/ in the runs directory.
#
#   pds-run <workflow> [shot]        # shot defaults to $SHOT_NR if unset
#
# e.g. pds-run inverse_convergence 105084
#      pds-run prescribed_transport 105073
#
# PDS_REPO defaults to this script's repo (its parent dir); export it to pin a fixed install.
# Runs land in $PDS_RUNS (default <scenario>/tmp/runs).
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: pds-run <workflow> [shot]" >&2
  exit 1
fi

PDS_REPO="${PDS_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export PDS_REPO

gen=$(mktemp -d); trap 'rm -rf "$gen"' EXIT

# lib.local_programs' actors reference $PDS_REPO directly (e.g. `args: -u
# $PDS_REPO/workflows/inverse_convergence/nice_load_balancer.py`), expanded by bash inside
# each actor's own generated launch script -- which runs *after* that actor's own
# `base_env: clean` (a `module purge`), and Lmod's purge unconditionally unsets whatever
# setenv() PDS.lua did, including $PDS_REPO, regardless of how it was set or re-exported
# since (confirmed empirically: a plain `export PDS_REPO=$PDS_REPO` before the purge does
# not survive it either -- Lmod purge just re-runs PDS.lua in unload mode). So $PDS_REPO
# must never be a *live* shell reference by the time an actor's script runs. Substitute it
# to a literal path here, once, before the manager ever starts, the same way the stack
# below already does for workflow.ymmsl/settings.ymmsl/waveforms.yaml.
mkdir -p "$gen/lib"
envsubst '${PDS_REPO} ${SCEN} ${SHOT}' \
  < "$PDS_REPO/workflows/lib/local_programs.ymmsl" > "$gen/lib/local_programs.ymmsl"

# Workflows resolve `imports: - from lib.<...> import implementation <...>` (e.g.
# lib.local_programs) against YMMSL_PATH, which the manager consults when it loads the
# stacked config files below. $gen first, so lib.local_programs resolves to the
# substituted copy above instead of the raw checked-in one; anything else under lib/ (not
# overridden there) still falls through to the real checkout right after it.
export YMMSL_PATH="$gen:$PDS_REPO/workflows${YMMSL_PATH:+:$YMMSL_PATH}"
WF_NAME="$1"
WF="$PDS_REPO/workflows/$WF_NAME"
export SHOT="${2:-${SHOT_NR:-}}"
[[ -n "$SHOT" ]] || { echo "pds-run: no shot given and \$SHOT_NR unset" >&2; exit 1; }
export SCEN="$WF/scenarios/$SHOT"

# muscle_manager 0.10.0 (to match the actors) comes from the self-contained
# IMAS-MUSCLE3 venv (built by setup_imas_muscle3.sh) whenever it's present --
# its python has a clean sys.path, so it can't leak a foreign numpy build into
# the actor subprocesses it spawns (each of which activates its own venv via
# `. venv/bin/activate`, which only prepends PATH and does not touch
# PYTHONPATH). Falls back to the EasyBuild MUSCLE3 module -- published under
# the not-yet-default modules-2025b tree -- if that venv isn't there; in that
# case its PYTHONPATH (a python3.13 SciPy-bundle tree) does leak into and break
# the python3.11 actor venvs, so this path is best avoided.
if [[ -z "${MANAGER:-}" ]]; then
  MANAGER="$PDS_REPO/run/IMAS-MUSCLE3/venv/bin/muscle_manager"
  if [[ ! -x "$MANAGER" ]]; then
    LMOD_INIT="/usr/share/lmod/lmod/init/bash"
    if [[ -f "$LMOD_INIT" ]]; then
      # shellcheck source=/usr/share/lmod/lmod/init/bash
      source "$LMOD_INIT"
      module use /work/imas/etc/modules-2025b/all 2>/dev/null || true
      module load MUSCLE3/0.10.0-intel-2025b 2>/dev/null || true
    fi
    MANAGER="${EBROOTMUSCLE3:+$EBROOTMUSCLE3/bin/muscle_manager}"
    MANAGER="${MANAGER:-$PDS_REPO/run/IMAS-MUSCLE3/venv/bin/muscle_manager}"
  fi
fi
RUNS="${PDS_RUNS:-$SCEN/tmp/runs}"
[[ -d "$WF" ]] || { echo "pds-run: no workflow dir $WF" >&2; exit 1; }
[[ -d "$SCEN" ]] || { echo "pds-run: no scenario dir $SCEN" >&2; exit 1; }

stack=()
i=0
for f in "$WF/workflow.ymmsl" "$WF/settings.ymmsl"; do
  out="$gen/$(printf '%02d_%s' "$i" "$(basename "$f")")"
  envsubst '${PDS_REPO} ${SCEN} ${SHOT}' < "$f" > "$out"
  stack+=("$out"); i=$((i + 1))
done
if [[ -f "$SCEN/settings.ymmsl" ]]; then
  out="$gen/$(printf '%02d_%s' "$i" "settings.ymmsl")"
  envsubst '${PDS_REPO} ${SCEN} ${SHOT}' < "$SCEN/settings.ymmsl" > "$out"
  stack+=("$out"); i=$((i + 1))
fi

# The `waveform_editor` actor reads its waveform config by path (the waveform_editor.waveforms
# setting), not as a stacked file, but that config also contains ${SCEN}; expand it too and
# override waveform_editor.waveforms to point at the expanded copy (last in the stack wins).
waveforms_src=""
[[ -f "$SCEN/waveforms.yaml" ]] && waveforms_src="$SCEN/waveforms.yaml"
[[ -z "$waveforms_src" ]] && [[ -f "$WF/waveforms.yaml" ]] && waveforms_src="$WF/waveforms.yaml"
if [[ -n "$waveforms_src" ]]; then
  envsubst '${PDS_REPO} ${SCEN} ${SHOT}' < "$waveforms_src" > "$gen/waveforms.yaml"
  printf 'ymmsl_version: v0.2\nsettings: {waveform_editor.waveforms: %s}\n' "$gen/waveforms.yaml" > "$gen/99_waveform_editor.ymmsl"
  stack+=("$gen/99_waveform_editor.ymmsl")
fi

mkdir -p "$RUNS"; cd "$RUNS"   # manager creates run_<model>_<timestamp>/ here
"$MANAGER" --start-all "${stack[@]}"
