#!/bin/bash
# pds-run -- run a MUSCLE3 workflow for one scenario (shot).
#
# Stacks workflow.ymmsl + settings.ymmsl (+ scenario overrides), expanding
# ${PDS_REPO}/${SCEN}/${SHOT} since MUSCLE3 doesn't interpolate settings itself.
#
#   pds-run <workflow> [shot]        # shot defaults to $SHOT_NR if unset
#   e.g. pds-run inverse_convergence 105084
#
# PDS_REPO defaults to this script's repo; PDS_RUNS controls where runs land
# (default <scenario>/tmp/runs).
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: pds-run <workflow> [shot]" >&2
  exit 1
fi

PDS_REPO="${PDS_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export PDS_REPO

gen=$(mktemp -d); trap 'rm -rf "$gen"' EXIT

# $PDS_REPO must be a literal path here, not a live shell var: an actor's own
# `base_env: clean` (a `module purge`) unsets whatever PDS.lua's setenv() did,
# $PDS_REPO included, before that actor's script runs.
mkdir -p "$gen/lib"
envsubst '${PDS_REPO} ${SCEN} ${SHOT}' \
  < "$PDS_REPO/workflows/lib/local_programs.ymmsl" > "$gen/lib/local_programs.ymmsl"

# $gen first in YMMSL_PATH, so `imports: - from lib.local_programs import ...`
# resolves to the substituted copy above; anything else under lib/ falls
# through to the real checkout.
export YMMSL_PATH="$gen:$PDS_REPO/workflows${YMMSL_PATH:+:$YMMSL_PATH}"
WF_NAME="$1"
WF="$PDS_REPO/workflows/$WF_NAME"
export SHOT="${2:-${SHOT_NR:-}}"
[[ -n "$SHOT" ]] || { echo "pds-run: no shot given and \$SHOT_NR unset" >&2; exit 1; }
export SCEN="$WF/scenarios/$SHOT"

# muscle_manager must come from PDS-IMAS-MUSCLE3's own venv (matching version 0.10.0,
# clean PYTHONPATH) -- never the official MUSCLE3 module, which leaks a numpy build
# that breaks the actor venvs (see setup_files/PDS.lua). Uses $EBROOTIMASMUSCLE3 if
# already set (module load PDS already ran); otherwise loads PDS-IMAS-MUSCLE3 directly.
if [[ -z "${MANAGER:-}" ]]; then
  : "${PDS_MODULEPATH:=/home/ITER/blokhus/public/modules}"
  if [[ -z "${EBROOTIMASMUSCLE3:-}" ]]; then
    LMOD_INIT="/usr/share/lmod/lmod/init/bash"
    if [[ -f "$LMOD_INIT" ]]; then
      # shellcheck source=/usr/share/lmod/lmod/init/bash
      source "$LMOD_INIT"
      module use "$PDS_MODULEPATH" 2>/dev/null || true
      module load PDS-IMAS-MUSCLE3 2>/dev/null || true
    fi
  fi
  : "${EBROOTIMASMUSCLE3:?pds-run: PDS-IMAS-MUSCLE3 not loaded and could not be loaded automatically -- run 'module use $PDS_MODULEPATH && module load PDS' first}"
  MANAGER="$EBROOTIMASMUSCLE3/venv/bin/muscle_manager"
fi
RUNS="${PDS_RUNS:-$SCEN/tmp/runs}"
[[ -d "$WF" ]] || { echo "pds-run: no workflow dir $WF" >&2; exit 1; }
[[ -d "$SCEN" ]] || { echo "pds-run: no scenario dir $SCEN" >&2; exit 1; }

stack=()
i=0
for f in "$WF/workflow.ymmsl" "$WF/settings.ymmsl"; do
  out="$gen/$(printf '%02d_%s' "$i" "$(basename "$f")")"
  envsubst '${PDS_REPO} ${SCEN} ${SHOT}' < "$f" > "$out"
  stack+=("$out"); i=$((i + 1))
done
if [[ -f "$SCEN/settings.ymmsl" ]]; then
  out="$gen/$(printf '%02d_%s' "$i" "settings.ymmsl")"
  envsubst '${PDS_REPO} ${SCEN} ${SHOT}' < "$SCEN/settings.ymmsl" > "$out"
  stack+=("$out"); i=$((i + 1))
fi

# waveforms.yaml is read by path, not stacked, but also contains ${SCEN} --
# expand it too and point waveform_editor.waveforms at the expanded copy.
waveforms_src=""
[[ -f "$SCEN/waveforms.yaml" ]] && waveforms_src="$SCEN/waveforms.yaml"
[[ -z "$waveforms_src" ]] && [[ -f "$WF/waveforms.yaml" ]] && waveforms_src="$WF/waveforms.yaml"
if [[ -n "$waveforms_src" ]]; then
  envsubst '${PDS_REPO} ${SCEN} ${SHOT}' < "$waveforms_src" > "$gen/waveforms.yaml"
  printf 'ymmsl_version: v0.2\nsettings: {waveform_editor.waveforms: %s}\n' "$gen/waveforms.yaml" > "$gen/99_waveform_editor.ymmsl"
  stack+=("$gen/99_waveform_editor.ymmsl")
fi

mkdir -p "$RUNS"; cd "$RUNS"   # manager creates run_<model>_<timestamp>/ here
"$MANAGER" --start-all "${stack[@]}"
