+def save_input_files(paths: Sequence[str], run_dir: RunDir) -> None:
+    """Copy the yMMSL files given on the command line into the run directory.
+
+    The run directory already gets configuration.ymmsl, but that is the resolved and
+    flattened configuration: imports inlined, custom implementations applied, nesting
+    collapsed. It is the right thing to feed back to the manager and the wrong thing to
+    read, being several times the size of what was actually written.
+
+    These copies are the inputs verbatim, numbered in the order they were given so the
+    merge order is visible, and kept under input/ so they cannot be confused with the
+    resolved configuration.
+    """
+    input_dir = run_dir.path / 'input'
+    input_dir.mkdir(exist_ok=True)
+    for i, path in enumerate(paths, start=1):
+        src = Path(path)
+        try:
+            shutil.copyfile(src, input_dir / f'{i}_{src.name}')
+        except OSError as e:
+            # Losing a provenance copy must not take down a run that is otherwise fine.
+            print(f'Warning: could not copy {src} into the run directory: {e}',
+                  file=sys.stderr)
+
+
