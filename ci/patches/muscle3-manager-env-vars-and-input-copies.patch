+_ENV_VAR_RE = re.compile(r"\$(\w+|\{[^}]*\})")
+
+
+def expand_settings(config: v0_2.Configuration) -> v0_2.Configuration:
+    """Expand environment variables in string setting values.
+
+    yMMSL setting values are otherwise used verbatim, and every component runs in its own
+    freshly-created work directory, so a configuration cannot refer to anything outside
+    itself without hardcoding an absolute path. Expanding ${VAR} here lets a committed
+    configuration name an install location that differs per machine.
+
+    An undefined variable is an error rather than a value passed through literally,
+    because the resulting failure would otherwise surface far from its cause.
+    """
+    undefined = set()
+    for name in list(config.settings):
+        value = config.settings[name]
+        if not isinstance(value, str):
+            continue
+        expanded = os.path.expandvars(value)
+        for match in _ENV_VAR_RE.finditer(expanded):
+            undefined.add(match.group(0))
+        config.settings[name] = expanded
+
+    if undefined:
+        names = ", ".join(sorted(undefined))
+        raise RuntimeError(
+            f"Undefined environment variable(s) in settings: {names}. Set them before"
+            " starting the manager, or replace them with literal values.")
+    return config
+
