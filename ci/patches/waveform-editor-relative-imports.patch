+
+    def _resolve_uri(self, source):
+        """Make a relative ``path=`` in an IMAS URI absolute, against ``base_dir``.
+
+        Lets a configuration refer to data next to it -- ``imas:hdf5?path=data/in`` --
+        instead of an absolute path that is only correct on one machine. Absolute paths,
+        port-imports and configurations not loaded from a file are returned unchanged.
+        """
+        if self.base_dir is None or not isinstance(source, str):
+            return source
+
+        def sub(match):
+            path = match.group(2)
+            if not path or os.path.isabs(path):
+                return match.group(0)
+            resolved = os.path.normpath(os.path.join(self.base_dir, path))
+            return f"{match.group(1)}{resolved}"
+
+        return re.sub(r"(\bpath=)([^&#\s]*)", sub, source)
 
