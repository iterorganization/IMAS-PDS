ymmsl_version: v0.2

# DINA shot 105084, inverse pulse design converged against TORAX transport.
#
#   export PDS_REPO=/path/to/pds
#   export SCENARIOS_REPO=/path/to/pds-scenarios
#   export YMMSL_PATH=$PDS_REPO/workflows
#   muscle_manager --start-all $PDS_REPO/cases/105084_convergence.ymmsl

imports:
- from inverse_convergence.workflow import implementation inverse_convergence

# Resources keys need the full root model name; settings keys do not (see docs/usage).
resources:
  inverse_convergence.workflow.inverse_convergence.equilibrium.nice: {threads: 2}
  inverse_convergence.workflow.inverse_convergence.transport.torax: {threads: 8}
  inverse_convergence.workflow.inverse_convergence.equilibrium.rec_nice: {threads: 1}
  inverse_convergence.workflow.inverse_convergence.rec_torax: {threads: 1}

settings:
  # Scenario: the pulse design and its input data.
  waveform_editor.waveforms: /home/ITER/blokhus/public/pds-scenarios/105084/waveforms.yaml
  source.source_uri: "imas:hdf5?path=/home/ITER/blokhus/public/pds-scenarios/105084/data/in"
  source.iterative: False

  # Convergence.
  loop.cold_start: False
  loop.max_iterations: 2
  loop.max_slices: 0
  loop.tolerance: 1000.0
  loop.rel_tolerance: 0.03

  # Solvers.
  equilibrium.nice.xml_path: /home/ITER/blokhus/public/pds/workflows/lib/config_nice_inverse.xml
  transport.torax.python_config_module: /home/ITER/blokhus/public/pds/workflows/lib/config_torax.py
  transport.torax.output_all_timeslices: True

  # Output. `../../../` climbs out of the instance's own work directory, so the entries
  # land next to the run's logs in <run_dir>/ rather than under instances/.
  sink_nice.sink_uri: "imas:hdf5?path=../../../out_nice"
  sink_nice.sink_mode: "w"
  sink_torax.sink_uri: "imas:hdf5?path=../../../out_torax"
  sink_torax.sink_mode: "w"

  # Recording.
  equilibrium.rec_nice.format: distill
  equilibrium.rec_nice.auto: False
  equilibrium.rec_nice.config: /home/ITER/blokhus/public/pds/visualization/nice_inv.py
  equilibrium.rec_nice.md: "wall=imas:hdf5?path=/home/ITER/blokhus/public/pds-scenarios/105084/data/in_md pf_active=imas:hdf5?path=/home/ITER/blokhus/public/pds-scenarios/105084/data/in_md"
  rec_torax.format: distill
  rec_torax.auto: False
  rec_torax.config: /home/ITER/blokhus/public/pds/visualization/kinetic_profiles.py

  # Validation.
  validator.halt_on_error: False
  validator.extra_rule_dirs: /home/ITER/blokhus/public/pds/pds_validation_tests
  validator.rulesets: iter-olc
  validator.apply_generic: False

  muscle_remote_log_level: 'INFO'
