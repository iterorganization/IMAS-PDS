<?xml version='1.0' encoding='UTF-8'?>
<EXCEPTIONS xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.ipp.mpg.de/2004/Schema/Exceptions_Desc" xsi:schemaLocation="http://www.ipp.mpg.de/2016/Schema/Exceptions.xsd">
	<!-- PROPOSAL (PSC-3): generated by ip_waveform_export from ip_105073_psc_D_eof; format of pcs@bb29ad6 TC01 PSCGlobalMonConfig.xml -->
	<SCENARIOS>
		<SCENARIO name="psc_glb_ps__run_plasma" output="glb_ps__run_plasma">
			<SCRIPT code="{plasma_exist.value} and {ip_ip__meas.value} &gt; 100000.0" />
		</SCENARIO>
	</SCENARIOS>
	<!-- SIGNAL_VALIDS: none generated: SignalValClass (ebf3ee0) uses wall-clock timers, an inverted RUNNING test and an undefined PcsQuality (SignalValClass.m:98-160) -->
	<SIGNAL_VALIDS />
	<MONITORINGS>
		<!-- ip_too_high: plasma current above 15.25 MA (D17 (1); TC01 has the same flag at 15e6) -->
		<MONITORING name="psc_glb_ip_too_high" output="glb_ps__ip_too_high">
			<SCRIPT code="{ip_ip__meas.value} &gt; 15250000.0" />
		</MONITORING>
		<!-- end_of_flux: run D: CS headroom below 8.30 kA (fires ~84.40 s in P2e-A) -->
		<MONITORING name="psc_glb_end_of_flux" output="glb_ps__end_of_flux">
			<SCRIPT code="{cs_margin.value} &lt; 8300.0 or {glb_ps__end_of_flux} == 1" />
		</MONITORING>
		<!-- z_excursion: DISABLED for run D (threshold 1 m) -->
		<MONITORING name="psc_glb_z_excursion" output="glb_ps__z_excursion">
			<SCRIPT code="abs({z_meas.value} - 0.261) &gt; 1.0 or ({glb_ps__z_excursion} == 1 and abs({z_meas.value} - 0.261) &gt; 0.5)" />
		</MONITORING>
	</MONITORINGS>
	<GOALS>
		<!-- simTime = the Simulink clock seen by the PSC block (PSCClass.execute) -->
		<GOAL name="psc_glb_NoAlarm" output="glb__PulseDone">
			<SCRIPT code="{simTime} &gt; 10.5" />
		</GOAL>
	</GOALS>
</EXCEPTIONS>
