<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- PROPOSAL (PSC-3): generated by ip_waveform_export from ip_105073_psc_D_eof -->
    <!-- modelled on pcs@bb29ad6 BTreeNominalWaveforms.xml + pcssp@2233365 BTreeFWHL.xml -->
    <!-- [1] sudden hard EH  [2] nominal segments || soft-EH overlays  [3] hard-EH list -->
    <!-- only these wd_time / wd_target are read by the PSC (parsePSXML.m:249-250) -->
    <!-- D20 window cut: PSC clock t = 0 at designer t = 84.317598 s (t_psc = t_designer - 84.317598 s); first kept segment 'flat-top' originally started at 79.217598 s, its POINTs shifted by -5.100000 s and its wd_time shortened by the same amount; dropped segments: none -->
    <BehaviorTree ID="BehaviorTree">
        <Fallback name="FallbackNomEH" Reactive="1">
            <Fallback name="FallHrdEHListSudden" Reactive="1">
                <Precondition name="IpTooHighHrdEHSudden" condition="{glb_ps__ip_too_high} == 1 and {current_segment} != 41 and {current_segment} != 99">
                    <ForceFailure>
                        <Sequence>
                            <Action ID="AssignValue" source="{current_segment}" target="{old_current_segment}" />
                            <Action ID="AssignValue" name="AssignIpTermination" source="41" target="{current_segment}" />
                        </Sequence>
                    </ForceFailure>
                </Precondition>
            </Fallback>
            <Parallel name="ParSegNom" threshold="1" mainTask="1">
                <Fallback name="FallNomSegList" Reactive="1">
                    <Precondition name="PrecondFlatTop" condition="{current_segment} == 0">
                        <SubTree ID="SubTreeSegFlatTop" />
                    </Precondition>
                    <Precondition name="PrecondStop" condition="{current_segment} == 99">
                        <SubTree ID="SubTreeSegStop" />
                    </Precondition>
                </Fallback>
                <Parallel name="ParSftEHList" threshold="1" mainTask="-1">
                    <Precondition name="EofRampdownSftEH" condition="{glb_ps__end_of_flux} == 1 and ({current_segment} == 0)">
                        <SubTree ID="SubTreeEofRampdown" />
                    </Precondition>
                    <Precondition name="ZHoldSftEH" condition="{glb_ps__z_excursion} == 1 and ({current_segment} == 0)">
                        <SubTree ID="SubTreeZHold" />
                    </Precondition>
                </Parallel>
            </Parallel>
            <Fallback name="FallHrdEHList" Reactive="1">
                <Precondition name="IpTerminationHrdEH" condition="{current_segment} == 41">
                    <SubTree ID="SubTreeIpTermination" />
                </Precondition>
                <Precondition name="EofTerminationHrdEH" condition="{current_segment} == 42">
                    <SubTree ID="SubTreeEofTermination" />
                </Precondition>
            </Fallback>
        </Fallback>
    </BehaviorTree>
    <BehaviorTree ID="SubTreeSegFlatTop" segmentID="0">
        <Action ID="RefGen" name="PathSegFlatTop" signal="all" segmentID="0" typeAddition="replace" wd_time="10.5" wd_target="99" />
    </BehaviorTree>
    <BehaviorTree ID="SubTreeSegStop" segmentID="99">
        <Action ID="RefGen" name="PathSegStop" signal="all" segmentID="99" typeAddition="replace" wd_time="5" wd_target="99" />
    </BehaviorTree>
    <BehaviorTree ID="SubTreeEofRampdown" segmentID="21">
        <Action ID="RefGen" name="PathEofRampdown" signal="Ipl_ref" segmentID="21" entryRule="Linear" typeAddition="silence,replace" wd_time="2" wd_target="42" />
    </BehaviorTree>
    <BehaviorTree ID="SubTreeZHold" segmentID="22">
        <Action ID="RefGen" name="PathZHold" signal="Ipl_ref" segmentID="22" entryRule="Step" typeAddition="silence,replace" condition="{glb_ps__z_excursion} == 0" wd_time="2" wd_target="41" />
    </BehaviorTree>
    <BehaviorTree ID="SubTreeIpTermination" segmentID="41">
        <Action ID="RefGen" name="PathIpTermination" signal="all" segmentID="41" entryRule="Linear" typeAddition="replace" wd_time="2.5" wd_target="99" />
    </BehaviorTree>
    <BehaviorTree ID="SubTreeEofTermination" segmentID="42">
        <Action ID="RefGen" name="PathEofTermination" signal="all" segmentID="42" entryRule="Linear" typeAddition="replace" wd_time="2.5" wd_target="99" />
    </BehaviorTree>
    <TreeNodesModel>
        <Action ID="AssignValue">
            <input_port name="source" />
            <input_port name="target" />
        </Action>
        <SubTree ID="SubTreeSegFlatTop" />
        <SubTree ID="SubTreeSegStop" />
        <SubTree ID="SubTreeEofRampdown" />
        <SubTree ID="SubTreeZHold" />
        <SubTree ID="SubTreeIpTermination" />
        <SubTree ID="SubTreeEofTermination" />
    </TreeNodesModel>
</root>
