<?xml version='1.0' encoding='UTF-8'?>
<EXCEPTIONS xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.ipp.mpg.de/2004/Schema/Exceptions_Desc" xsi:schemaLocation="http://www.ipp.mpg.de/2016/Schema/Exceptions.xsd">
	<!-- PROPOSAL (PSC-3): generated by ip_waveform_export from ip_105073_psc_F_story; format of pcs@bb29ad6 TC01 PSCGlobalMonConfig.xml -->
	<SCENARIOS>
		<SCENARIO name="psc_glb_ps__run_plasma" output="glb_ps__run_plasma">
			<SCRIPT code="{plasma_exist.value} and {ip_ip__meas.value} &gt; 100000.0" />
		</SCENARIO>
	</SCENARIOS>
	<!-- SIGNAL_VALIDS: none generated: SignalValClass (ebf3ee0) uses wall-clock timers, an inverted RUNNING test and an undefined PcsQuality (SignalValClass.m:98-160) -->
	<SIGNAL_VALIDS />
	<MONITORINGS>
		<!-- ip_too_high: plasma current above 15.5 MA (ours; nominal maximum 15.12 MA at 121.2 s in DINA, run-A KCURR overshoot <= 0.03 MA: armed, expected silent) -->
		<MONITORING name="psc_glb_ip_too_high" output="glb_ps__ip_too_high">
			<SCRIPT code="{ip_ip__meas.value} &gt; 15500000.0" />
		</MONITORING>
		<!-- end_of_flux: CS current headroom below 4.5 kA (ours, early on purpose: in run E the headroom fell from 5.27 kA at 115.8 s to 4.6 kA at 121.5 s (about 0.12 kA/s) and to 2.5 kA at 130.58 s, so 4.5 kA fires at about 122 s, 25 s before the DINA ramp-down start and leaving the whole termination inside the window); release 4.7 kA (hysteresis, moot under the latch); no debounce (not representable in the PSC global monitoring anyway) -->
		<MONITORING name="psc_glb_end_of_flux" output="glb_ps__end_of_flux">
			<SCRIPT code="{cs_margin.value} &lt; 4500.0 or ({glb_ps__end_of_flux} == 1 and {cs_margin.value} &lt; 4700.0) or {glb_ps__end_of_flux} == 1" />
		</MONITORING>
		<!-- z_excursion: current-centre Z more than 8 cm away from its reference (ours: run E showed a 4 cm geometric-axis excursion at the hard-segment entry and a 12 cm drift during the 0.61 MA/s termination; 8 cm is meant to stay silent during the overlay ramp-down and to catch a termination drift); release 4 cm (hysteresis), no latch so that z_hold can recover; reference = current-centre Z of the student's inverse run at 115.817598 s (job 1319725, see Zpl_ref). NOTE: the design current centre of that run falls with the nominal ramp-down (0.604 m at 136.8 s, 0.510 m at 155.4 s, 0.446 m at 160.5 s, 0.306 m at 176.4 s), so if the plasma follows the wrapper's time-based Z reference the event is expected to fire around 157-160 s (during segment 42): part of the story -->
		<MONITORING name="psc_glb_z_excursion" output="glb_ps__z_excursion">
			<SCRIPT code="abs({z_meas.value} - 0.5812) &gt; 0.08 or ({glb_ps__z_excursion} == 1 and abs({z_meas.value} - 0.5812) &gt; 0.04)" />
		</MONITORING>
	</MONITORINGS>
	<GOALS>
		<!-- simTime = the Simulink clock seen by the PSC block (PSCClass.execute) -->
		<GOAL name="psc_glb_NoAlarm" output="glb__PulseDone">
			<SCRIPT code="{simTime} &gt; 60.599999999999994" />
		</GOAL>
	</GOALS>
</EXCEPTIONS>
