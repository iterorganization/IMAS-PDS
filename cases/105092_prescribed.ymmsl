ymmsl_version: v0.2

# DINA shot 105092, boundary-prescribed pulse design, solved once with NICE inverse.
#
#   export PDS_REPO=/path/to/pds
#   export SCENARIOS_REPO=/path/to/pds-scenarios
#   export YMMSL_PATH=$PDS_REPO/workflows
#   muscle_manager --start-all $PDS_REPO/cases/105092_prescribed.ymmsl

imports:
- from prescribed_transport.workflow import implementation prescribed_transport

# Resources keys need the full root model name; settings keys do not (see docs/usage).
resources:
  prescribed_transport.workflow.prescribed_transport.equilibrium.nice: {threads: 2}
  prescribed_transport.workflow.prescribed_transport.equilibrium.rec_nice: {threads: 1}

settings:
  # Scenario: the pulse design and its input data.
  waveform_editor.waveforms: /home/ITER/blokhus/public/pds-scenarios/105092/waveforms_no_transport.yaml
  source.source_uri: "imas:hdf5?path=/home/ITER/blokhus/public/pds-scenarios/105092/data/in"
  source.iterative: false

  equilibrium.nice.xml_path: /home/ITER/blokhus/public/pds/workflows/lib/config_nice_inverse.xml

  # Output. `../../../` climbs out of the instance's own work directory, so the entries
  # land next to the run's logs in <run_dir>/ rather than under instances/.
  sink.sink_uri: "imas:hdf5?path=../../../out_nice"
  sink.sink_mode: "w"

  # Recording.
  equilibrium.rec_nice.format: distill
  equilibrium.rec_nice.auto: False
  equilibrium.rec_nice.config: /home/ITER/blokhus/public/pds/visualization/nice_inv.py
  equilibrium.rec_nice.md: "wall=imas:hdf5?path=/home/ITER/blokhus/public/pds-scenarios/105092/data/in_md pf_active=imas:hdf5?path=/home/ITER/blokhus/public/pds-scenarios/105092/data/in_md"

  muscle_remote_log_level: 'INFO'
