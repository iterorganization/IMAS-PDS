ymmsl_version: v0.2
# PSC run D_eof for preprocessing/psps/psc_run/run_psc_evolutive.sh: the four PSC files written by
# make_psc_variants.py (converter --cut-at 84.317598 --psc-config).
# ${PDS_REPO} is expanded by run_psc_evolutive.sh with envsubst (as bin/pds-create-case does); for a
# direct bin/pds-run-case call run envsubst '${PDS_REPO}' < this_file > expanded.ymmsl first.
settings:
  magnetic_controller.psc_enabled: 1
  magnetic_controller.psc_config_dir: "${PDS_REPO}/cases/input/psc/D_eof/psc_config_ip_105073_psc_D_eof"
  # the 8.3 kA CS margin is reached at ~90.4 s in this case (CS1): run past the rampdown and the
  # termination (STOP at ~94.9 s) instead of the case window, which ends at 87 s
  torax.t_final: 96.0
  nice_evo_rd.t_end: 96.0
