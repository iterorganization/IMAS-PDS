ymmsl_version: v0.2
# Pulse 105073, closed loop on the NICE linearised model instead of the plasma-free
# circuit model. source.t_min 81.0 / t_max 100.0 = window of the NICE inverse output of
# metis_nice_inverse_from_dina_105073/nice_out read by preprocess.sh (no dt, i.e. the
# native inverse slices). The inverse run (2026-10-14, 51 slices) has no slice at the
# linearisation time 84.4176 s of the linear model; the slices around it are 74.4176,
# 81.4576, 88.7876, 94.4676, 101.2476 s, so t0 of the run cannot coincide with the
# linearisation time. The first inverse slice in the window is 81.4576 s = t0, 3.0 s
# before the linearisation time.
# plasmaless.t_end 83.4576 = 2 s of closed loop (400 exchanges at dt 0.005), inside the
# F_INIT equilibrium time window as the actor requires. dt = t_interval 0.005 as in
# the 105084 case.
# plasmaless.linear_model_dir: the NICE linearised model of pulse 105073 at 84.4176 s,
# used instead of the plasma-free circuit model; the directory holds linear_model.json
# and the A, B, C matrices, read by the actor through its linear_model_dir setting (see
# the plasmaless repository README, section "External linear model").
# plasmaless.operating_point descriptor (explicit, the default): absolute coil currents,
# Ip and magnetic axis start at the model's own linearisation point (the descriptor's
# operating point), not at the inverse values at t0; the controller's references (Ip and
# geometric axis) are the inverse scenario values interpolated from t0 onwards (flat top,
# Ip about -15.07 MA), so the mismatch between model start and references is small.
# Use f_init to start the model from the inverse (F_INIT scenario) values at t0 instead.
settings:
  source.t_min: 81.0
  source.t_max: 100.0
  plasmaless.t_end: 83.4576
  plasmaless.dt: 0.005
  plasmaless.t_interval: 0.005
  plasmaless.linear_model_dir: "/home/ITER/schneim/public/git/plasma-tokamak-circuits/linearModelSimple_105073_t84.417598"
  plasmaless.operating_point: descriptor
