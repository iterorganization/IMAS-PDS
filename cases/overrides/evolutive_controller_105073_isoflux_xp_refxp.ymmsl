ymmsl_version: v0.2
# isoflux_xp_refxp: isoflux_xp (shape_control 3, 4 s window 16.2176 -> 20.2176 s) with the mode-3 reference flux psi_xp taken
# at the reference X-point (xp_flux_at_ref 1, as the pcs XPT02 case) instead of the measured saddle; trace = the dense
# inverse cases/inverse_convergence_105073_dense (area-weighted current centre).
# @TRACE_RUN@ = the stamped run directory of the trace, substituted by workflows/evolutive_controller/run_isoflux_cases.sh
settings:
  source.source_uri: "imas:hdf5?path=@TRACE_RUN@/out_nice"
  source.t_min: 16.2
  source.t_max: 30.0
  torax.t_final: 20.2176
  nice_evo_rd.t_end: 20.2176
  diagnostics.current_centre_area_weighted: true

  magnetic_controller.KCURR: 1
  magnetic_controller.control_Ip: 1
  magnetic_controller.RZIp: 0
  magnetic_controller.VS: 1
  magnetic_controller.VS_control_mode: 3  #{'Off (0)'; 'VS1 (1)'; 'VS3 (2)'; 'VS1+VS3 (3)'}
  magnetic_controller.PSModel: 1
  magnetic_controller.shape_control: 3 # 2 isoflux limiter, 3 isoflux X-point, 4 gaps
  magnetic_controller.in_out_msg_dt: 0.001
  magnetic_controller.nice_signs: 1
  magnetic_controller.isoflux_flux_scale: 1
  magnetic_controller.xp_flux_at_ref: 1

  nice_evo_rd.dt: 0.001
