ymmsl_version: v0.2

# DINA shot 105073, forward co-simulation (torax_nice_rd_controller).
#
#   export PDS_REPO=/path/to/pds
#   export SCENARIOS_REPO=/path/to/pds-scenarios
#   export YMMSL_PATH=$PDS_REPO/workflows
#   muscle_manager --start-all $PDS_REPO/cases/105073_rd.ymmsl
#
# Starts from a previous inverse_convergence run's NICE output; see the scenario's info.md.

imports:
- from torax_nice_rd_controller.workflow import implementation torax_nice_rd_controller

# Resources keys are `<root model>.<instance>`, and for a case that imports its workflow
# the root model name is the full dotted import path. Unlike settings, they are looked up
# by exact match with no prefix walk (instance_manager.py:142 -> Configuration.get_resources),
# so a bare `run.transport` here is not an error -- it is silently 1 thread. Settings below
# keep the short `run.*` form: those DO get the prefix walk. ci/check_ymmsl.py enforces both.
resources:
  torax_nice_rd_controller.workflow.torax_nice_rd_controller.run.transport: {threads: 8}
  torax_nice_rd_controller.workflow.torax_nice_rd_controller.run.nice_evo_rd: {threads: 2}
  torax_nice_rd_controller.workflow.torax_nice_rd_controller.run.magnetic_controller: {threads: 1}

settings:
  # Scenario: the forward start state. `source` emits six lanes -- equilibrium, pf_active,
  # wall, pf_passive, iron_core, core_profiles -- and reads all of them from ONE entry, so
  # it cannot point at the raw inverse-design output, which holds only the first two.
  # data/forward_start is that output merged onto the DINA-prepared machine description
  # and kinetic profiles.
  run.source.source_uri: "imas:hdf5?path=${SCENARIOS_REPO}/105073/data/forward_start"
  run.source.iterative: false
  run.source.t_min: 75
  # Machine description for the transport sink: re-emitted out of the prepared DINA entry,
  # which for this scenario also carries wall/pf_passive/iron_core (MD_LAYOUT=combined) and
  # DINA's pf_active WITH coil currents.
  run.sink_source.source_uri: "imas:hdf5?path=${SCENARIOS_REPO}/105073/data/in"
  # NICE-side visualization metadata: re-sliced from the same earlier NICE output that
  # seeds `source`. The old templates used a second copy of it purely so two readers could
  # open it at once; HDF5_USE_FILE_LOCKING=FALSE removes the need for the copy.
  run.sink_source_nice.source_uri: "imas:hdf5?path=${SCENARIOS_REPO}/105073/data/forward_start"

  # Solvers. The NICE config belongs to the workflow: it holds nothing shot-specific, and
  # the evo / resistive-diffusion split is a property of the variant, not of the pulse.
  # The TORAX config is in the scenario only because it reads this scenario's data
  # directly to derive its time window -- see the note in the scenario's info.md.
  run.nice_evo_rd.xml_path: ${PDS_REPO}/workflows/lib/config_nice_evo_rd.xml
  run.nice_evo_rd.t_interval: 0.001   # must match the transport dt
  run.nice_evo_rd.dt: 0.001
  run.transport.python_config_module: ${SCENARIOS_REPO}/105073/config_torax_forward.py
  run.transport.output_all_timeslices: False

  # Output. Relative URIs resolve against each instance's own work directory, so results
  # land in <run_dir>/instances/<sink>/workdir/<name> -- contained per run, no absolute
  # paths, but one level deeper than the run dir itself.
  run.sink_nice.sink_uri: "imas:hdf5?path=out_nice_evo"
  run.sink_nice.sink_mode: "w"
  run.sink_torax.sink_uri: "imas:hdf5?path=out_torax"
  run.sink_torax.sink_mode: "w"

  # PCS magnetic controller.
  run.sink_controller.sink_uri: "imas:hdf5?path=out_controller"
  run.sink_controller.sink_mode: "w"

  # Live plotting.
  run.visualization_nice.plot_file_path: ${PDS_REPO}/visualization/nice_inv.py
  run.visualization_nice.throttle_interval: 0.4
  run.visualization_nice.keep_alive: false
  run.visualization_torax.plot_file_path: ${PDS_REPO}/visualization/kinetic_profiles.py
  run.visualization_torax.throttle_interval: 0.4
  run.visualization_torax.keep_alive: false

  muscle_remote_log_level: 'INFO'
