ymmsl_version: v0.2

# DINA shot 105073, inverse pulse design converged against TORAX transport.
#
#   export PDS_REPO=/path/to/pds
#   export SCENARIOS_REPO=/path/to/pds-scenarios
#   export YMMSL_PATH=$PDS_REPO/workflows
#   muscle_manager --start-all $PDS_REPO/cases/105073_convergence.ymmsl
#
# Run this before the three 105073 forward co-simulation cases: they start from this run's
# NICE output, which has to be copied into the scenario's data/from_inverse_convergence.

imports:
- from inverse_convergence.workflow import implementation inverse_convergence

resources:
  run.solve.nice: {threads: 2}
  run.final_solve.nice: {threads: 2}
  run.transport: {threads: 8}
  run.rec_nice: {threads: 1}
  run.rec_torax: {threads: 1}

settings:
  # Scenario: the pulse design and its input data.
  run.waveform_editor.waveforms: ${SCENARIOS_REPO}/105073/waveforms.yaml
  run.we_final.waveforms: ${SCENARIOS_REPO}/105073/waveforms_md_only.yaml
  run.source.source_uri: "imas:hdf5?path=${SCENARIOS_REPO}/105073/data/in"
  run.source.iterative: False

  # Convergence. t_min/t_max trim the pulse to the interval this shot is designed over.
  run.loop.cold_start: False
  run.loop.max_iterations: 2
  run.loop.max_slices: 0
  run.loop.t_min: 10
  run.loop.t_max: 205
  run.loop.tolerance: 1000.0
  run.loop.rel_tolerance: 0.03

  # Solvers. This scenario carries its own TORAX config; NICE uses the workflow default.
  run.solve.nice.xml_path: ${PDS_REPO}/workflows/inverse_convergence/config_nice.xml
  run.final_solve.nice.xml_path: ${PDS_REPO}/workflows/inverse_convergence/config_nice.xml
  run.final_solve.nice.output_for_control: 1
  run.transport.python_config_module: ${SCENARIOS_REPO}/105073/config_torax.py
  run.transport.output_all_timeslices: True

  # Output. Relative, so results land in the run directory.
  run.sink_nice.sink_uri: "imas:hdf5?path=out_nice"
  run.sink_nice.sink_mode: "w"
  run.sink_torax.sink_uri: "imas:hdf5?path=out_torax"
  run.sink_torax.sink_mode: "w"

  # Recording.
  run.rec_nice.format: distill
  run.rec_nice.auto: False
  run.rec_nice.config: ${PDS_REPO}/visualization/nice_inv.py
  run.rec_nice.md: "wall=imas:hdf5?path=${SCENARIOS_REPO}/105073/data/in pf_active=imas:hdf5?path=${SCENARIOS_REPO}/105073/data/in"
  run.rec_torax.format: distill
  run.rec_torax.auto: False
  run.rec_torax.config: ${PDS_REPO}/visualization/kinetic_profiles.py

  # Validation.
  run.validator.halt_on_error: False
  run.validator.extra_rule_dirs: ${PDS_REPO}/pds_validation_tests
  run.validator.rulesets: iter-olc
  run.validator.apply_generic: False

  muscle_remote_log_level: 'INFO'
