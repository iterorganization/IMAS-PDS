ymmsl_version: v0.2

# DINA shot 105078, boundary-prescribed pulse design, solved once with NICE inverse.
#
#   export PDS_REPO=/path/to/pds
#   export SCENARIOS_REPO=/path/to/pds-scenarios
#   export YMMSL_PATH=$PDS_REPO/workflows
#   muscle_manager --start-all $PDS_REPO/cases/105078_prescribed.ymmsl

imports:
- from prescribed_transport.workflow import implementation prescribed_transport

# Resources keys need the full root model name; settings keys do not (see docs/usage).
resources:
  prescribed_transport.workflow.prescribed_transport.solve.nice: {threads: 2}
  prescribed_transport.workflow.prescribed_transport.rec_nice: {threads: 1}

settings:
  # Scenario: the pulse design and its input data.
  waveform_editor.waveforms: ${SCENARIOS_REPO}/105078/waveforms_no_transport.yaml
  source.source_uri: "imas:hdf5?path=${SCENARIOS_REPO}/105078/data/in"
  source.iterative: true

  solve.nice.xml_path: ${PDS_REPO}/workflows/prescribed_transport/config_nice.xml

  # Relative URIs resolve against the instance's own work directory.
  sink.sink_uri: "imas:hdf5?path=out_nice"
  sink.sink_mode: "w"

  # Recording.
  rec_nice.format: distill
  rec_nice.auto: False
  rec_nice.config: ${PDS_REPO}/visualization/nice_inv.py
  rec_nice.md: "wall=imas:hdf5?path=${SCENARIOS_REPO}/105078/data/in_md pf_active=imas:hdf5?path=${SCENARIOS_REPO}/105078/data/in_md"

  muscle_remote_log_level: 'INFO'
