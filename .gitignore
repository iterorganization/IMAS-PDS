# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/

# Unit test / coverage reports
.cache

tmp
.coverage
.venv
venv
.uv-bootstrap
build
junit.xml
.idea/

ymmsl_files/output/

run/*
!run/*_base_env
!run/input/
ymmsl_files/*
!ymmsl_files/.*

workflows/*/scenarios/*/*
!workflows/*/scenarios/*/
!workflows/*/scenarios/*/info.txt
!workflows/*/scenarios/*/scenario_config.env
!*.template

# Per-scenario settings.ymmsl is a committed static file (the de-templated workflow style).
!workflows/*/scenarios/*/settings.ymmsl

# Per-scenario waveforms.yaml is a committed static file too.
!workflows/*/scenarios/*/waveforms.yaml

# Per-scenario config_torax.py overrides the workflow's shared config_torax.py (e.g.
# scenario-specific transport calibration); also a committed static file.
!workflows/*/scenarios/*/config_torax.py

.claude
